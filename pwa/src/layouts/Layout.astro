---
import '../styles/global.css';
interface Props {
  title: string;
  /** Widens the header/main/footer container beyond the default max-w-6xl —
   *  for pages whose content (e.g. the plant table's many dot/filter
   *  columns) needs more horizontal room than prose pages do. */
  wide?: boolean;
}
const { title, wide = false } = Astro.props;
const containerMaxW = wide ? 'max-w-[1600px]' : 'max-w-6xl';
---
<!doctype html>
<html lang="de" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#166534" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Raleway: matches the Baumscheibe template's own "COMMON NAME" placeholder
         font (see baumscheibe-render.ts NAME_BOXES). OFL-licensed, self-hosted (see global.css) — not loaded from Google Fonts, to avoid IP transfer to Google. -->
    <title>{title}</title>
    <!-- Blocking on purpose: sets lang + dark mode before first paint. -->
    <script is:inline src="/boot.js"></script>
    <!-- Umami Analytics — self-hosted (own VPS, Docker), cookieless, no
         personal data, no IP storage. Replaced Plausible Cloud 2026-09-22
         (see CHANGELOG.md) to keep all data on our own server instead of a
         third-party's. data-domains restricts tracking to the real domain,
         same effect as Plausible's own localhost auto-skip. -->
    <script defer data-website-id="dd0aef9b-00ce-4126-83f8-3bf21e9830c4" data-domains="permadesignkit.org" data-do-not-track="true" src="https://stats.permadesignkit.org/script.js"></script>
  </head>
  <body class="flex min-h-full flex-col bg-stone-50 dark:bg-stone-950 text-stone-800 dark:text-stone-100 antialiased">
    <!-- Android / Chrome install banner (top of page, non-sticky) -->
    <div id="install-banner" hidden class="flex items-center justify-between gap-3 bg-green-700 px-4 py-2 text-sm text-white sm:px-6">
      <span class="flex items-center gap-2">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
        <span data-i18n="installBannerText">Perma Design Kit auf den Startbildschirm legen?</span>
      </span>
      <div class="flex items-center gap-2">
        <button id="install-accept" type="button" data-i18n="installBtn" class="rounded-md bg-white px-3 py-1 text-xs font-semibold text-green-800 transition hover:bg-stone-100">Installieren</button>
        <button id="install-dismiss" type="button" data-i18n-aria-label="closeBtn" aria-label="Schließen" class="text-lg leading-none text-white/80 transition hover:text-white">×</button>
      </div>
    </div>

    <!-- Backup-Reminder-Banner: stale-Zustand wird im Skript bestimmt -->
    <div id="backup-reminder" hidden class="flex items-center justify-between gap-3 bg-amber-100 dark:bg-amber-900/40 px-4 py-2 text-sm text-amber-900 dark:text-amber-100 sm:px-6">
      <span class="flex items-center gap-2">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
        <span id="backup-reminder-text" data-i18n="backupReminderDefault">Letztes Backup ist eine Weile her — jetzt sichern?</span>
      </span>
      <div class="flex items-center gap-2">
        <a href="/settings#daten-section" data-i18n="backupReminderGoto" class="rounded-md bg-white dark:bg-stone-800 px-3 py-1 text-xs font-semibold text-amber-900 dark:text-amber-100 ring-1 ring-amber-300 dark:ring-amber-800 hover:bg-amber-50 dark:hover:bg-stone-700">Zu den Daten</a>
        <button id="backup-reminder-dismiss" type="button" data-i18n-aria-label="backupReminderDismiss" aria-label="Heute ausblenden" class="text-lg leading-none text-amber-900/60 dark:text-amber-100/60 transition hover:text-amber-900 dark:hover:text-amber-100">×</button>
      </div>
    </div>

    <header class="sticky top-0 z-50 bg-green-900 dark:bg-green-950 shadow-lg">
      <nav class={`mx-auto flex ${containerMaxW} items-center gap-2 px-4 py-3 sm:px-6`}>
        <a href="/" class="flex shrink-0 items-center gap-2 text-lg font-bold tracking-tight text-white">
          <svg class="h-7 w-7" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <polyline points="16,11 20.1,14 16,19.2 9.7,14 16,6.6 24.5,14 16,23.6 16,27"
              fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="16" cy="11" r="1.2" fill="white"/>
          </svg>
          <span class="hidden sm:inline">Perma Design Kit</span>
        </a>
        <div class="ml-3 flex items-center gap-1 text-sm font-medium">
          <a href="/" data-nav="/" data-i18n="navPlants" class="rounded-md px-2.5 py-1 text-green-100 transition hover:bg-green-800 hover:text-white dark:hover:bg-green-900">Pflanzen</a>
          <a href="/kalender" data-nav="/kalender" data-i18n="navCalendar" class="rounded-md px-2.5 py-1 text-green-100 transition hover:bg-green-800 hover:text-white dark:hover:bg-green-900">Kalender</a>
          <a href="/polykulturen" data-nav="/polykulturen" data-i18n="navGuilds" class="rounded-md px-2.5 py-1 text-green-100 transition hover:bg-green-800 hover:text-white dark:hover:bg-green-900">Polykulturen</a>
          <a href="/gartenplan" data-nav="/gartenplan" data-i18n="navGardenPlan" class="rounded-md px-2.5 py-1 text-green-100/50 transition hover:bg-green-800 hover:text-green-100 dark:hover:bg-green-900">Gartenplan</a>
        </div>

        <div class="ml-auto flex items-center gap-1">
          <div class="relative">
            <button id="lang-toggle" type="button" data-i18n-aria-label="langSwitchLabel" data-i18n-title="langSwitchLabel" aria-label="Sprache wechseln" title="Sprache wechseln" class="rounded-lg px-2.5 py-1.5 text-sm font-medium uppercase tracking-wide text-green-100 transition hover:bg-green-800 hover:text-white dark:hover:bg-green-900">
              <span id="lang-current">DE</span>
            </button>
            <div id="lang-menu" hidden class="absolute right-0 z-50 mt-1 w-32 overflow-hidden rounded-lg bg-white dark:bg-stone-800 py-1 text-sm text-stone-700 dark:text-stone-200 shadow-lg ring-1 ring-stone-200 dark:ring-stone-700">
              <button type="button" data-lang="de" class="lang-option block w-full px-3 py-1.5 text-left hover:bg-stone-100 dark:hover:bg-stone-700">Deutsch</button>
              <button type="button" data-lang="en" class="lang-option block w-full px-3 py-1.5 text-left hover:bg-stone-100 dark:hover:bg-stone-700">English</button>
            </div>
          </div>
          <button id="theme-toggle" type="button" data-i18n-aria-label="themeToggleLabel" aria-label="Theme umschalten" title="Theme: Automatisch (OS)" class="rounded-lg px-3 py-1.5 text-sm font-medium text-green-100 transition hover:bg-green-800 hover:text-white dark:hover:bg-green-900">
            <!-- 3-state: Auto (monitor) → Hell (sun) → Dunkel (moon) → Auto … -->
            <svg id="theme-icon-auto" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="1.5"/><path stroke-linecap="round" d="M8 20h8M12 16v4"/></svg>
            <svg id="theme-icon-light" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <svg id="theme-icon-dark" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
          <a href="/settings" data-i18n-aria-label="navSettings" aria-label="Einstellungen" class="rounded-lg px-3 py-1.5 text-sm font-medium text-green-100 transition hover:bg-green-800 hover:text-white dark:hover:bg-green-900">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/></svg>
          </a>
        </div>
      </nav>
    </header>
    <main class={`mx-auto w-full ${containerMaxW} flex-1 px-4 py-6 sm:px-6`}>
      <slot />
    </main>

    <footer class="border-t border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-stone-950 py-4 text-sm text-stone-500 dark:text-stone-400">
      <div class={`mx-auto flex ${containerMaxW} flex-wrap items-center justify-between gap-2 px-4 sm:px-6`}>
        <span>© 2026 Perma Design Kit</span>
        <nav class="flex flex-wrap gap-4">
          <a href="/hilfe" data-i18n="footerHelp" class="hover:text-stone-700 dark:hover:text-stone-200 hover:underline">Hilfe</a>
          <a href="/datenschutz" data-i18n="footerPrivacy" class="hover:text-stone-700 dark:hover:text-stone-200 hover:underline">Datenschutz</a>
          <button type="button" id="open-welcome" data-i18n="footerIntro" class="hover:text-stone-700 dark:hover:text-stone-200 hover:underline">Einführung</button>
          <a href="/impressum" data-i18n="footerImprint" class="hover:text-stone-700 dark:hover:text-stone-200 hover:underline">Impressum</a>
          <a href="https://github.com/tbdal/Perma-Design-Kit" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub" class="inline-flex items-center gap-1 hover:text-stone-700 dark:hover:text-stone-200 hover:underline">
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>
        </nav>
      </div>
    </footer>

    <!-- Willkommens-Tour beim ersten Besuch (erklärt u.a. das lokale Speichern im Browser) -->
    <dialog id="welcome-modal" class="m-auto w-full max-w-lg rounded-2xl bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-100 p-0 shadow-2xl backdrop:bg-black/50">
      <div class="p-6">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-lg font-bold" id="welcome-title" data-i18n="welcomeTitle">Willkommen im Perma Design Kit</h2>
          <button id="welcome-close" type="button" data-i18n-aria-label="closeBtn" aria-label="Schließen" class="text-2xl leading-none text-stone-400 hover:text-stone-700 dark:hover:text-stone-200">×</button>
        </div>
        <div class="welcome-step space-y-2 text-sm text-stone-600 dark:text-stone-300">
          <p class="font-semibold text-stone-900 dark:text-stone-100" data-i18n="welcomeStorageHead">💾 Deine Daten bleiben in deinem Browser</p>
          <p data-i18n="welcomeStorage1">Es gibt kein Benutzerkonto und keinen Server, der deine Pflanzen oder Gartenpläne speichert. Alles wird dauerhaft im Speicher dieses Browsers auf diesem Gerät abgelegt (IndexedDB).</p>
          <p data-i18n="welcomeStorage2">Das bedeutet: Es ist privat und funktioniert offline — aber die Daten sind nicht auf anderen Geräten oder in anderen Browsern verfügbar. Wenn du die Website-Daten löschst (Browser zurücksetzen, „Cookies &amp; Websitedaten löschen", Privatmodus), sind sie weg.</p>
          <p data-i18n="welcomeStorage3">Lege deshalb regelmäßig ein Backup an (Einstellungen → Daten) oder richte die automatische Sicherung per WebDAV / GitHub Gist ein.</p>
        </div>
        <div class="mt-5 flex items-center justify-between">
          <button id="welcome-skip" type="button" data-i18n="tourSkip" class="rounded-lg px-3 py-1.5 text-sm text-stone-600 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800">Überspringen</button>
          <div class="flex gap-2">
            <button id="welcome-next" type="button" data-i18n="welcomeStartTour" class="rounded-lg bg-green-700 px-4 py-1.5 text-sm font-medium text-white hover:bg-green-800">Rundgang starten</button>
          </div>
        </div>
      </div>
    </dialog>

    <!-- Rundgang: abgedunkelte Seite, Spotlight auf dem jeweiligen Bereich -->
    <div id="tour-block" hidden class="fixed inset-0 z-[60]"></div>
    <div id="tour-spot" hidden class="pointer-events-none fixed z-[61] rounded-lg transition-all duration-200" style="box-shadow:0 0 0 200vmax rgba(15,23,42,.72), 0 0 0 3px rgba(74,222,128,.9);"></div>
    <div id="tour-card" hidden class="fixed z-[62] w-[min(20rem,calc(100vw-2rem))] rounded-xl bg-white dark:bg-stone-900 p-4 text-sm text-stone-700 dark:text-stone-200 shadow-2xl ring-1 ring-stone-200 dark:ring-stone-700">
      <p id="tour-title" class="font-semibold text-stone-900 dark:text-stone-100"></p>
      <p id="tour-text" class="mt-1"></p>
      <div class="mt-3 flex items-center justify-between gap-2">
        <span id="tour-progress" class="text-xs text-stone-400"></span>
        <div class="flex gap-1.5">
          <button id="tour-skip" type="button" data-i18n="tourSkip" class="rounded-lg px-2.5 py-1 text-xs text-stone-500 hover:bg-stone-100 dark:hover:bg-stone-800">Überspringen</button>
          <button id="tour-prev" type="button" data-i18n="welcomePrev" class="rounded-lg px-2.5 py-1 text-xs text-stone-600 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800">Zurück</button>
          <button id="tour-next" type="button" class="rounded-lg bg-green-700 px-3 py-1 text-xs font-medium text-white hover:bg-green-800"></button>
        </div>
      </div>
    </div>

    <!-- Tastatur-Shortcut-Cheatsheet (öffnet mit ?) -->
    <dialog id="shortcuts-modal" class="m-auto w-full max-w-md rounded-2xl bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-100 p-0 shadow-2xl backdrop:bg-black/40">
      <div class="p-6">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-lg font-bold" data-i18n="shortcutsTitle">Tastatur-Shortcuts</h2>
          <button id="shortcuts-close" type="button" data-i18n-aria-label="closeBtn" aria-label="Schließen" class="text-2xl leading-none text-stone-400 hover:text-stone-700 dark:hover:text-stone-200">×</button>
        </div>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-stone-200 dark:divide-stone-700">
            <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">?</kbd></td><td data-i18n="shortcutsOverview">Diese Übersicht</td></tr>
            <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">/</kbd></td><td data-i18n="shortcutsFocusSearch">Suche fokussieren</td></tr>
            <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">Esc</kbd></td><td data-i18n="shortcutsCloseDialog">Offenen Dialog schließen</td></tr>
            <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">n</kbd></td><td data-i18n="shortcutsNewPlant">Neue Pflanze</td></tr>
            <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">g</kbd> / <kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">l</kbd> / <kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">c</kbd></td><td data-i18n="shortcutsViewSwitch">Kacheln / Liste / Karten</td></tr>
            <tr><td class="py-1.5 pr-4"><kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1.5 py-0.5 text-xs font-mono">Shift</kbd>+Klick</td><td data-i18n="shortcutsShiftClick">Bereich von letzter bis aktueller Checkbox auswählen</td></tr>
          </tbody>
        </table>
        <p class="mt-4 text-xs text-stone-500 dark:text-stone-400"><span data-i18n="shortcutsFooterNote">Shortcuts greifen außerhalb von Eingabefeldern.</span> <kbd class="rounded bg-stone-200 dark:bg-stone-700 px-1 text-[10px] font-mono">Esc</kbd> <span data-i18n="shortcutsFooterNote2">wirkt überall.</span></p>
      </div>
    </dialog>

    <!-- iOS Safari install popup (no beforeinstallprompt API on iOS) -->
    <div id="ios-install-popup" hidden class="fixed bottom-4 left-4 right-4 z-50 mx-auto max-w-md rounded-xl bg-white dark:bg-stone-900 p-4 shadow-2xl ring-1 ring-stone-200 dark:ring-stone-700">
      <div class="flex items-start gap-3">
        <div class="shrink-0 text-2xl">📲</div>
        <div class="flex-1 text-sm">
          <p class="font-semibold text-stone-900 dark:text-stone-100" data-i18n="iosInstallTitle">App auf den Startbildschirm</p>
          <p class="mt-1 text-stone-600 dark:text-stone-300">
            <span data-i18n="iosInstallStep1">Tippe unten in Safari auf</span>
            <svg class="inline h-4 w-4 align-text-bottom" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4m0 0L8 6m4-4v12"/></svg>
            <strong data-i18n="iosInstallShare">Teilen</strong> <span data-i18n="iosInstallStep2">und dann auf</span>
            <strong data-i18n="iosInstallAddToHome">„Zum Home-Bildschirm"</strong>.
          </p>
        </div>
        <button id="ios-install-dismiss" type="button" data-i18n-aria-label="closeBtn" aria-label="Schließen" class="text-stone-400 hover:text-stone-600 dark:hover:text-stone-200">×</button>
      </div>
    </div>

    <script>
      // First-visit intro: a storage explainer dialog, then a spotlight tour
      // over the real page. Skipped on the legal/help pages so they stay
      // readable; "Einführung" in the footer replays it.
      import { createT } from '../lib/i18n/core';
      import { layoutDict } from '../lib/i18n/dict-layout';
      const tt = createT(layoutDict);
      const WELCOME_KEY = 'pdk-welcome-seen';
      const markSeen = () => { try { localStorage.setItem(WELCOME_KEY, '1'); } catch {} };

      type TourStep = { selector: string; closest?: string; dummy?: boolean; fallback?: string; title: string; text: string; fallbackText?: string };
      const TOUR_STEPS: TourStep[] = [
        { selector: '#plant-search', closest: 'div', title: 'tourSearchTitle', text: 'tourSearchText' },
        { selector: '#tour-dummy .btn-edit', dummy: true, title: 'tourEditTitle', text: 'tourEditText' },
        { selector: '#btn-view-list', title: 'tourListTitle', text: 'tourListText' },
        { selector: '#btn-view-cards', title: 'tourCardsTitle', text: 'tourCardsText' },
        { selector: 'a[data-nav="/polykulturen"]', title: 'tourGuildsTitle', text: 'tourGuildsText' },
        { selector: 'a[data-nav="/gartenplan"]', title: 'tourPlanTitle', text: 'tourPlanText' },
      ];
      const visible = (el: Element | null): el is HTMLElement => {
        if (!el) return false;
        const r = (el as HTMLElement).getBoundingClientRect();
        return r.width > 0 && r.height > 0;
      };

      function runTour() {
        const block = document.getElementById('tour-block')!;
        const spot = document.getElementById('tour-spot')!;
        const card = document.getElementById('tour-card')!;
        const prev = document.getElementById('tour-prev') as HTMLButtonElement;
        const next = document.getElementById('tour-next') as HTMLButtonElement;
        // Step 2 points at the edit button of an example plant (not saved), so
        // it works even on an empty list and while the real button is hover-only.
        let dummy: HTMLElement | null = null;
        const list = document.getElementById('plant-list');
        if (list) {
          dummy = document.createElement('div');
          dummy.id = 'tour-dummy';
          dummy.className = 'flex items-center justify-between gap-3 rounded-xl bg-white dark:bg-stone-800 px-4 py-3 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700';
          dummy.innerHTML = '<div><p class="text-sm font-bold text-stone-800 dark:text-stone-100"></p><p class="text-xs italic text-stone-500 dark:text-stone-400">Exemplum plantus</p></div>'
            + '<button type="button" class="btn-edit rounded-md bg-stone-100 dark:bg-stone-700 px-2.5 py-1 text-xs font-medium text-stone-700 dark:text-stone-200"></button>';
          dummy.querySelector('p')!.textContent = tt('tourDummyName');
          dummy.querySelector('button')!.textContent = '✎ ' + tt('tourDummyEdit');
          list.prepend(dummy);
        }
        // Only steps whose target exists on this page (nav links are hidden on small screens, etc.)
        const steps = TOUR_STEPS.map(s => {
          const main = Array.from(document.querySelectorAll(s.selector)).find(visible);
          const box = main && s.closest ? (main.closest(s.closest) as HTMLElement | null) : null;
          if (main) return { el: box && visible(box) ? box : main, title: s.title, text: s.text };
          const fb = s.fallback ? Array.from(document.querySelectorAll(s.fallback)).find(visible) : null;
          return fb ? { el: fb, title: s.title, text: s.fallbackText ?? s.text } : null;
        }).filter((s): s is { el: HTMLElement; title: string; text: string } => !!s);
        if (dummy) dummy.hidden = true;
        if (steps.length === 0) return;
        let idx = 0;
        const place = () => {
          const cur = steps[idx];
          const r = cur.el.getBoundingClientRect();
          const pad = 6;
          Object.assign(spot.style, { left: `${r.left - pad}px`, top: `${r.top - pad}px`, width: `${r.width + 2 * pad}px`, height: `${r.height + 2 * pad}px` });
          const cw = card.offsetWidth, ch = card.offsetHeight, vw = window.innerWidth, vh = window.innerHeight;
          const below = r.bottom + pad + 12 + ch <= vh;
          const top = below ? r.bottom + pad + 12 : Math.max(8, r.top - pad - 12 - ch);
          const left = Math.min(Math.max(8, r.left + r.width / 2 - cw / 2), vw - cw - 8);
          Object.assign(card.style, { top: `${top}px`, left: `${left}px` });
        };
        const show = () => {
          const cur = steps[idx];
          if (dummy) dummy.hidden = !dummy.contains(cur.el);
          cur.el.scrollIntoView({ block: 'center', behavior: 'instant' as ScrollBehavior });
          document.getElementById('tour-title')!.textContent = tt(cur.title);
          document.getElementById('tour-text')!.textContent = tt(cur.text);
          document.getElementById('tour-progress')!.textContent = `${idx + 1} / ${steps.length}`;
          prev.style.visibility = idx === 0 ? 'hidden' : 'visible';
          next.textContent = tt(idx === steps.length - 1 ? 'welcomeDone' : 'welcomeNext');
          place();
        };
        const end = () => {
          markSeen();
          for (const el of [block, spot, card]) el.hidden = true;
          dummy?.remove();
          window.removeEventListener('resize', place);
          document.removeEventListener('keydown', onKey, true);
        };
        const onKey = (e: KeyboardEvent) => {
          if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); end(); }
          else if (e.key === 'ArrowRight' || e.key === 'Enter') { e.preventDefault(); e.stopPropagation(); next.click(); }
          else if (e.key === 'ArrowLeft') { e.preventDefault(); e.stopPropagation(); prev.click(); }
        };
        prev.onclick = () => { if (idx > 0) { idx--; show(); } };
        next.onclick = () => { if (idx >= steps.length - 1) end(); else { idx++; show(); } };
        (document.getElementById('tour-skip') as HTMLButtonElement).onclick = end;
        for (const el of [block, spot, card]) el.hidden = false;
        window.addEventListener('resize', place);
        document.addEventListener('keydown', onKey, true);
        show();
      }

      const modal = document.getElementById('welcome-modal') as HTMLDialogElement | null;
      if (modal) {
        const startTour = () => { markSeen(); modal.close(); runTour(); };
        document.getElementById('welcome-next')?.addEventListener('click', startTour);
        document.getElementById('welcome-skip')?.addEventListener('click', () => { markSeen(); modal.close(); });
        document.getElementById('welcome-close')?.addEventListener('click', () => { markSeen(); modal.close(); });
        modal.addEventListener('cancel', markSeen);
        const open = () => { if (!modal.open) modal.showModal(); };
        document.getElementById('open-welcome')?.addEventListener('click', open);
        let seen = false;
        try { seen = !!localStorage.getItem(WELCOME_KEY); } catch {}
        const legal = /^\/(impressum|datenschutz|hilfe)\/?$/.test(location.pathname);
        if (!seen && !legal) open();
      }
    </script>
    <script>
      import { autoSyncIfConfigured } from '../lib/sync';
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) autoSyncIfConfigured().catch(() => {});
      });
    </script>
    <script>
      import { getLang, setLang, createT, applyStaticI18n, type Lang } from '../lib/i18n/core';
      import { layoutDict } from '../lib/i18n/dict-layout';
      import { installBrokenImageCleanup } from '../lib/html';

      const t = createT(layoutDict);
      applyStaticI18n(layoutDict);
      installBrokenImageCleanup();

      // ── Language switcher ────────────────────────────────────────────────
      const langToggle = document.getElementById('lang-toggle');
      const langMenu = document.getElementById('lang-menu');
      const langCurrent = document.getElementById('lang-current');
      if (langCurrent) langCurrent.textContent = getLang().toUpperCase();

      langToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        langMenu?.toggleAttribute('hidden');
      });
      document.addEventListener('click', () => langMenu?.setAttribute('hidden', ''));
      langMenu?.querySelectorAll<HTMLButtonElement>('.lang-option').forEach(btn => {
        btn.addEventListener('click', () => {
          const lang = btn.dataset.lang as Lang;
          if (lang && lang !== getLang()) {
            setLang(lang);
            location.reload();
          }
        });
      });

      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }

      // (a) Bitte Browser, IndexedDB persistent zu halten — verhindert Eviction
      //     unter Speicherdruck. Browser entscheidet (kein Prompt in Chrome,
      //     auto-grant in Firefox bei installierter PWA, Prompt in Safari).
      if ('storage' in navigator && 'persist' in navigator.storage) {
        navigator.storage.persisted().then(p => { if (!p) navigator.storage.persist(); });
      }

      // Highlight active top-nav link based on the current pathname.
      (function () {
        const path = location.pathname.replace(/\/$/, '') || '/';
        document.querySelectorAll<HTMLAnchorElement>('a[data-nav]').forEach(a => {
          if (a.dataset.nav === path) a.classList.add('bg-green-800', 'dark:bg-green-900', 'text-white');
        });
      })();

      // (b) Backup-Reminder. Zeigt einen Banner, wenn das letzte Backup länger
      //     als REMIND_AFTER_DAYS her ist (oder es nie eines gab) UND der User
      //     den Hinweis heute noch nicht weggeklickt hat. Nur, wenn überhaupt
      //     Pflanzen in der DB sind.
      (async function () {
        const REMIND_AFTER_DAYS = 30;
        const lsGet2 = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
        const lsSet2 = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
        const banner = document.getElementById('backup-reminder');
        const text = document.getElementById('backup-reminder-text');
        const dismiss = document.getElementById('backup-reminder-dismiss');
        if (!banner) return;

        const todayKey = new Date().toISOString().slice(0, 10);
        if (lsGet2('backup-reminder-dismissed-on') === todayKey) return;

        // Check IndexedDB plant count without importing — just open the existing DB.
        const hasPlants = await new Promise<boolean>(resolve => {
          try {
            const req = indexedDB.open('permaculture-guilds');
            req.onsuccess = () => {
              const db = req.result;
              if (!db.objectStoreNames.contains('plants')) { db.close(); resolve(false); return; }
              const tx = db.transaction('plants', 'readonly');
              const count = tx.objectStore('plants').count();
              count.onsuccess = () => { resolve(count.result > 0); db.close(); };
              count.onerror = () => { resolve(false); db.close(); };
            };
            req.onerror = () => resolve(false);
          } catch { resolve(false); }
        });
        if (!hasPlants) return;

        const lastBackup = lsGet2('last-backup-at');
        const days = lastBackup
          ? Math.floor((Date.now() - new Date(lastBackup).getTime()) / 86400000)
          : Infinity;
        if (days < REMIND_AFTER_DAYS) return;

        if (text) text.textContent = isFinite(days)
          ? t('backupReminderDays', { days })
          : t('backupReminderNever');
        banner.hidden = false;
        dismiss?.addEventListener('click', () => { banner.hidden = true; lsSet2('backup-reminder-dismissed-on', todayKey); });
      })();
      // ── 3-state theme toggle: Auto (OS) → Hell → Dunkel → Auto … ─────────
      const themeBtn = document.getElementById('theme-toggle');
      const iconAuto = document.getElementById('theme-icon-auto');
      const iconLight = document.getElementById('theme-icon-light');
      const iconDark = document.getElementById('theme-icon-dark');

      const readTheme = (): 'auto' | 'light' | 'dark' => {
        try { const v = localStorage.getItem('theme'); return v === 'light' || v === 'dark' ? v : 'auto'; }
        catch { return 'auto'; }
      };
      const applyThemeClass = (t: 'auto' | 'light' | 'dark') => {
        const isDark = t === 'dark'
          || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
      };
      const syncThemeIcon = (mode: 'auto' | 'light' | 'dark') => {
        iconAuto?.classList.toggle('hidden', mode !== 'auto');
        iconLight?.classList.toggle('hidden', mode !== 'light');
        iconDark?.classList.toggle('hidden', mode !== 'dark');
        themeBtn?.setAttribute('title',
          mode === 'auto' ? t('themeAuto') : mode === 'light' ? t('themeLight') : t('themeDark'));
      };
      const setTheme = (t: 'auto' | 'light' | 'dark') => {
        try {
          if (t === 'auto') localStorage.removeItem('theme');
          else localStorage.setItem('theme', t);
        } catch {}
        applyThemeClass(t);
        syncThemeIcon(t);
      };
      syncThemeIcon(readTheme());
      themeBtn?.addEventListener('click', () => {
        const cur = readTheme();
        setTheme(cur === 'auto' ? 'light' : cur === 'light' ? 'dark' : 'auto');
      });

      // ── Shortcut-Cheatsheet (?, Esc, Klick auf Backdrop) ─────────────────
      const shortcutsModal = document.getElementById('shortcuts-modal') as HTMLDialogElement | null;
      document.getElementById('shortcuts-close')?.addEventListener('click', () => shortcutsModal?.close());
      shortcutsModal?.addEventListener('click', (e) => {
        // Click on backdrop (the dialog itself, not its content) closes.
        if (e.target === shortcutsModal) shortcutsModal.close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== '?') return;
        const t = e.target as HTMLElement | null;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
        e.preventDefault();
        if (shortcutsModal?.open) shortcutsModal.close();
        else shortcutsModal?.showModal();
      });

      // ── PWA install prompts ──────────────────────────────────────────────
      const installBanner = document.getElementById('install-banner');
      const installAccept = document.getElementById('install-accept');
      const installDismiss = document.getElementById('install-dismiss');
      const iosPopup = document.getElementById('ios-install-popup');
      const iosDismiss = document.getElementById('ios-install-dismiss');

      const lsGet = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
      const lsSet = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };

      let deferredPrompt: any = null;

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        if (installBanner && !lsGet('install-dismissed')) installBanner.hidden = false;
      });

      installAccept?.addEventListener('click', async () => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        try {
          const { outcome } = await deferredPrompt.userChoice;
          if (outcome === 'dismissed') lsSet('install-dismissed', '1');
        } catch {}
        if (installBanner) installBanner.hidden = true;
        deferredPrompt = null;
      });

      installDismiss?.addEventListener('click', () => {
        if (installBanner) installBanner.hidden = true;
        lsSet('install-dismissed', '1');
      });

      window.addEventListener('appinstalled', () => {
        if (installBanner) installBanner.hidden = true;
        if (iosPopup) iosPopup.hidden = true;
        lsSet('install-dismissed', '1');
        lsSet('ios-install-dismissed', '1');
      });

      // iOS Safari heuristic: Apple devices (UA contains iPad/iPhone/iPod)
      // running Safari, not already in standalone mode, popup not yet dismissed.
      const ua = navigator.userAgent;
      const isIOS = /iPad|iPhone|iPod/.test(ua);
      const standalone = window.matchMedia('(display-mode: standalone)').matches
        || (window.navigator as any).standalone === true;
      if (isIOS && !standalone && !lsGet('ios-install-dismissed') && iosPopup) {
        setTimeout(() => { iosPopup.hidden = false; }, 1500);
      }
      iosDismiss?.addEventListener('click', () => {
        if (iosPopup) iosPopup.hidden = true;
        lsSet('ios-install-dismissed', '1');
      });
    </script>
  </body>
</html>
