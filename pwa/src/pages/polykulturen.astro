---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Perma Design Kit — Polykulturen">
  <!-- ── Listenansicht ─────────────────────────────────────────────────── -->
  <section id="polyculture-list-view">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-2xl font-bold text-stone-900 dark:text-stone-100" data-i18n="pageTitle">Polykulturen</h1>
      <button id="btn-new-polyculture" data-i18n="btnNewGuild" class="rounded-lg bg-green-700 px-3.5 py-2 text-sm font-medium text-white shadow transition hover:bg-green-800 active:scale-95">+ Neue Polykultur</button>
    </div>
    <p class="mb-4 text-sm text-stone-500 dark:text-stone-400">
      <span data-i18n="introText">Eine Polykultur ist eine benannte Gruppe von Pflanzen rund um eine Ankerart, die sich
      gegenseitig fördert. Mehr in der</span> <a href="/hilfe#polykulturen" data-i18n="introHelpLink" class="text-green-700 dark:text-green-400 hover:underline">Hilfe</a>.
    </p>
    <div id="polyculture-list" class="grid gap-4 sm:grid-cols-2"></div>
    <div id="polyculture-empty" class="hidden rounded-xl border-2 border-dashed border-stone-300 dark:border-stone-600 py-16 text-center">
      <p class="text-stone-500 dark:text-stone-400" data-i18n="emptyStateText">Noch keine Polykulturen angelegt.</p>
      <button id="btn-empty-new" data-i18n="btnEmptyNew" class="mt-3 inline-block rounded-lg bg-green-700 px-4 py-2 text-sm font-medium text-white shadow hover:bg-green-800">Erste Polykultur anlegen</button>
    </div>
  </section>

  <!-- ── Editor ────────────────────────────────────────────────────────── -->
  <section id="polyculture-editor-view" hidden>
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <button id="btn-back-to-list" data-i18n="btnBackToList" class="text-sm font-medium text-stone-600 dark:text-stone-300 hover:text-green-700 dark:hover:text-green-400">← Zurück zur Liste</button>
      <div class="flex items-center gap-2">
        <button id="btn-delete-polyculture" data-i18n="btnDeleteGuild" class="rounded-lg bg-red-100 dark:bg-red-900/40 px-3 py-1.5 text-sm font-medium text-red-700 dark:text-red-300 ring-1 ring-red-300 dark:ring-red-800 hover:bg-red-200 dark:hover:bg-red-900/60">Löschen</button>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      <!-- Editor (links, 2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <div class="rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700 space-y-3">
          <label class="block">
            <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelName">Name</span>
            <input id="g-name" type="text" data-i18n-placeholder="placeholderName" placeholder="z.B. Apfelbaum-Polykultur Garten Süd" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
          </label>
          <label class="block">
            <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelDescription">Beschreibung</span>
            <input id="g-description" type="text" data-i18n-placeholder="placeholderDescription" placeholder="kurz, was die Polykultur zusammenhält" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
          </label>
          <label class="block">
            <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelAnchor">Ankerart</span>
            <select id="g-anchor" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none"></select>
          </label>
          <label class="block">
            <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="labelNotes">Notizen</span>
            <textarea id="g-notes" rows="2" data-i18n-placeholder="placeholderNotes" placeholder="Standort, Ziele, Beobachtungen…" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none"></textarea>
          </label>
        </div>

        <div class="rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
          <h2 class="mb-3 text-base font-semibold text-stone-800 dark:text-stone-100" data-i18n="membersHeading">Mitglieder</h2>
          <div id="member-list" class="space-y-2"></div>
          <div class="mt-3 text-xs text-stone-500 dark:text-stone-400" data-i18n="membersHint">Mitglieder aus dem Vorschlags-Panel rechts hinzufügen.</div>
        </div>

        <button id="btn-save-polyculture" data-i18n="btnSaveGuild" class="rounded-lg bg-green-700 px-5 py-2 text-sm font-medium text-white shadow transition hover:bg-green-800 active:scale-95">Polykultur speichern</button>
      </div>

      <!-- Vorschläge (rechts, 1 col) -->
      <aside class="rounded-xl bg-stone-50 dark:bg-stone-900 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
        <h2 class="mb-1 text-base font-semibold text-stone-800 dark:text-stone-100" data-i18n="suggestionsHeading">Vorschläge</h2>
        <p class="mb-3 text-xs text-stone-500 dark:text-stone-400" data-i18n="suggestionsIntro">Pflanzen aus deinem Bestand, die freie Rollen füllen und mit der Ankerart in Sonne/Wasser/pH überlappen.</p>
        <div id="suggestions"></div>
      </aside>
    </div>
  </section>

  <div id="toast" class="fixed bottom-6 right-6 hidden rounded-lg bg-green-700 px-4 py-2.5 text-sm font-medium text-white shadow-lg"></div>
</Layout>

<script>
  import { getAllPlants, savePlant } from '../lib/db';
  import { displayName, displayCommonName } from '../lib/plant-name';
  import { getAllPolycultures, getPolyculture, savePolyculture, deletePolyculture } from '../lib/db';
  import { searchPlants } from '../lib/plant-search';
  import { createPlantFromSearch } from '../lib/enrich';
  import {
    createEmptyPolyculture,
    ROLE_REQUIREMENT,
    type Polyculture, type PolycultureMember, type PolycultureRole, type PlantData,
  } from '../lib/types';
  import { escapeHtml } from '../lib/html';
  import { compatScore } from '../lib/compat';
  import { createT, applyStaticI18n } from '../lib/i18n/core';
  import { polyculturesDict } from '../lib/i18n/dict-polykulturen';

  const t = createT(polyculturesDict);
  applyStaticI18n(polyculturesDict);

  type RoleSuggestion = { latin: string; common: string };
  let curatedByRole: Partial<Record<PolycultureRole, RoleSuggestion[]>> = {};

  const ROLES: PolycultureRole[] = ['companion','groundCover','nFixer','mineralFixer','insectary','pestConfuser','fruitProducer','other'];

  const ROLE_I18N_KEY: Record<PolycultureRole, string> = {
    companion: 'roleCompanion',
    groundCover: 'roleGroundCover',
    nFixer: 'roleNFixer',
    mineralFixer: 'roleMineralFixer',
    insectary: 'roleInsectary',
    pestConfuser: 'rolePestConfuser',
    fruitProducer: 'roleFruitProducer',
    other: 'roleOther',
  };
  function roleLabel(role: PolycultureRole): string {
    return t(ROLE_I18N_KEY[role]);
  }

  // ── DOM refs ────────────────────────────────────────────────────────────
  const listView = document.getElementById('polyculture-list-view')!;
  const editorView = document.getElementById('polyculture-editor-view')!;
  const listEl = document.getElementById('polyculture-list')!;
  const emptyEl = document.getElementById('polyculture-empty')!;
  const toast = document.getElementById('toast')!;

  const fName = document.getElementById('g-name') as HTMLInputElement;
  const fDescription = document.getElementById('g-description') as HTMLInputElement;
  const fAnchor = document.getElementById('g-anchor') as HTMLSelectElement;
  const fNotes = document.getElementById('g-notes') as HTMLTextAreaElement;
  const memberList = document.getElementById('member-list')!;
  const suggestions = document.getElementById('suggestions')!;

  let plants: PlantData[] = [];
  let plantsById = new Map<string, PlantData>();
  let polycultures: Polyculture[] = [];
  let editing: Polyculture | null = null;

  function showToast(msg: string) {
    toast.textContent = msg;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 2000);
  }

  /** HTML-escaped label — safe to interpolate directly into innerHTML/attributes. */
  function plantLabel(p: PlantData | undefined): string {
    if (!p) return t('unknownPlant');
    const cn = displayCommonName(p);
    const label = cn ? `${cn} (${p.latinName})` : p.latinName || '—';
    return escapeHtml(label);
  }

  // ── Listenansicht ──────────────────────────────────────────────────────
  function renderList() {
    if (polycultures.length === 0) {
      emptyEl.classList.remove('hidden');
      listEl.classList.add('hidden');
      return;
    }
    emptyEl.classList.add('hidden');
    listEl.classList.remove('hidden');
    listEl.innerHTML = polycultures.map(g => {
      const anchor = g.anchorPlantId ? plantsById.get(g.anchorPlantId) : undefined;
      const filledRoles = new Set(g.members.map(m => m.role));
      const memberChips = g.members.slice(0, 6).map(m => {
        const p = plantsById.get(m.plantId);
        return `<span class="inline-block rounded-full bg-stone-100 dark:bg-stone-700 px-2 py-0.5 text-xs text-stone-700 dark:text-stone-200" title="${roleLabel(m.role)}">${plantLabel(p)}</span>`;
      }).join(' ');
      const more = g.members.length > 6 ? `<span class="text-xs text-stone-400">+${g.members.length - 6}</span>` : '';
      const memberCount = g.members.length === 1 ? t('memberCountSingular', { count: g.members.length }) : t('memberCountPlural', { count: g.members.length });
      return `
        <article data-polyculture-id="${g.id}" class="cursor-pointer rounded-xl bg-white dark:bg-stone-800 p-4 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700 transition hover:ring-green-300 dark:hover:ring-green-700">
          <h3 class="text-base font-semibold text-stone-900 dark:text-stone-100">${escapeHtml(g.name || t('guildUnnamed'))}</h3>
          ${g.description ? `<p class="mt-0.5 text-xs text-stone-500 dark:text-stone-400">${escapeHtml(g.description)}</p>` : ''}
          <p class="mt-2 text-sm text-stone-700 dark:text-stone-200"><span class="text-stone-400 dark:text-stone-500">${t('anchorLabel')}</span> ${plantLabel(anchor)}</p>
          <div class="mt-3 flex flex-wrap items-center gap-1">${memberChips} ${more}</div>
          <p class="mt-3 text-xs text-stone-400 dark:text-stone-500">${memberCount} · ${t('rolesFilled', { filled: filledRoles.size, total: ROLES.length })}</p>
        </article>`;
    }).join('');
    listEl.querySelectorAll<HTMLElement>('[data-polyculture-id]').forEach(el => {
      el.addEventListener('click', () => openEditor(el.dataset.polycultureId!));
    });
  }

  // ── Editor ─────────────────────────────────────────────────────────────
  function openEditor(id: string | null) {
    editing = id ? (polycultures.find(g => g.id === id) ?? createEmptyPolyculture()) : createEmptyPolyculture();
    fName.value = editing.name;
    fDescription.value = editing.description;
    fNotes.value = editing.notes;
    fAnchor.innerHTML = `<option value="">${t('anchorPleaseSelect')}</option>` + plants
      .map(p => `<option value="${p.id}" ${p.id === editing!.anchorPlantId ? 'selected' : ''}>${plantLabel(p)}</option>`)
      .join('');
    renderMembers();
    renderSuggestions();
    listView.hidden = true;
    editorView.hidden = false;
    window.scrollTo({ top: 0 });
  }

  function closeEditor() {
    editing = null;
    listView.hidden = false;
    editorView.hidden = true;
  }

  function renderMembers() {
    if (!editing) return;
    if (editing.members.length === 0) {
      memberList.innerHTML = `<p class="text-xs text-stone-400 dark:text-stone-500">${t('noMembers')}</p>`;
      return;
    }
    memberList.innerHTML = editing.members.map((m, i) => {
      const p = plantsById.get(m.plantId);
      const roleOptions = ROLES.map(r => `<option value="${r}" ${r === m.role ? 'selected' : ''}>${roleLabel(r)}</option>`).join('');
      return `
        <div class="flex items-center gap-2 rounded-md bg-stone-50 dark:bg-stone-900 p-2 ring-1 ring-stone-200 dark:ring-stone-700">
          <span class="flex-1 text-sm text-stone-800 dark:text-stone-100">${plantLabel(p)}</span>
          <select data-member-idx="${i}" class="member-role rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2 py-1 text-xs">${roleOptions}</select>
          <button data-remove-idx="${i}" class="rounded-md bg-red-100 dark:bg-red-900/40 px-2 py-1 text-xs font-medium text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900/60">×</button>
        </div>`;
    }).join('');
    memberList.querySelectorAll<HTMLSelectElement>('.member-role').forEach(sel => {
      sel.addEventListener('change', () => {
        const idx = parseInt(sel.dataset.memberIdx!);
        editing!.members[idx].role = sel.value as PolycultureRole;
        renderSuggestions();
      });
    });
    memberList.querySelectorAll<HTMLButtonElement>('[data-remove-idx]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.removeIdx!);
        editing!.members.splice(idx, 1);
        renderMembers();
        renderSuggestions();
      });
    });
  }

  // ── Mechanische Vorschläge ─────────────────────────────────────────────
  function renderSuggestions() {
    if (!editing) return;
    const anchorId = fAnchor.value || editing.anchorPlantId;
    const anchor = anchorId ? plantsById.get(anchorId) : undefined;
    if (!anchor) {
      suggestions.innerHTML = `<p class="text-xs text-stone-400 dark:text-stone-500">${t('chooseAnchorFirst')}</p>`;
      return;
    }
    const memberIds = new Set([anchorId, ...editing.members.map(m => m.plantId)]);
    const filledRoles = new Set(editing.members.map(m => m.role));
    const openRoles = ROLES.filter(r => !filledRoles.has(r) && r !== 'other');

    if (openRoles.length === 0) {
      suggestions.innerHTML = `<p class="text-xs text-green-700 dark:text-green-400">${t('allRolesFilled', { companion: roleLabel('companion') })}</p>`;
      return;
    }

    const blocks = openRoles.map(role => {
      const requirements = ROLE_REQUIREMENT[role];
      const candidates = plants
        .filter(p => !memberIds.has(p.id))
        .filter(p => requirements.length === 0 || requirements.every(k => Boolean((p as any)[k])))
        .map(p => ({ p, score: compatScore(p, anchor) }))
        .sort((a, b) => b.score - a.score)
        .slice(0, 5);

      const curatedAvailable = (curatedByRole[role] ?? []).filter(s => !findByLatin(s.latin));

      if (candidates.length === 0 && curatedAvailable.length === 0) {
        return `<details class="mb-2 rounded-md bg-white dark:bg-stone-800 p-2 ring-1 ring-stone-200 dark:ring-stone-700">
          <summary class="cursor-pointer text-xs font-medium text-stone-500 dark:text-stone-400">${roleLabel(role)} <span class="text-stone-400">— ${t('noMatchingPlants')}</span></summary>
        </details>`;
      }
      if (candidates.length === 0) {
        // Nur kuratierte Vorschläge — Block trotzdem zeigen, mit Hinweis.
        const curatedHtml = curatedAvailable.slice(0, 6).map(s => `
          <div class="flex items-center justify-between gap-2 rounded px-2 py-1 text-xs italic text-stone-500 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-stone-700">
            <span class="min-w-0 flex-1 truncate" title="${t('notInCollectionTitle', { common: s.common, latin: s.latin })}">${s.common} <span class="font-mono not-italic text-[10px] text-stone-400">${s.latin}</span></span>
            <button data-import-latin="${s.latin}" data-import-role="${role}" class="shrink-0 rounded bg-blue-100 dark:bg-blue-900/40 px-2 py-0.5 font-medium not-italic text-blue-700 dark:text-blue-300 hover:bg-blue-200 dark:hover:bg-blue-900/60">${t('btnImport')}</button>
          </div>`).join('');
        return `
          <div class="mb-3 rounded-md bg-white dark:bg-stone-800 p-2 ring-1 ring-stone-200 dark:ring-stone-700">
            <div class="mb-1 px-1 text-xs font-semibold text-stone-700 dark:text-stone-200">${roleLabel(role)}</div>
            <p class="mb-1 px-1 text-[10px] text-stone-500 dark:text-stone-400">${t('noPlantForRole')}</p>
            ${curatedHtml}
          </div>`;
      }
      const items = candidates.map(({ p, score }) => `
        <div class="flex items-center justify-between gap-2 rounded px-2 py-1 text-xs hover:bg-stone-100 dark:hover:bg-stone-700">
          <span class="min-w-0 flex-1 truncate text-stone-800 dark:text-stone-100" title="${plantLabel(p)}">${plantLabel(p)}</span>
          <span class="shrink-0 font-mono text-[10px] text-stone-400" title="${t('sunWaterPhTitle')}">${score}/3</span>
          <button data-add-plant="${p.id}" data-add-role="${role}" class="shrink-0 rounded bg-green-100 dark:bg-green-900/40 px-2 py-0.5 font-medium text-green-700 dark:text-green-300 hover:bg-green-200 dark:hover:bg-green-900/60">${t('btnAdd')}</button>
        </div>`).join('');

      // Kuratierte Vorschläge aus role-suggestions.json, die noch nicht im Bestand sind.
      const curatedHtml = (curatedByRole[role] ?? [])
        .filter(s => !findByLatin(s.latin))
        .slice(0, 6)
        .map(s => `
          <div class="flex items-center justify-between gap-2 rounded px-2 py-1 text-xs italic text-stone-500 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-stone-700">
            <span class="min-w-0 flex-1 truncate" title="${t('notInCollectionTitle', { common: s.common, latin: s.latin })}">${s.common} <span class="font-mono not-italic text-[10px] text-stone-400">${s.latin}</span></span>
            <button data-import-latin="${s.latin}" data-import-role="${role}" class="shrink-0 rounded bg-blue-100 dark:bg-blue-900/40 px-2 py-0.5 font-medium not-italic text-blue-700 dark:text-blue-300 hover:bg-blue-200 dark:hover:bg-blue-900/60">${t('btnImport')}</button>
          </div>`).join('');

      const curatedSection = curatedHtml
        ? `<div class="mt-1 border-t border-stone-100 dark:border-stone-700 pt-1">
             <div class="mb-1 px-1 text-[10px] font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500">${t('knownRepresentatives')}</div>
             ${curatedHtml}
           </div>`
        : '';

      return `
        <div class="mb-3 rounded-md bg-white dark:bg-stone-800 p-2 ring-1 ring-stone-200 dark:ring-stone-700">
          <div class="mb-1 px-1 text-xs font-semibold text-stone-700 dark:text-stone-200">${roleLabel(role)}</div>
          ${items}
          ${curatedSection}
        </div>`;
    });

    suggestions.innerHTML = blocks.join('');
    suggestions.querySelectorAll<HTMLButtonElement>('[data-add-plant]').forEach(btn => {
      btn.addEventListener('click', () => {
        editing!.members.push({
          plantId: btn.dataset.addPlant!,
          role: btn.dataset.addRole as PolycultureRole,
          notes: '',
        });
        renderMembers();
        renderSuggestions();
      });
    });
    suggestions.querySelectorAll<HTMLButtonElement>('[data-import-latin]').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (btn.disabled) return;
        const latin = btn.dataset.importLatin!;
        const role = btn.dataset.importRole as PolycultureRole;
        const original = btn.textContent;
        btn.disabled = true;
        btn.textContent = '…';
        try {
          const plant = await importByLatin(latin);
          if (!plant) throw new Error('keine Treffer');
          editing!.members.push({ plantId: plant.id, role, notes: '' });
          renderMembers();
          renderSuggestions();
          showToast(t('toastImported', { name: displayName(plant) }));
        } catch (err) {
          alert(t('alertImportFailed', { latin, error: err instanceof Error ? err.message : String(err) }));
          btn.disabled = false;
          btn.textContent = original;
        }
      });
    });
  }

  // ── Init + handlers ────────────────────────────────────────────────────
  async function loadCurated() {
    try {
      const res = await fetch('/role-suggestions.json');
      if (res.ok) curatedByRole = await res.json();
    } catch { /* offline first run, no curated suggestions */ }
  }

  async function init() {
    await loadCurated();
    plants = await getAllPlants();
    plantsById = new Map(plants.map(p => [p.id, p]));
    polycultures = await getAllPolycultures();
    renderList();
  }

  // Latin-name → existing plant, case-insensitive (used to skip curated items
  // already in bestand).
  function findByLatin(latin: string): PlantData | undefined {
    const target = latin.toLowerCase();
    return plants.find(p => p.latinName.toLowerCase() === target);
  }

  async function importByLatin(latin: string): Promise<PlantData | null> {
    const results = await searchPlants(latin);
    const match = results.find(r => r.latinName.toLowerCase() === latin.toLowerCase()) ?? results[0];
    if (!match) return null;
    const { plant } = await createPlantFromSearch(match);
    await savePlant(plant);
    plants = await getAllPlants();
    plantsById = new Map(plants.map(p => [p.id, p]));
    return plant;
  }

  document.getElementById('btn-new-polyculture')!.addEventListener('click', () => openEditor(null));
  document.getElementById('btn-empty-new')!.addEventListener('click', () => openEditor(null));
  document.getElementById('btn-back-to-list')!.addEventListener('click', closeEditor);

  fAnchor.addEventListener('change', () => renderSuggestions());

  document.getElementById('btn-save-polyculture')!.addEventListener('click', async () => {
    if (!editing) return;
    if (!fName.value.trim()) { alert(t('alertEnterName')); return; }
    editing.name = fName.value.trim();
    editing.description = fDescription.value.trim();
    editing.notes = fNotes.value;
    editing.anchorPlantId = fAnchor.value || null;
    await savePolyculture(editing);
    polycultures = await getAllPolycultures();
    renderList();
    closeEditor();
    showToast(t('toastGuildSaved'));
  });

  document.getElementById('btn-delete-polyculture')!.addEventListener('click', async () => {
    if (!editing) return;
    if (!confirm(t('confirmDeleteGuild', { name: editing.name || t('unnamedGuild') }))) return;
    await deletePolyculture(editing.id);
    polycultures = await getAllPolycultures();
    renderList();
    closeEditor();
    showToast(t('toastGuildDeleted'));
  });

  init();
</script>
