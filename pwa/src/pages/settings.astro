---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Perma Design Kit — Einstellungen">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-stone-900 dark:text-stone-100" data-i18n="pageTitle">Einstellungen</h1>
    <p class="mt-1 text-sm text-stone-500 dark:text-stone-400" data-i18n="pageSubtitle">Datenquellen, Ansicht, Theme und Daten verwalten.</p>
  </div>

  <!-- Datenquellen -->
  <section class="mb-8">
    <h2 class="mb-3 text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionSources">Datenquellen</h2>
    <div id="sources-list" class="space-y-4"></div>
  </section>

  <!-- Ansicht -->
  <section class="mb-8 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionView">Ansicht</h2>
    <p class="mt-1 text-xs text-stone-500 dark:text-stone-400" data-i18n="viewSubtitle">Welche Ansicht beim App-Start gezeigt wird.</p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <label class="block text-sm">
        <span class="font-medium text-stone-700 dark:text-stone-200" data-i18n="labelDefaultView">Standard-Ansicht</span>
        <select id="default-view" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 shadow-inner focus:border-green-500 focus:outline-none">
          <option value="grid" data-i18n="optGrid">Kacheln</option>
          <option value="list" data-i18n="optList">Liste</option>
          <option value="cards" data-i18n="optCards">Karten</option>
        </select>
      </label>
      <label class="block text-sm">
        <span class="font-medium text-stone-700 dark:text-stone-200" data-i18n="labelDefaultCardVariant">Standard-Kartenvariante</span>
        <select id="default-card-variant" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 shadow-inner focus:border-green-500 focus:outline-none">
          <option value="poly" data-i18n="optPoly">Pflanzenkarten</option>
          <option value="stripe" data-i18n="optStripe">Streifenkarten</option>
          <option value="baumscheibe" data-i18n="optBaumscheibe">Baumscheibe</option>
        </select>
      </label>
    </div>
  </section>

  <!-- Theme -->
  <section class="mb-8 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionTheme">Theme</h2>
    <p class="mt-1 text-xs text-stone-500 dark:text-stone-400" data-i18n="themeSubtitle">"Auto" folgt der System­einstellung deines Geräts.</p>
    <div class="mt-3 flex flex-wrap gap-4 text-sm">
      <label class="inline-flex items-center gap-2"><input type="radio" name="theme" value="auto" class="theme-radio accent-green-600" /> <span data-i18n="themeAuto">Auto</span></label>
      <label class="inline-flex items-center gap-2"><input type="radio" name="theme" value="light" class="theme-radio accent-green-600" /> <span data-i18n="themeLight">Hell</span></label>
      <label class="inline-flex items-center gap-2"><input type="radio" name="theme" value="dark" class="theme-radio accent-green-600" /> <span data-i18n="themeDark">Dunkel</span></label>
    </div>
  </section>

  <!-- Privatsphäre -->
  <section class="mb-8 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionPrivacy">Privatsphäre</h2>
    <label class="mt-3 inline-flex items-start gap-2 text-sm">
      <input type="checkbox" id="analytics-optout" class="mt-0.5 accent-green-600" />
      <span>
        <span class="font-medium text-stone-700 dark:text-stone-200" data-i18n="privacyOptOutLabel">Reichweitenmessung deaktivieren</span>
        <span class="block text-xs text-stone-500 dark:text-stone-400"><span data-i18n="privacyOptOutDescPre">Die selbst gehostete Reichweitenmessung (Umami) erfasst keine personenbezogenen Daten — falls du trotzdem nicht gezählt werden möchtest, hier den Haken setzen. Details in der</span> <a href="/datenschutz" data-i18n="privacyOptOutDescLink" class="text-green-700 dark:text-green-400 hover:underline">Datenschutzerklärung</a>.</span>
      </span>
    </label>
  </section>

  <div class="mb-12 flex gap-3">
    <button id="btn-save" data-i18n="btnSaveSettings" class="rounded-lg bg-green-700 px-5 py-2 text-sm font-medium text-white shadow transition hover:bg-green-800 active:scale-95">Einstellungen speichern</button>
  </div>

  <!-- Daten -->
  <section id="daten-section" class="mb-8 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionData">Daten</h2>
    <p class="mt-1 text-xs text-stone-500 dark:text-stone-400" data-i18n="dataSubtitle">Alle Pflanzen­daten und Polykulturen leben lokal in deinem Browser (IndexedDB).</p>

    <dl class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="statLabelPlants">Pflanzen­datensätze</dt>
        <dd id="stats-plants" class="font-mono text-stone-800 dark:text-stone-100">…</dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="statLabelStorage">Speicherverbrauch</dt>
        <dd id="stats-storage" class="font-mono text-stone-800 dark:text-stone-100">…</dd>
      </div>
    </dl>

    <p id="last-backup-info" class="mt-3 text-xs text-stone-500 dark:text-stone-400"></p>

    <div class="mt-4 flex flex-wrap gap-2">
      <button id="btn-backup" data-i18n="btnBackupDownload" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Backup herunterladen (JSON)</button>
      <button id="btn-share-backup" hidden data-i18n="btnShareBackup" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Backup teilen…</button>
      <label class="cursor-pointer rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">
        <span data-i18n="btnRestoreLabel">Backup einlesen…</span>
        <input type="file" id="restore-input" accept=".json,application/json" class="hidden" />
      </label>
      <button id="btn-reload-master" data-i18n="btnReloadMaster" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Golden Master neu laden</button>
    </div>

    <div class="mt-6 rounded-lg border border-red-300 dark:border-red-800 bg-red-50 dark:bg-red-900/20 p-4">
      <h3 class="text-sm font-semibold text-red-800 dark:text-red-200" data-i18n="dangerZoneTitle">Danger Zone</h3>
      <p class="mt-1 text-xs text-red-700 dark:text-red-300" data-i18n="dangerZoneDesc">Löscht alle Pflanzendatensätze und deine Einstellungen unwiderruflich.</p>
      <button id="btn-clear-all" data-i18n="btnClearAll" class="mt-3 rounded-lg bg-red-600 px-3 py-1.5 text-sm font-medium text-white ring-1 ring-red-700 hover:bg-red-700">Alle Daten löschen</button>
    </div>
  </section>

  <!-- Sync -->
  <section class="mb-8 rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-100" data-i18n="sectionSync">Sync</h2>
    <p class="mt-1 text-xs text-stone-500 dark:text-stone-400" data-i18n="syncSubtitle">Pflanzen und Polykulturen in einen externen Speicher sichern — manuell oder automatisch beim Verlassen der App.</p>

    <!-- Auto-Sync Toggle -->
    <div class="mt-5 flex items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="text-sm font-medium text-stone-700 dark:text-stone-200" data-i18n="autoSyncLabel">Automatisch synchronisieren</p>
        <p class="mt-0.5 text-xs text-stone-500 dark:text-stone-400" data-i18n="autoSyncDesc">
          Beim Tab-Wechsel oder Schließen automatisch zum ersten konfigurierten Anbieter synchronisieren
          (Priorität: WebDAV → GitHub Gist).
        </p>
        <p id="last-sync-info" class="mt-1 text-xs text-stone-400 dark:text-stone-500"></p>
      </div>
      <label class="relative inline-flex shrink-0 cursor-pointer items-center">
        <input type="checkbox" id="auto-sync-toggle" class="peer sr-only" />
        <div class="h-6 w-11 rounded-full bg-stone-300 dark:bg-stone-600 after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-all peer-checked:bg-green-600 peer-checked:after:translate-x-full"></div>
      </label>
    </div>

    <!-- WebDAV -->
    <details class="mt-5 rounded-lg border border-stone-200 dark:border-stone-700 p-4">
      <summary class="cursor-pointer text-sm font-semibold text-stone-700 dark:text-stone-200" data-i18n="webdavSummary">WebDAV (z.B. Nextcloud)</summary>
      <p class="mt-2 text-xs text-stone-500 dark:text-stone-400">
        <span data-i18n="webdavDescPre">Pusht/zieht das JSON-Backup direkt in deinen WebDAV-Speicher. Zugangsdaten bleiben
        im Browser (</span><code>localStorage</code><span data-i18n="webdavDescMid">), werden nicht übertragen außer ans angegebene Ziel.
        Dein Server muss</span> <strong data-i18n="webdavDescCors">CORS</strong> <span data-i18n="webdavDescPost">für die Domain dieser App erlauben — bei Nextcloud
        z.B. via</span> <code>occ config:system:set cors.allowed-domains</code>.
      </p>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <label class="block text-xs sm:col-span-2">
          <span class="font-medium text-stone-500 dark:text-stone-400" data-i18n="webdavUrlLabel">Ziel-URL (vollständige Datei-URL)</span>
          <input id="webdav-url" type="url" placeholder="https://cloud.example.com/remote.php/dav/files/USER/perma-design-kit-backup.json" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 font-mono text-xs shadow-inner focus:border-green-500 focus:outline-none" />
        </label>
        <label class="block text-xs">
          <span class="font-medium text-stone-500 dark:text-stone-400" data-i18n="webdavUserLabel">Benutzername</span>
          <input id="webdav-user" type="text" autocomplete="off" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
        </label>
        <label class="block text-xs">
          <span class="font-medium text-stone-500 dark:text-stone-400" data-i18n="webdavPassLabel">Passwort / App-Token</span>
          <input id="webdav-pass" type="password" autocomplete="off" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none" />
        </label>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button id="btn-webdav-save-creds" data-i18n="btnWebdavSaveCreds" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Zugang merken</button>
        <button id="btn-webdav-clear-creds" data-i18n="btnWebdavClearCreds" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Zugang vergessen</button>
        <span class="h-4 w-px bg-stone-300 dark:bg-stone-700"></span>
        <button id="btn-webdav-push" data-i18n="btnWebdavPush" class="rounded-lg bg-green-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-green-800">Backup hochladen ↑</button>
        <button id="btn-webdav-pull" data-i18n="btnWebdavPull" class="rounded-lg bg-blue-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-blue-800">Backup abrufen ↓</button>
        <span id="webdav-status" class="text-xs text-stone-500 dark:text-stone-400"></span>
      </div>
    </details>

    <!-- Lokale Datei (File System Access API, nur Chromium) -->
    <details id="details-fsa" class="mt-4 rounded-lg border border-stone-200 dark:border-stone-700 p-4" hidden>
      <summary class="cursor-pointer text-sm font-semibold text-stone-700 dark:text-stone-200" data-i18n="fsaSummary">Lokale Datei (Chrome / Edge)</summary>
      <p class="mt-2 text-xs text-stone-500 dark:text-stone-400" data-i18n="fsaDesc">
        Schreibt das Backup direkt in eine Datei auf deinem Gerät oder liest es von dort.
        Die Datei kannst du z.&nbsp;B. in einem Cloud-Ordner ablegen (iCloud Drive, Dropbox,
        Google Drive Offline-Ordner). Nur in Chromium-basierten Browsern verfügbar.
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button id="btn-fsa-write" data-i18n="btnFsaWrite" class="rounded-lg bg-green-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-green-800">In Datei speichern ↑</button>
        <button id="btn-fsa-read" data-i18n="btnFsaRead" class="rounded-lg bg-blue-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-blue-800">Aus Datei laden ↓</button>
        <span id="fsa-status" class="text-xs text-stone-500 dark:text-stone-400"></span>
      </div>
    </details>

    <!-- GitHub Gist -->
    <details class="mt-4 rounded-lg border border-stone-200 dark:border-stone-700 p-4">
      <summary class="cursor-pointer text-sm font-semibold text-stone-700 dark:text-stone-200" data-i18n="gistSummary">GitHub Gist (geräteübergreifend)</summary>
      <p class="mt-2 text-xs text-stone-500 dark:text-stone-400">
        <span data-i18n="gistDescPre">Speichert das Backup als privates GitHub Gist. Du brauchst einen GitHub-Account und ein</span>
        <a href="https://github.com/settings/tokens/new?scopes=gist&description=Perma+Design+Kit" target="_blank" rel="noopener" data-i18n="gistDescLink" class="text-green-700 dark:text-green-400 hover:underline">Personal Access Token</a>
        <span data-i18n="gistDescPost">mit dem Scope</span> <code>gist</code><span data-i18n="gistDescPost2">. Beim ersten Hochladen wird ein neues Gist angelegt
        und die ID automatisch gespeichert — danach einfach wieder drücken.</span>
      </p>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <label class="block text-xs">
          <span class="font-medium text-stone-500 dark:text-stone-400" data-i18n="gistTokenLabel">GitHub Token (PAT)</span>
          <input id="gist-token" type="password" autocomplete="off" placeholder="ghp_…" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 font-mono text-xs shadow-inner focus:border-green-500 focus:outline-none" />
        </label>
        <label class="block text-xs">
          <span class="font-medium text-stone-500 dark:text-stone-400" data-i18n="gistIdLabel">Gist-ID (leer = wird beim ersten Upload gesetzt)</span>
          <input id="gist-id" type="text" autocomplete="off" data-i18n-placeholder="gistIdPlaceholder" placeholder="automatisch gesetzt" class="mt-1 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 font-mono text-xs shadow-inner focus:border-green-500 focus:outline-none" />
        </label>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button id="btn-gist-save-creds" data-i18n="btnGistSaveCreds" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Token merken</button>
        <button id="btn-gist-clear-creds" data-i18n="btnGistClearCreds" class="rounded-lg bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-200 dark:hover:bg-stone-600">Token vergessen</button>
        <span class="h-4 w-px bg-stone-300 dark:bg-stone-700"></span>
        <button id="btn-gist-push" data-i18n="btnGistPush" class="rounded-lg bg-green-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-green-800">Zu Gist hochladen ↑</button>
        <button id="btn-gist-pull" data-i18n="btnGistPull" class="rounded-lg bg-blue-700 px-3 py-1.5 text-xs font-medium text-white shadow hover:bg-blue-800">Von Gist abrufen ↓</button>
        <span id="gist-status" class="text-xs text-stone-500 dark:text-stone-400"></span>
      </div>
    </details>
  </section>

  <div id="toast" class="fixed bottom-6 right-6 hidden rounded-lg bg-green-700 px-4 py-2.5 text-sm font-medium text-white shadow-lg transition"></div>
</Layout>

<script>
  import {
    loadSettings, saveSettings,
    getTheme, setTheme, applyTheme,
    isAnalyticsOptedOut, setAnalyticsOptOut,
    type AppSettings, type ViewMode, type CardVariant, type ThemePref,
  } from '../lib/settings';
  import { getAllPlants, importPlants, clearAllPlants, importPolycultures, importGardenPlans } from '../lib/db';
  import { buildBackupJson, parseBackup, rememberSyncAt, isAutoSyncEnabled, GIST_FILENAME, GIST_FILENAME_LEGACY } from '../lib/sync';
  import { escapeHtml } from '../lib/html';
  import { createT, applyStaticI18n, getLang } from '../lib/i18n/core';
  import { settingsDict } from '../lib/i18n/dict-settings';

  const t = createT(settingsDict);
  applyStaticI18n(settingsDict);

  // DEFAULT_SOURCES' name/description (src/lib/settings.ts) are German-only —
  // that file is shared runtime data, not display markup, so we translate at
  // this render call site instead of touching it. Keyed by source id.
  const SOURCE_DESC_KEY: Record<string, string> = {
    wikidata: 'sourceDescWikidata',
    pfaf: 'sourceDescPfaf',
    naturadb: 'sourceDescNaturadb',
  };

  const sourcesList = document.getElementById('sources-list')!;
  const toast = document.getElementById('toast')!;
  const defaultView = document.getElementById('default-view') as HTMLSelectElement;
  const defaultCardVariant = document.getElementById('default-card-variant') as HTMLSelectElement;
  const analyticsOptout = document.getElementById('analytics-optout') as HTMLInputElement;
  const statsPlants = document.getElementById('stats-plants')!;
  const statsStorage = document.getElementById('stats-storage')!;
  const autoSyncToggle = document.getElementById('auto-sync-toggle') as HTMLInputElement;

  let settings: AppSettings;

  function showToast(msg: string) {
    toast.textContent = msg;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 2000);
  }

  function renderSources() {
    sourcesList.innerHTML = settings.sources.map((src, i) => {
      // NaturaDB is hidden from Settings — unresolved licensing (see
      // CHANGELOG.md "NaturaDB-Scraping vorerst deaktiviert"), scraping hard-disabled
      // server-side regardless of this toggle. Kept in DEFAULT_SOURCES
      // (not filtered before .map) so `i` still matches settings.sources'
      // real indices for the other cards' data-idx-based save handler.
      if (src.id === 'naturadb') return '';
      return `
      <div class="rounded-xl bg-white dark:bg-stone-800 p-5 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-3">
              <label class="relative inline-flex cursor-pointer items-center">
                <input type="checkbox" class="src-enabled peer sr-only" data-idx="${i}" ${src.enabled ? 'checked' : ''} />
                <div class="h-6 w-11 rounded-full bg-stone-300 dark:bg-stone-600 after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-all peer-checked:bg-green-600 peer-checked:after:translate-x-full"></div>
              </label>
              <h3 class="text-sm font-bold text-stone-800 dark:text-stone-100">${src.name}</h3>
              ${src.url ? `<a href="${src.url}" target="_blank" rel="noopener" class="text-xs text-stone-400 dark:text-stone-500 hover:text-green-700 hover:underline">${new URL(src.url).hostname}</a>` : ''}
            </div>
            <p class="mt-1 text-xs text-stone-500 dark:text-stone-400">${SOURCE_DESC_KEY[src.id] ? t(SOURCE_DESC_KEY[src.id]) : src.description}</p>
          </div>
        </div>
        ${src.needsApiKey ? `
          <div class="mt-3">
            <label class="block text-xs font-medium text-stone-500 dark:text-stone-400">${t('apiKeyLabel')}
              <input type="password" class="src-apikey mt-0.5 block w-full max-w-sm rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none" data-idx="${i}" value="${escapeHtml(src.apiKey)}" placeholder="${t('apiKeyPlaceholder')}" />
            </label>
          </div>
        ` : ''}
        <div class="mt-2 flex gap-2">
          <span class="inline-block rounded-full px-2 py-0.5 text-xs font-medium ${src.id === 'wikidata' ? 'bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300' : 'bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-200'}">
            ${src.id === 'wikidata' ? t('sourceDirectLabel') : t('sourceProxyLabel')}
          </span>
        </div>
      </div>
    `;
    }).join('');
  }

  function renderPrefs() {
    defaultView.value = settings.defaultView;
    defaultCardVariant.value = settings.defaultCardVariant;
    const t = getTheme();
    document.querySelectorAll<HTMLInputElement>('.theme-radio').forEach(r => { r.checked = r.value === t; });
    analyticsOptout.checked = isAnalyticsOptedOut();
    autoSyncToggle.checked = isAutoSyncEnabled();
  }

  function fmtBytes(n: number): string {
    if (n < 1024) return `${n} B`;
    if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} kB`;
    return `${(n / (1024 * 1024)).toFixed(2)} MB`;
  }

  async function renderStats() {
    const plants = await getAllPlants();
    statsPlants.textContent = `${plants.length}`;
    if (navigator.storage?.estimate) {
      try {
        const est = await navigator.storage.estimate();
        const used = est.usage ?? 0;
        const quota = est.quota ?? 0;
        statsStorage.textContent = quota
          ? `${fmtBytes(used)} / ${fmtBytes(quota)}`
          : fmtBytes(used);
      } catch {
        statsStorage.textContent = '—';
      }
    } else {
      statsStorage.textContent = '—';
    }
  }

  // ── Save handler ────────────────────────────────────────────────────────
  document.getElementById('btn-save')!.addEventListener('click', () => {
    document.querySelectorAll('.src-enabled').forEach((cb) => {
      const input = cb as HTMLInputElement;
      const idx = parseInt(input.dataset.idx!);
      settings.sources[idx].enabled = input.checked;
    });
    document.querySelectorAll('.src-apikey').forEach((inp) => {
      const input = inp as HTMLInputElement;
      const idx = parseInt(input.dataset.idx!);
      settings.sources[idx].apiKey = input.value;
    });
    settings.defaultView = defaultView.value as ViewMode;
    settings.defaultCardVariant = defaultCardVariant.value as CardVariant;
    saveSettings(settings);

    const themeChoice = (document.querySelector<HTMLInputElement>('.theme-radio:checked')?.value ?? 'auto') as ThemePref;
    setTheme(themeChoice);
    applyTheme(themeChoice);

    setAnalyticsOptOut(analyticsOptout.checked);

    try { localStorage.setItem('auto-sync-enabled', autoSyncToggle.checked ? 'true' : 'false'); } catch {}

    showToast(t('toastSettingsSaved'));
  });

  // ── Daten: Backup ───────────────────────────────────────────────────────
  async function buildBackupBlob(): Promise<{ blob: Blob; filename: string }> {
    const json = await buildBackupJson();
    const blob = new Blob([json], { type: 'application/json' });
    const filename = `perma-design-kit-backup-${new Date().toISOString().slice(0, 10)}.json`;
    return { blob, filename };
  }

  function renderLastBackup() {
    const el = document.getElementById('last-backup-info');
    if (!el) return;
    let last: string | null = null;
    try { last = localStorage.getItem('last-backup-at'); } catch {}
    el.textContent = last
      ? t('lastBackupPrefix', { date: new Date(last).toLocaleString(getLang() === 'en' ? 'en-US' : 'de-DE') })
      : t('lastBackupNone');
  }

  function renderLastSyncInfo() {
    const el = document.getElementById('last-sync-info');
    if (!el) return;
    let at: string | null = null;
    let provider: string | null = null;
    try {
      at = localStorage.getItem('last-auto-sync-at');
      provider = localStorage.getItem('last-auto-sync-provider');
    } catch {}
    if (!at) { el.textContent = ''; return; }
    const providerLabel = provider === 'webdav' ? 'WebDAV' : provider === 'gist' ? 'GitHub Gist' : provider ?? '';
    el.textContent = t('lastSyncPrefix', { date: new Date(at).toLocaleString(getLang() === 'en' ? 'en-US' : 'de-DE') })
      + (providerLabel ? t('lastSyncVia', { provider: providerLabel }) : '');
  }

  function downloadBackupBlob(blob: Blob, filename: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  document.getElementById('btn-backup')!.addEventListener('click', async () => {
    const { blob, filename } = await buildBackupBlob();
    downloadBackupBlob(blob, filename);
    rememberSyncAt('manual');
    renderLastBackup();
  });

  const shareBtn = document.getElementById('btn-share-backup') as HTMLButtonElement | null;
  if (shareBtn && 'share' in navigator) {
    shareBtn.hidden = false;
    shareBtn.addEventListener('click', async () => {
      const { blob, filename } = await buildBackupBlob();
      const file = new File([blob], filename, { type: 'application/json' });
      try {
        if ((navigator as any).canShare?.({ files: [file] })) {
          await navigator.share({ files: [file], title: 'Perma Design Kit Backup' });
          rememberSyncAt('share');
          renderLastBackup();
        } else {
          downloadBackupBlob(blob, filename);
          rememberSyncAt('manual');
          renderLastBackup();
        }
      } catch (err) {
        if ((err as Error).name !== 'AbortError') alert(t('shareFailed', { err: String(err) }));
      }
    });
  }

  // ── Sync: Auto-Sync Toggle ───────────────────────────────────────────────
  autoSyncToggle.addEventListener('change', () => {
    try { localStorage.setItem('auto-sync-enabled', autoSyncToggle.checked ? 'true' : 'false'); } catch {}
  });

  // ── Sync: WebDAV ─────────────────────────────────────────────────────────
  const webdavUrl = document.getElementById('webdav-url') as HTMLInputElement;
  const webdavUser = document.getElementById('webdav-user') as HTMLInputElement;
  const webdavPass = document.getElementById('webdav-pass') as HTMLInputElement;
  const webdavStatus = document.getElementById('webdav-status')!;

  function loadWebdavCreds() {
    try {
      webdavUrl.value = localStorage.getItem('webdav-url') || '';
      webdavUser.value = localStorage.getItem('webdav-user') || '';
      webdavPass.value = localStorage.getItem('webdav-pass') || '';
    } catch {}
  }
  function authHeader(): string {
    const raw = `${webdavUser.value}:${webdavPass.value}`;
    return 'Basic ' + btoa(unescape(encodeURIComponent(raw)));
  }
  function setWebdavStatus(msg: string, kind: 'ok' | 'err' | 'idle' = 'idle') {
    webdavStatus.textContent = msg;
    webdavStatus.className = 'text-xs ' + (
      kind === 'ok'  ? 'text-green-700 dark:text-green-400' :
      kind === 'err' ? 'text-red-700 dark:text-red-400'    :
                       'text-stone-500 dark:text-stone-400');
  }

  document.getElementById('btn-webdav-save-creds')!.addEventListener('click', () => {
    try {
      localStorage.setItem('webdav-url', webdavUrl.value.trim());
      localStorage.setItem('webdav-user', webdavUser.value);
      localStorage.setItem('webdav-pass', webdavPass.value);
      setWebdavStatus(t('webdavCredsSaved'), 'ok');
    } catch (err) { setWebdavStatus(t('webdavErrorUpload', { msg: String(err) }), 'err'); }
  });
  document.getElementById('btn-webdav-clear-creds')!.addEventListener('click', () => {
    try {
      localStorage.removeItem('webdav-url');
      localStorage.removeItem('webdav-user');
      localStorage.removeItem('webdav-pass');
      webdavUrl.value = ''; webdavUser.value = ''; webdavPass.value = '';
      setWebdavStatus(t('webdavCredsCleared'), 'idle');
    } catch {}
  });

  document.getElementById('btn-webdav-push')!.addEventListener('click', async () => {
    if (!webdavUrl.value || !webdavUser.value) { setWebdavStatus(t('webdavMissingFields'), 'err'); return; }
    setWebdavStatus(t('webdavUploading'));
    try {
      const json = await buildBackupJson();
      const res = await fetch(webdavUrl.value, {
        method: 'PUT',
        headers: { 'Authorization': authHeader(), 'Content-Type': 'application/json' },
        body: json,
      });
      if (!res.ok) throw new Error(`HTTP ${res.status} ${res.statusText}`);
      rememberSyncAt('webdav');
      renderLastBackup();
      setWebdavStatus(t('webdavUploaded', { status: res.status }), 'ok');
    } catch (err) {
      setWebdavStatus(t('webdavErrorUpload', { msg: (err as Error).message }), 'err');
    }
  });

  document.getElementById('btn-webdav-pull')!.addEventListener('click', async () => {
    if (!webdavUrl.value || !webdavUser.value) { setWebdavStatus(t('webdavMissingFields'), 'err'); return; }
    if (!confirm(t('webdavConfirmPull'))) return;
    setWebdavStatus(t('webdavDownloading'));
    try {
      const res = await fetch(webdavUrl.value, {
        method: 'GET',
        headers: { 'Authorization': authHeader() },
      });
      if (!res.ok) throw new Error(`HTTP ${res.status} ${res.statusText}`);
      const {
        plants: restoredPlants, polycultures: restoredPolycultures,
        gardenPlans: restoredGardenPlans, settings: restoredSettings,
      } = parseBackup(await res.text());
      if (restoredPlants.length === 0) throw new Error(t('invalidBackupFormat'));
      await importPlants(restoredPlants);
      if (restoredPolycultures.length) await importPolycultures(restoredPolycultures);
      if (restoredGardenPlans.length) await importGardenPlans(restoredGardenPlans);
      if (restoredSettings) {
        saveSettings(restoredSettings as AppSettings);
        settings = loadSettings();
        renderSources(); renderPrefs();
      }
      await renderStats();
      setWebdavStatus(t('restoredCount', { plants: restoredPlants.length, guilds: restoredPolycultures.length, gardenPlans: restoredGardenPlans.length }), 'ok');
    } catch (err) {
      setWebdavStatus(t('webdavErrorDownload', { msg: (err as Error).message }), 'err');
    }
  });

  // ── Sync: File System Access API ─────────────────────────────────────────
  const fsaDetails = document.getElementById('details-fsa') as HTMLDetailsElement | null;
  const fsaStatus = document.getElementById('fsa-status')!;

  function setFsaStatus(msg: string, kind: 'ok' | 'err' | 'idle' = 'idle') {
    fsaStatus.textContent = msg;
    fsaStatus.className = 'text-xs ' + (
      kind === 'ok'  ? 'text-green-700 dark:text-green-400' :
      kind === 'err' ? 'text-red-700 dark:text-red-400'    :
                       'text-stone-500 dark:text-stone-400');
  }

  if (fsaDetails && 'showSaveFilePicker' in window) {
    fsaDetails.hidden = false;

    document.getElementById('btn-fsa-write')!.addEventListener('click', async () => {
      try {
        const json = await buildBackupJson();
        const blob = new Blob([json], { type: 'application/json' });
        const filename = `perma-design-kit-backup-${new Date().toISOString().slice(0, 10)}.json`;
        const handle = await (window as any).showSaveFilePicker({
          suggestedName: filename,
          types: [{ description: 'JSON-Backup', accept: { 'application/json': ['.json'] } }],
        });
        const writable = await handle.createWritable();
        await writable.write(blob);
        await writable.close();
        rememberSyncAt('fsa');
        renderLastBackup();
        setFsaStatus(t('fsaSaved'), 'ok');
      } catch (err) {
        if ((err as Error).name !== 'AbortError') setFsaStatus(t('genericError', { msg: String(err) }), 'err');
      }
    });

    document.getElementById('btn-fsa-read')!.addEventListener('click', async () => {
      try {
        const [handle] = await (window as any).showOpenFilePicker({
          types: [{ description: 'JSON-Backup', accept: { 'application/json': ['.json'] } }],
          multiple: false,
        });
        const file = await handle.getFile();
        const text = await (file as File).text();
        const { plants, polycultures, gardenPlans, settings: restoredSettings } = parseBackup(text);
        if (plants.length === 0) throw new Error(t('fsaInvalidFormat'));
        if (!confirm(t('fsaConfirmRead', {
          plants: plants.length,
          guildPart: polycultures.length ? t('restoreGuildPart', { n: polycultures.length }) : '',
          gardenPlanPart: gardenPlans.length ? t('restoreGardenPlanPart', { n: gardenPlans.length }) : '',
        }))) return;
        await importPlants(plants);
        if (polycultures.length) await importPolycultures(polycultures);
        if (gardenPlans.length) await importGardenPlans(gardenPlans);
        if (restoredSettings) {
          saveSettings(restoredSettings as AppSettings);
          settings = loadSettings();
          renderSources(); renderPrefs();
        }
        await renderStats();
        setFsaStatus(t('restoredCount', { plants: plants.length, guilds: polycultures.length, gardenPlans: gardenPlans.length }), 'ok');
      } catch (err) {
        if ((err as Error).name !== 'AbortError') setFsaStatus(t('genericError', { msg: String(err) }), 'err');
      }
    });
  }

  // ── Sync: GitHub Gist ─────────────────────────────────────────────────────
  const gistTokenInput = document.getElementById('gist-token') as HTMLInputElement;
  const gistIdInput = document.getElementById('gist-id') as HTMLInputElement;
  const gistStatus = document.getElementById('gist-status')!;

  function setGistStatus(msg: string, kind: 'ok' | 'err' | 'idle' = 'idle') {
    gistStatus.textContent = msg;
    gistStatus.className = 'text-xs ' + (
      kind === 'ok'  ? 'text-green-700 dark:text-green-400' :
      kind === 'err' ? 'text-red-700 dark:text-red-400'    :
                       'text-stone-500 dark:text-stone-400');
  }

  function loadGistCreds() {
    try {
      gistTokenInput.value = localStorage.getItem('gist-token') || '';
      gistIdInput.value = localStorage.getItem('gist-id') || '';
    } catch {}
  }

  document.getElementById('btn-gist-save-creds')!.addEventListener('click', () => {
    try {
      localStorage.setItem('gist-token', gistTokenInput.value.trim());
      localStorage.setItem('gist-id', gistIdInput.value.trim());
      setGistStatus(t('gistTokenSaved'), 'ok');
    } catch (err) { setGistStatus(t('genericError', { msg: String(err) }), 'err'); }
  });

  document.getElementById('btn-gist-clear-creds')!.addEventListener('click', () => {
    try {
      localStorage.removeItem('gist-token');
      localStorage.removeItem('gist-id');
      gistTokenInput.value = ''; gistIdInput.value = '';
      setGistStatus(t('gistTokenCleared'), 'idle');
    } catch {}
  });

  document.getElementById('btn-gist-push')!.addEventListener('click', async () => {
    const token = gistTokenInput.value.trim();
    if (!token) { setGistStatus(t('gistTokenMissing'), 'err'); return; }
    setGistStatus(t('gistUploading'));
    try {
      const content = await buildBackupJson();
      const id = gistIdInput.value.trim();
      const res = await fetch(id ? `https://api.github.com/gists/${id}` : 'https://api.github.com/gists', {
        method: id ? 'PATCH' : 'POST',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
          'X-GitHub-Api-Version': '2022-11-28',
        },
        body: JSON.stringify({
          description: 'Perma Design Kit Backup',
          public: false,
          files: { [GIST_FILENAME]: { content } },
        }),
      });
      if (!res.ok) throw new Error(`GitHub API ${res.status}: ${await res.text()}`);
      const result = await res.json();
      if (!id) {
        gistIdInput.value = result.id;
        try { localStorage.setItem('gist-id', result.id); } catch {}
      }
      rememberSyncAt('gist');
      renderLastBackup();
      setGistStatus(t('gistUploaded', { id: String(result.id).slice(0, 8) }), 'ok');
    } catch (err) {
      setGistStatus(t('gistErrorUpload', { msg: (err as Error).message }), 'err');
    }
  });

  document.getElementById('btn-gist-pull')!.addEventListener('click', async () => {
    const token = gistTokenInput.value.trim();
    const id = gistIdInput.value.trim();
    if (!token || !id) { setGistStatus(t('gistTokenIdMissing'), 'err'); return; }
    if (!confirm(t('gistConfirmPull'))) return;
    setGistStatus(t('gistDownloading'));
    try {
      const res = await fetch(`https://api.github.com/gists/${id}`, {
        headers: {
          'Authorization': `Bearer ${token}`,
          'X-GitHub-Api-Version': '2022-11-28',
        },
      });
      if (!res.ok) throw new Error(`GitHub API ${res.status}`);
      const gist = await res.json();
      // Prefer the current filename; fall back to the one earlier versions
      // (Perma Guild Forge) wrote, so existing synced Gists still import.
      const raw: string | undefined = gist.files?.[GIST_FILENAME]?.content ?? gist.files?.[GIST_FILENAME_LEGACY]?.content;
      if (!raw) throw new Error(t('gistFileNotFound', { filename: GIST_FILENAME }));
      const { plants, polycultures, gardenPlans, settings: restoredSettings } = parseBackup(raw);
      if (plants.length === 0) throw new Error(t('invalidBackupFormat'));
      await importPlants(plants);
      if (polycultures.length) await importPolycultures(polycultures);
      if (gardenPlans.length) await importGardenPlans(gardenPlans);
      if (restoredSettings) {
        saveSettings(restoredSettings as AppSettings);
        settings = loadSettings();
        renderSources(); renderPrefs();
      }
      await renderStats();
      setGistStatus(t('restoredCount', { plants: plants.length, guilds: polycultures.length, gardenPlans: gardenPlans.length }), 'ok');
    } catch (err) {
      setGistStatus(t('gistErrorDownload', { msg: (err as Error).message }), 'err');
    }
  });

  // ── Daten: Backup einlesen ──────────────────────────────────────────────
  (document.getElementById('restore-input') as HTMLInputElement | null)?.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    try {
      const text = await file.text();
      const { plants, polycultures, gardenPlans, settings: restoreSettings } = parseBackup(text);
      if (plants.length === 0) {
        throw new Error(t('restoreNoPlants'));
      }
      const guildPart = polycultures.length ? t('restoreGuildPart', { n: polycultures.length }) : '';
      const gardenPlanPart = gardenPlans.length ? t('restoreGardenPlanPart', { n: gardenPlans.length }) : '';
      const settingsPart = restoreSettings ? t('restoreSettingsPart') : '';
      const msg = t('restoreConfirm', { plants: plants.length, guildPart, gardenPlanPart, settingsPart });
      if (!confirm(msg)) { input.value = ''; return; }
      await importPlants(plants);
      if (polycultures.length) await importPolycultures(polycultures);
      if (gardenPlans.length) await importGardenPlans(gardenPlans);
      if (restoreSettings) {
        saveSettings(restoreSettings as AppSettings);
        settings = loadSettings();
        renderSources(); renderPrefs();
      }
      showToast(t('restoreToast', { plants: plants.length, guildPart, gardenPlanPart }));
      await renderStats();
    } catch (err) {
      alert(t('restoreFailed', { msg: err instanceof Error ? err.message : String(err) }));
    } finally {
      input.value = '';
    }
  });

  // ── Daten: Golden Master neu laden ──────────────────────────────────────
  document.getElementById('btn-reload-master')!.addEventListener('click', async () => {
    if (!confirm(t('reloadMasterConfirm'))) return;
    try {
      const res = await fetch('/plants-db.json');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      // plants-db.json is a name index ({latinName, commonName} only, no ids),
      // so normalize each entry into a full record and skip plants that are
      // already in the collection — otherwise every click added duplicates.
      const { plants: master } = parseBackup(await res.text());
      const existing = new Set((await getAllPlants()).map(p => p.latinName.trim().toLowerCase()));
      const plants = master.filter(p => !existing.has(p.latinName.trim().toLowerCase()));
      await importPlants(plants);
      showToast(t('reloadMasterToast', { n: plants.length }));
      await renderStats();
    } catch (err) {
      alert(t('reloadMasterFailed', { msg: err instanceof Error ? err.message : String(err) }));
    }
  });

  // ── Daten: Alles löschen ────────────────────────────────────────────────
  document.getElementById('btn-clear-all')!.addEventListener('click', async () => {
    if (!confirm(t('clearAllConfirm1'))) return;
    if (!confirm(t('clearAllConfirm2'))) return;
    await clearAllPlants();
    try { localStorage.clear(); } catch {}
    location.href = '/';
  });

  // ── Init ────────────────────────────────────────────────────────────────
  settings = loadSettings();
  renderSources();
  renderPrefs();
  renderStats();
  renderLastBackup();
  renderLastSyncInfo();
  loadWebdavCreds();
  loadGistCreds();
</script>
