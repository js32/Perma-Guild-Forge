---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Perma Design Kit" wide>
  <!-- Search hero -->
  <section class="relative mb-8">
    <p class="mb-3 text-center text-xs font-medium uppercase tracking-widest text-stone-400 dark:text-stone-500" data-i18n="searchSubtitle">Pflanzendatenbank durchsuchen</p>
    <div class="relative flex items-center gap-0 overflow-hidden rounded-2xl bg-white dark:bg-stone-800 shadow-md ring-1 ring-stone-200 dark:ring-stone-700 focus-within:ring-2 focus-within:ring-green-400 transition">
      <svg class="ml-4 h-5 w-5 shrink-0 text-stone-400 dark:text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/>
      </svg>
      <input type="text" id="plant-search" data-i18n-placeholder="searchPlaceholder" placeholder="Pflanze suchen — lat. oder dt. Name, z.B. Sambucus nigra"
        class="flex-1 bg-transparent py-3.5 pl-3 pr-2 text-sm text-stone-800 dark:text-stone-100 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:outline-none" autocomplete="off" />
      <button id="btn-search" data-i18n="searchBtn" class="shrink-0 rounded-xl m-1.5 bg-green-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-green-800 active:scale-95">Suchen</button>
    </div>
    <!-- Floating dropdown -->
    <div id="search-results" class="absolute left-0 right-0 top-full z-50 mt-1 hidden max-h-80 overflow-y-auto rounded-xl border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-800 shadow-xl"></div>
  </section>

  <!-- Actions: View-Switch links, Heading mittig, Primär-CTA + Daten-Overflow rechts -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="viewLabel">Ansicht</span>
      <div class="flex overflow-hidden rounded-lg ring-1 ring-stone-200 dark:ring-stone-700">
        <button id="btn-view-grid" data-i18n-title="viewGridTitle" class="bg-green-700 px-3 py-2 text-sm font-medium text-white transition hover:bg-green-800" title="Kachelansicht">⊞</button>
        <button id="btn-view-list" data-i18n-title="viewListTitle" class="bg-stone-100 dark:bg-stone-800 px-3 py-2 text-sm font-medium text-stone-700 dark:text-stone-200 transition hover:bg-stone-200 dark:hover:bg-stone-700" title="Listenansicht">☰</button>
        <button id="btn-view-cards" data-i18n-title="viewCardsTitle" class="bg-stone-100 dark:bg-stone-800 px-3 py-2 text-sm font-medium text-stone-700 dark:text-stone-200 transition hover:bg-stone-200 dark:hover:bg-stone-700" title="Kartenansicht">▤</button>
      </div>
      <h1 class="text-xl font-bold text-stone-800 dark:text-stone-100" data-i18n="headingTiles">Pflanzenkacheln</h1>
    </div>
    <div class="flex items-center gap-2">
      <button id="btn-add" data-i18n="btnAddPlant" class="rounded-lg bg-green-700 px-3.5 py-2 text-sm font-medium text-white shadow transition hover:bg-green-800 active:scale-95">+ Neue Pflanze</button>
      <details id="data-menu" class="relative">
        <summary data-i18n="dataMenuLabel" data-i18n-title="dataMenuTitle" class="cursor-pointer list-none rounded-lg bg-stone-100 dark:bg-stone-800 px-3 py-2 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-200 dark:ring-stone-700 transition hover:bg-stone-200 dark:hover:bg-stone-700" title="Daten importieren / exportieren">
          Daten ⋮
        </summary>
        <div class="absolute right-0 top-full z-40 mt-1 min-w-56 rounded-lg bg-white dark:bg-stone-800 p-1 shadow-lg ring-1 ring-stone-200 dark:ring-stone-700">
          <button id="btn-import" data-i18n="menuImportJson" class="block w-full rounded-md px-3 py-2 text-left text-sm text-stone-700 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-700">Import JSON</button>
          <button id="btn-import-csv" data-i18n="menuImportCsv" class="block w-full rounded-md px-3 py-2 text-left text-sm text-stone-700 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-700">Import CSV</button>
          <button id="btn-csv-template" data-i18n="menuCsvTemplate" class="block w-full rounded-md px-3 py-2 text-left text-sm text-stone-700 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-700">CSV-Vorlage ↓</button>
          <hr class="my-1 border-stone-200 dark:border-stone-700">
          <button id="btn-export" data-i18n="menuExportAll" class="block w-full rounded-md px-3 py-2 text-left text-sm text-stone-700 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-700">Alle exportieren (JSON)</button>
          <hr class="my-1 border-stone-200 dark:border-stone-700">
          <button id="btn-load-samples" data-i18n="menuLoadSamples" class="block w-full rounded-md px-3 py-2 text-left text-sm text-stone-700 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-700">Beispieldaten laden</button>
          <button id="btn-load-samples-crawford" data-i18n="menuLoadSamplesCrawford" class="block w-full rounded-md px-3 py-2 text-left text-sm text-stone-700 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-700">Beispieldaten laden (Crawford)</button>
          <hr class="my-1 border-stone-200 dark:border-stone-700">
          <button id="btn-enrich-all" data-i18n="menuEnrichAll" class="block w-full rounded-md px-3 py-2 text-left text-sm text-stone-700 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-700">Lade alle fehlenden Daten</button>
        </div>
      </details>
    </div>
  </div>
  <!-- Lokal-Filter (chips, AND-Logik) -->
  <div id="filter-bar" class="mb-4 flex flex-wrap items-center gap-2 text-xs">
    <span class="font-medium text-stone-500 dark:text-stone-400" data-i18n="filterLabel">Filter:</span>
    <input type="search" id="filter-text" data-i18n-placeholder="filterTextPlaceholder" placeholder="Name filtern…" class="w-40 rounded-full border-0 bg-stone-100 dark:bg-stone-800 px-2.5 py-1 text-xs text-stone-700 dark:text-stone-200 ring-1 ring-stone-200 dark:ring-stone-700 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:ring-2 focus:ring-green-400 focus:outline-none" />
    <span class="h-4 w-px bg-stone-300 dark:bg-stone-700"></span>

    <!-- Nutzung / Funktionen: multi-select dropdowns (OR within, AND across
         columns) — replace the old single-value eatable/meds/material/
         nitrogenFix chips, which only covered 4 of the 12 Nutzung+Funktionen
         fields. Built with <details>, same no-JS-positioning idiom as the
         table's color legend. -->
    <details class="filter-dropdown relative">
      <summary id="filter-usage-summary" class="cursor-pointer select-none rounded-full bg-stone-100 dark:bg-stone-800 px-2.5 py-1 font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700"><span data-i18n="filterUsageLabel">Nutzung</span></summary>
      <div class="absolute z-10 mt-1 w-44 space-y-1 rounded-lg bg-white dark:bg-stone-800 p-2.5 text-xs shadow-lg ring-1 ring-stone-200 dark:ring-stone-700">
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="eatable" /> <span data-i18n="fld_eatable">Essbarkeit</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="culinaric" /> <span data-i18n="fld_culinaric">Küche</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="meds" /> <span data-i18n="fld_meds">Gesundheit</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="material" /> <span data-i18n="fld_material">Materialien</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="fodder" /> <span data-i18n="fld_fodder">Tierfutter</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="fuel" /> <span data-i18n="fld_fuel">Brennstoff</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="wood" /> <span data-i18n="fld_wood">Nutzholz</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="fiber" /> <span data-i18n="fld_fiber">Fasern</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="ornamental" /> <span data-i18n="fld_ornamental">Ästhetik</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="dyes" /> <span data-i18n="fld_dyes">Farbstoff</span></label>
      </div>
    </details>
    <details class="filter-dropdown relative">
      <summary id="filter-function-summary" class="cursor-pointer select-none rounded-full bg-stone-100 dark:bg-stone-800 px-2.5 py-1 font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700"><span data-i18n="filterFunctionLabel">Funktionen</span></summary>
      <div class="absolute z-10 mt-1 w-44 space-y-1 rounded-lg bg-white dark:bg-stone-800 p-2.5 text-xs shadow-lg ring-1 ring-stone-200 dark:ring-stone-700">
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="nitrogenFix" /> <span data-i18n="fld_nitrogenFix">Stickstoff-Fixierer</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="mineralFix" /> <span data-i18n="fld_mineralFix">Mineraliensammler</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="groundCover" /> <span data-i18n="fld_groundCover">Bodendecker</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="insects" /> <span data-i18n="fld_insects">Insekten</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="pest" /> <span data-i18n="fld_pest">Schädlingsschutz</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="windBreaking" /> <span data-i18n="fld_windBreaking">Windschutz</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="animalProtection" /> <span data-i18n="fld_animalProtection">Kleintiere</span></label>
      </div>
    </details>
    <!-- Blüte/Frucht: two independent multi-select month dropdowns (not one
         combined select) — a plant can be filtered by flowering months and
         fruiting months separately, each OR-within-itself (any selected
         month matches), the two combined via AND like every other column. -->
    <details class="filter-dropdown relative">
      <summary id="filter-flowering-summary" class="cursor-pointer select-none rounded-full bg-stone-100 dark:bg-stone-800 px-2.5 py-1 font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700"><span data-i18n="legendFlowering">Blüte</span></summary>
      <div class="absolute z-10 mt-1 w-36 space-y-1 rounded-lg bg-white dark:bg-stone-800 p-2.5 text-xs shadow-lg ring-1 ring-stone-200 dark:ring-stone-700">
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-flowering-opt accent-amber-500" value="0" /> <span data-i18n="month0">Januar</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-flowering-opt accent-amber-500" value="1" /> <span data-i18n="month1">Februar</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-flowering-opt accent-amber-500" value="2" /> <span data-i18n="month2">März</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-flowering-opt accent-amber-500" value="3" /> <span data-i18n="month3">April</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-flowering-opt accent-amber-500" value="4" /> <span data-i18n="month4">Mai</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-flowering-opt accent-amber-500" value="5" /> <span data-i18n="month5">Juni</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-flowering-opt accent-amber-500" value="6" /> <span data-i18n="month6">Juli</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-flowering-opt accent-amber-500" value="7" /> <span data-i18n="month7">August</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-flowering-opt accent-amber-500" value="8" /> <span data-i18n="month8">September</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-flowering-opt accent-amber-500" value="9" /> <span data-i18n="month9">Oktober</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-flowering-opt accent-amber-500" value="10" /> <span data-i18n="month10">November</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-flowering-opt accent-amber-500" value="11" /> <span data-i18n="month11">Dezember</span></label>
      </div>
    </details>
    <details class="filter-dropdown relative">
      <summary id="filter-fruiting-summary" class="cursor-pointer select-none rounded-full bg-stone-100 dark:bg-stone-800 px-2.5 py-1 font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700"><span data-i18n="legendFruiting">Frucht</span></summary>
      <div class="absolute z-10 mt-1 w-36 space-y-1 rounded-lg bg-white dark:bg-stone-800 p-2.5 text-xs shadow-lg ring-1 ring-stone-200 dark:ring-stone-700">
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-fruiting-opt accent-green-600" value="0" /> <span data-i18n="month0">Januar</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-fruiting-opt accent-green-600" value="1" /> <span data-i18n="month1">Februar</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-fruiting-opt accent-green-600" value="2" /> <span data-i18n="month2">März</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-fruiting-opt accent-green-600" value="3" /> <span data-i18n="month3">April</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-fruiting-opt accent-green-600" value="4" /> <span data-i18n="month4">Mai</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-fruiting-opt accent-green-600" value="5" /> <span data-i18n="month5">Juni</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-fruiting-opt accent-green-600" value="6" /> <span data-i18n="month6">Juli</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-fruiting-opt accent-green-600" value="7" /> <span data-i18n="month7">August</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-fruiting-opt accent-green-600" value="8" /> <span data-i18n="month8">September</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-fruiting-opt accent-green-600" value="9" /> <span data-i18n="month9">Oktober</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-fruiting-opt accent-green-600" value="10" /> <span data-i18n="month10">November</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-fruiting-opt accent-green-600" value="11" /> <span data-i18n="month11">Dezember</span></label>
      </div>
    </details>
    <select id="filter-height" class="rounded-full border-0 bg-stone-100 dark:bg-stone-800 px-2.5 py-1 font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700 focus:ring-2 focus:ring-green-400 focus:outline-none">
      <option value="0" data-i18n="filterHeightAll">H: Alle</option>
      <option value="1">≥ 1m</option>
      <option value="3">≥ 3m</option>
      <option value="5">≥ 5m</option>
      <option value="10">≥ 10m</option>
      <option value="20">≥ 20m</option>
    </select>
    <select id="filter-completeness" class="rounded-full border-0 bg-stone-100 dark:bg-stone-800 px-2.5 py-1 font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700 focus:ring-2 focus:ring-green-400 focus:outline-none">
      <option value="0" data-i18n="filterCompletenessAll">Vollst.: Alle</option>
      <option value="25">≥ 25%</option>
      <option value="50">≥ 50%</option>
      <option value="75">≥ 75%</option>
      <option value="100">100%</option>
    </select>
    <span class="h-4 w-px bg-stone-300 dark:bg-stone-700"></span>
    <details class="filter-dropdown relative">
      <summary id="filter-sun-summary" class="cursor-pointer select-none rounded-full bg-stone-100 dark:bg-stone-800 px-2.5 py-1 font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700"><span data-i18n="thSun">Sonne</span></summary>
      <div class="absolute z-10 mt-1 w-40 space-y-1 rounded-lg bg-white dark:bg-stone-800 p-2.5 text-xs shadow-lg ring-1 ring-stone-200 dark:ring-stone-700">
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-sun-opt accent-amber-500" value="sunFull" /> <span data-i18n="fld_sunFull">Volle Sonne</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-sun-opt accent-amber-500" value="sunMid" /> <span data-i18n="fld_sunMid">Halbschatten</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-sun-opt accent-amber-500" value="sunShadow" /> <span data-i18n="fld_sunShadow">Schatten</span></label>
      </div>
    </details>
    <details class="filter-dropdown relative">
      <summary id="filter-water-summary" class="cursor-pointer select-none rounded-full bg-stone-100 dark:bg-stone-800 px-2.5 py-1 font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700"><span data-i18n="thWater">Wasser</span></summary>
      <div class="absolute z-10 mt-1 w-40 space-y-1 rounded-lg bg-white dark:bg-stone-800 p-2.5 text-xs shadow-lg ring-1 ring-stone-200 dark:ring-stone-700">
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-water-opt accent-blue-500" value="waterDry" /> <span data-i18n="fld_waterDry">Trocken</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-water-opt accent-blue-500" value="waterMid" /> <span data-i18n="fld_waterMid">Mittel</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-water-opt accent-blue-500" value="waterWet" /> <span data-i18n="fld_waterWet">Nass</span></label>
      </div>
    </details>
    <details class="filter-dropdown relative">
      <summary id="filter-growspeed-summary" class="cursor-pointer select-none rounded-full bg-stone-100 dark:bg-stone-800 px-2.5 py-1 font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700"><span data-i18n="thGrowthSpeed">Wuchs</span></summary>
      <div class="absolute z-10 mt-1 w-40 space-y-1 rounded-lg bg-white dark:bg-stone-800 p-2.5 text-xs shadow-lg ring-1 ring-stone-200 dark:ring-stone-700">
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-growspeed-opt accent-green-500" value="growSpeedLow" /> <span data-i18n="fld_growSpeedLow">Langsam</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-growspeed-opt accent-green-500" value="growSpeedMid" /> <span data-i18n="fld_growSpeedMid">Mittel</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-growspeed-opt accent-green-500" value="growSpeedHigh" /> <span data-i18n="fld_growSpeedHigh">Schnell</span></label>
      </div>
    </details>
    <details class="filter-dropdown relative">
      <summary id="filter-layer-summary" class="cursor-pointer select-none rounded-full bg-stone-100 dark:bg-stone-800 px-2.5 py-1 font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700"><span data-i18n="thLayer">Ebene</span></summary>
      <div class="absolute z-10 mt-1 w-40 space-y-1 rounded-lg bg-white dark:bg-stone-800 p-2.5 text-xs shadow-lg ring-1 ring-stone-200 dark:ring-stone-700">
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-layer-opt accent-emerald-600" value="tree" /> <span data-i18n="layerTree">Baum</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-layer-opt accent-emerald-600" value="shrub" /> <span data-i18n="layerShrub">Strauch</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-layer-opt accent-emerald-600" value="herb" /> <span data-i18n="layerHerb">Kraut/Bodendecker</span></label>
      </div>
    </details>
    <!-- Gruppen: options are the group names in use, built by renderGroupFilterOptions() -->
    <details id="filter-groups" class="filter-dropdown relative hidden">
      <summary id="filter-groups-summary" class="cursor-pointer select-none rounded-full bg-stone-100 dark:bg-stone-800 px-2.5 py-1 font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700"><span data-i18n="filterGroupsLabel">Gruppen</span></summary>
      <div id="filter-groups-options" class="absolute z-10 mt-1 max-h-72 w-48 space-y-1 overflow-y-auto rounded-lg bg-white dark:bg-stone-800 p-2.5 text-xs shadow-lg ring-1 ring-stone-200 dark:ring-stone-700"></div>
    </details>
    <span class="h-4 w-px bg-stone-300 dark:bg-stone-700"></span>
    <button id="btn-filter-clear" data-i18n="filterClear" class="hidden rounded-full bg-stone-200 dark:bg-stone-700 px-2.5 py-1 font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-300 dark:hover:bg-stone-700">Zurücksetzen ×</button>
    <span id="filter-count" class="hidden text-stone-500 dark:text-stone-400"></span>
    <span class="ml-auto flex items-center gap-1.5" id="bulk-print-count">
      <span class="text-stone-500 dark:text-stone-400" data-i18n="printCountAllLabel">Druckanzahl:</span>
      <input type="number" id="bulk-print-count-value" min="0" max="99" value="1" class="w-14 rounded-full border-0 bg-stone-100 dark:bg-stone-800 px-2 py-1 text-xs text-stone-700 dark:text-stone-200 ring-1 ring-stone-200 dark:ring-stone-700 focus:ring-2 focus:ring-green-500 focus:outline-none" />
      <button id="btn-bulk-print-count" type="button" class="rounded-full bg-stone-200 dark:bg-stone-700 px-2.5 py-1 font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-300 dark:hover:bg-stone-600"></button>
    </span>
  </div>

  <!-- Table toolbar (list view only) -->
  <div id="table-toolbar" style="display:none" class="mb-4 flex items-center gap-2">
