    <select id="sort-field-select" class="rounded-lg border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2 py-1.5 text-sm shadow-sm focus:border-green-500 focus:outline-none">
      <option value="commonName" data-i18n="sortByNameAz">Name (A-Z)</option>
      <option value="latinName" data-i18n="thLatin">Lateinisch</option>
      <option value="heightM" data-i18n="thHeightShort">H</option>
      <option value="widthM" data-i18n="thWidthShort">B</option>
      <option value="flowerMonth" data-i18n="sortByFlowerMonth">Blühmonat</option>
      <option value="fruitMonth" data-i18n="sortByFruitMonth">Erntemonat</option>
      <option value="growSpeed" data-i18n="thGrowthSpeed">Wuchs</option>
      <option value="layer" data-i18n="thLayer">Ebene</option>
      <option value="completeness" data-i18n="thCompleteness">Vollst.</option>
      <option value="groups" data-i18n="thGroups">Gruppen</option>
    </select>
    <button id="btn-sort-dir" type="button" data-i18n-title="sortDirTitle" title="Sortierrichtung umkehren" class="rounded-lg bg-stone-100 dark:bg-stone-800 px-2.5 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700 transition hover:bg-stone-200 dark:hover:bg-stone-700">↑</button>
  </div>

  <!-- Cards toolbar (own row, no layout shift in button bar) -->
  <div id="cards-toolbar" style="display:none" class="mb-4 flex items-center gap-2">
    <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="cardOutputLayoutLabel">Ausgabe-Layout</span>
    <select id="card-type-select" class="rounded-lg border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2 py-1.5 text-sm shadow-sm focus:border-green-500 focus:outline-none">
      <option value="poly" data-i18n="cardTypePoly">Pflanzenkarten</option>
      <option value="stripe" data-i18n="cardTypeStripe">Streifenkarten</option>
      <option value="baumscheibe" data-i18n="cardTypeBaumscheibe">Baumscheibe</option>
    </select>
    <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="cardOutputFormatLabel">Ausgabeformat</span>
    <details class="relative">
      <summary class="cursor-pointer list-none rounded-lg bg-stone-100 dark:bg-stone-800 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-200 dark:ring-stone-700 transition hover:bg-stone-200 dark:hover:bg-stone-700" data-i18n="cardOutputMenuLabel">PDF ⋮</summary>
      <div class="absolute left-0 top-full z-40 mt-1 min-w-64 space-y-2 rounded-lg bg-white dark:bg-stone-800 p-2 shadow-lg ring-1 ring-stone-200 dark:ring-stone-700">
        <button id="btn-pdf-all" data-i18n="pdfAllBtn" class="block w-full rounded-md bg-green-700 px-3 py-1.5 text-left text-sm font-medium text-white shadow transition hover:bg-green-800">PDF ↓</button>
        <button id="btn-pdf-sheet" data-i18n="pdfSheetBtn" data-i18n-title="pdfSheetTitle" title="6 Baumscheiben je 9cm Durchmesser auf einer A4-Seite, kompakt zum Ausschneiden" class="hidden block w-full rounded-md bg-stone-100 dark:bg-stone-700 px-3 py-1.5 text-left text-sm font-medium text-stone-700 dark:text-stone-200 shadow-sm ring-1 ring-stone-200 dark:ring-stone-600 transition hover:bg-stone-200 dark:hover:bg-stone-600">PDF (6/Seite, 9cm)</button>
        <span id="scaled-pdf-group" class="hidden flex flex-wrap items-center gap-1.5 rounded-md bg-stone-100 dark:bg-stone-700 px-2 py-1.5 text-sm text-stone-700 dark:text-stone-200 shadow-sm ring-1 ring-stone-200 dark:ring-stone-600">
          <button id="btn-pdf-scaled" data-i18n="pdfScaledBtn" data-i18n-title="pdfScaledTitle" title="Baumscheiben im Maßstab (Kronenbreite der Pflanze), platzsparend auf Papier verteilt" class="rounded-md bg-green-700 px-2.5 py-1 text-sm font-medium text-white hover:bg-green-800">PDF (Maßstab)</button>
          <span data-i18n="scaleLabel">Maßstab</span>
          <span>1:</span>
          <input type="number" id="scaled-denominator" min="1" max="10000" value="50" class="w-16 rounded-md border-0 bg-white dark:bg-stone-900 px-1.5 py-0.5 text-sm ring-1 ring-stone-300 dark:ring-stone-600" />
          <select id="scaled-paper" class="rounded-md border-0 bg-white dark:bg-stone-900 px-1.5 py-0.5 text-sm ring-1 ring-stone-300 dark:ring-stone-600"><option>A4</option><option>A3</option><option>A2</option></select>
          <span data-i18n="scaledMinSizeLabel" data-i18n-title="scaledMinSizeTitle" title="Pflanzen, deren Karte bei diesem Maßstab kleiner ausfallen würde, werden nicht gedruckt">Min. Größe (cm)</span>
          <input type="number" id="scaled-min-size" min="0" max="100" step="0.5" value="0" class="w-16 rounded-md border-0 bg-white dark:bg-stone-900 px-1.5 py-0.5 text-sm ring-1 ring-stone-300 dark:ring-stone-600" />
        </span>
      </div>
    </details>
  </div>

  <!-- Bulk bar (hidden until items selected in list view) -->
  <div id="bulk-bar" style="display:none" class="mb-4 flex flex-wrap items-center gap-2 rounded-xl bg-stone-100 dark:bg-stone-800 px-4 py-2.5 text-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <span id="bulk-count" class="font-medium text-stone-700 dark:text-stone-200">0 ausgewählt</span>
    <button id="btn-select-all" data-i18n="bulkSelectAll" class="rounded-lg bg-white dark:bg-stone-800 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-50 dark:hover:bg-stone-800">Alle</button>
    <button id="btn-deselect" data-i18n="bulkDeselect" class="rounded-lg bg-white dark:bg-stone-800 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 ring-1 ring-stone-300 dark:ring-stone-600 hover:bg-stone-50 dark:hover:bg-stone-800">Abwählen</button>
    <span class="h-4 w-px bg-stone-300"></span>
    <button id="btn-bulk-enrich" data-i18n="bulkEnrich" class="rounded-lg bg-blue-100 dark:bg-blue-900/40 px-3 py-1.5 text-xs font-medium text-blue-700 dark:text-blue-300 hover:bg-blue-200 dark:hover:bg-blue-900/60">Ergänzen</button>
    <button id="btn-bulk-delete" data-i18n="bulkDelete" class="rounded-lg bg-red-100 dark:bg-red-900/40 px-3 py-1.5 text-xs font-medium text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900/60">Löschen</button>
    <button id="btn-bulk-json" data-i18n="bulkJson" class="rounded-lg bg-stone-200 dark:bg-stone-700 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 hover:bg-stone-300 dark:hover:bg-stone-700">JSON</button>
    <button id="btn-bulk-csv" data-i18n="bulkCsv" class="rounded-lg bg-stone-200 dark:bg-stone-700 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 hover:bg-stone-300 dark:hover:bg-stone-700">CSV</button>
    <button id="btn-bulk-pdf" data-i18n="bulkPdf" class="rounded-lg bg-stone-200 dark:bg-stone-700 px-3 py-1.5 text-xs font-medium text-stone-700 dark:text-stone-200 hover:bg-stone-300 dark:hover:bg-stone-700">PDF</button>
  </div>

  <!-- Plant list -->
  <div id="plant-list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" style="min-height:200px"></div>

  <!-- Edit dialog -->
  <dialog id="plant-dialog" class="m-auto w-full max-w-2xl rounded-2xl bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-100 p-0 shadow-2xl backdrop:bg-black/40">
    <form id="plant-form" method="dialog" class="max-h-[85vh] overflow-y-auto p-6">
      <h2 id="dialog-title" data-i18n="dialogTitleEdit" class="mb-4 text-lg font-bold text-stone-800 dark:text-stone-100">Pflanze bearbeiten</h2>
      <input type="hidden" id="f-id" />

      <div class="space-y-4">
        <!-- Grunddaten -->
        <fieldset class="rounded-lg border border-stone-200 dark:border-stone-700 p-4">
          <legend class="px-2 text-sm font-semibold text-green-800 dark:text-green-300" data-i18n="fieldsetBasics">Grunddaten</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block"><span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-field="latinName" data-i18n="fieldLatinName">Lateinischer Name</span>
              <input type="text" id="f-latinName" required class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none" /></label>
            <label class="block"><span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-field="commonName" data-i18n="fieldCommonName">Deutscher Name</span>
              <input type="text" id="f-commonName" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none" /></label>
            <label class="block"><span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-field="commonNameEn" data-i18n="fieldCommonNameEn">Englischer Name</span>
              <input type="text" id="f-commonNameEn" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none" /></label>
            <label class="block"><span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-field="varietyName" data-i18n="fieldVarietyName">Sortenname (selbstgewählt)</span>
              <input type="text" id="f-varietyName" data-i18n-placeholder="varietyNamePlaceholder" placeholder="z.B. Black Krim" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none" /></label>
            <label class="block"><span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-field="heightM" data-i18n="fieldHeightM">Höhe (m)</span>
              <input type="number" id="f-heightM" step="0.1" min="0" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none" /></label>
            <label class="block"><span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-field="widthM" data-i18n="fieldWidthM">Breite (m)</span>
              <input type="number" id="f-widthM" step="0.1" min="0" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none" /></label>
            <label class="block"><span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-field="climateZone" data-i18n="fieldClimateZone">Klimazone</span>
              <input type="text" id="f-climateZone" data-i18n-placeholder="climateZonePlaceholder" placeholder="z.B. 5-9" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none" /></label>
            <label class="block sm:col-span-2"><span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-field="imageCredit" data-i18n="fieldImageCredit">Bildnachweis (Urheber · Lizenz · Quelle)</span>
              <input type="text" id="f-imageCredit" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none" /></label>
            <label class="block"><span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-field="imageUrl" data-i18n="fieldImageUrl">Bild-URL</span>
              <input type="url" id="f-imageUrl" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none" /></label>
            <label class="block sm:col-span-2"><span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-field="notes" data-i18n="fieldNotes">Notizen</span>
              <textarea id="f-notes" rows="2" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none"></textarea></label>
            <label class="block sm:col-span-2"><span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-field="groups" data-i18n="fieldGroups">Gruppen (kommagetrennt)</span>
              <input type="text" id="f-groups" data-i18n-placeholder="fieldGroupsPlaceholder" placeholder="z.B. Vorgarten, Waldgarten Nord" class="mt-0.5 block w-full rounded-md border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-sm shadow-inner focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none" /></label>
          </div>
        </fieldset>

        <!-- Nutzung -->
        <fieldset class="rounded-lg border border-stone-200 dark:border-stone-700 p-4">
          <legend class="px-2 text-sm font-semibold text-green-800 dark:text-green-300" data-i18n="fieldsetUsage">Nutzung</legend>
          <div class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm">
            <label class="inline-flex items-center gap-1.5" data-field="eatable"><input type="checkbox" id="f-eatable" class="accent-green-600" /> <span data-i18n="fld_eatable">Essbarkeit</span></label>
            <label class="inline-flex items-center gap-1" data-field="eatableScore"><span class="text-stone-400 dark:text-stone-500" data-i18n="lblScore">Score</span><input type="number" id="f-eatableScore" min="0" max="5" class="w-12 rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-1.5 py-0.5 text-xs" /></label>
            <label class="inline-flex items-center gap-1.5" data-field="meds"><input type="checkbox" id="f-meds" class="accent-green-600" /> <span data-i18n="fld_meds">Gesundheit</span></label>
            <label class="inline-flex items-center gap-1" data-field="medsScore"><span class="text-stone-400 dark:text-stone-500" data-i18n="lblScore">Score</span><input type="number" id="f-medsScore" min="0" max="5" class="w-12 rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-1.5 py-0.5 text-xs" /></label>
            <label class="inline-flex items-center gap-1.5" data-field="culinaric"><input type="checkbox" id="f-culinaric" class="accent-green-600" /> <span data-i18n="fld_culinaric">Küche</span></label>
          </div>
          <div class="mt-1.5 flex flex-wrap gap-x-5 gap-y-1.5 text-sm">
            <label class="inline-flex items-center gap-1.5" data-field="fuel"><input type="checkbox" id="f-fuel" class="accent-green-600" /> <span data-i18n="fld_fuel">Brennstoff</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="wood"><input type="checkbox" id="f-wood" class="accent-green-600" /> <span data-i18n="fld_wood">Nutzholz</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="material"><input type="checkbox" id="f-material" class="accent-green-600" /> <span data-i18n="fld_material">Materialien</span></label>
            <label class="inline-flex items-center gap-1" data-field="materialScore"><span class="text-stone-400 dark:text-stone-500" data-i18n="lblScore">Score</span><input type="number" id="f-materialScore" min="0" max="5" class="w-12 rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-800 px-1.5 py-0.5 text-xs" /></label>
          </div>
          <div class="mt-1.5 flex flex-wrap gap-x-5 gap-y-1.5 text-sm">
            <label class="inline-flex items-center gap-1.5" data-field="fodder"><input type="checkbox" id="f-fodder" class="accent-green-600" /> <span data-i18n="fld_fodder">Tierfutter</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="fiber"><input type="checkbox" id="f-fiber" class="accent-green-600" /> <span data-i18n="fld_fiber">Fasern</span></label>
          </div>
          <div class="mt-1.5 flex flex-wrap gap-x-5 gap-y-1.5 text-sm">
            <label class="inline-flex items-center gap-1.5" data-field="ornamental"><input type="checkbox" id="f-ornamental" class="accent-green-600" /> <span data-i18n="fld_ornamental">Ästhetik</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="dyes"><input type="checkbox" id="f-dyes" class="accent-green-600" /> <span data-i18n="fld_dyes">Farbstoff</span></label>
          </div>
        </fieldset>

        <!-- Funktionen -->
        <fieldset class="rounded-lg border border-stone-200 dark:border-stone-700 p-4">
          <legend class="px-2 text-sm font-semibold text-green-800 dark:text-green-300" data-i18n="fieldsetEcosystem">Funktionen</legend>
          <div class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm">
            <label class="inline-flex items-center gap-1.5" data-field="nitrogenFix"><input type="checkbox" id="f-nitrogenFix" class="accent-green-600" /> <span data-i18n="fld_nitrogenFix">Stickstoff-Fixierer</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="mineralFix"><input type="checkbox" id="f-mineralFix" class="accent-green-600" /> <span data-i18n="fld_mineralFix">Mineraliensammler</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="groundCover"><input type="checkbox" id="f-groundCover" class="accent-green-600" /> <span data-i18n="fld_groundCover">Bodendecker</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="insects"><input type="checkbox" id="f-insects" class="accent-green-600" /> <span data-i18n="fld_insects">Insekten</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="pest"><input type="checkbox" id="f-pest" class="accent-green-600" /> <span data-i18n="fld_pest">Schädlingsschutz</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="animalProtection"><input type="checkbox" id="f-animalProtection" class="accent-green-600" /> <span data-i18n="fld_animalProtection">Kleintiere</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="windBreaking"><input type="checkbox" id="f-windBreaking" class="accent-green-600" /> <span data-i18n="fld_windBreaking">Windschutz</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="windBreakingOnSea"><input type="checkbox" id="f-windBreakingOnSea" class="accent-green-600" /> <span data-i18n="fld_windBreakingOnSea">Wind (See)</span></label>
          </div>
        </fieldset>

        <!-- Sonne + Wasser + Wachstum -->
        <div class="grid gap-4 sm:grid-cols-3">
          <fieldset class="rounded-lg border border-stone-200 dark:border-stone-700 p-3">
            <legend class="px-2 text-xs font-semibold text-green-800 dark:text-green-300" data-i18n="fieldsetSun">Sonne</legend>
            <div class="flex flex-col gap-1 text-sm">
              <label class="inline-flex items-center gap-1.5" data-field="sunFull"><input type="checkbox" id="f-sunFull" class="accent-amber-500" /> <span data-i18n="fld_sunFull">Volle Sonne</span></label>
              <label class="inline-flex items-center gap-1.5" data-field="sunMid"><input type="checkbox" id="f-sunMid" class="accent-amber-500" /> <span data-i18n="fld_sunMid">Halbschatten</span></label>
              <label class="inline-flex items-center gap-1.5" data-field="sunShadow"><input type="checkbox" id="f-sunShadow" class="accent-amber-500" /> <span data-i18n="fld_sunShadow">Schatten</span></label>
            </div>
          </fieldset>
          <fieldset class="rounded-lg border border-stone-200 dark:border-stone-700 p-3">
            <legend class="px-2 text-xs font-semibold text-green-800 dark:text-green-300" data-i18n="fieldsetWater">Wasser</legend>
            <div class="flex flex-col gap-1 text-sm">
              <label class="inline-flex items-center gap-1.5" data-field="waterDry"><input type="checkbox" id="f-waterDry" class="accent-blue-500" /> <span data-i18n="fld_waterDry">Trocken</span></label>
              <label class="inline-flex items-center gap-1.5" data-field="waterMid"><input type="checkbox" id="f-waterMid" class="accent-blue-500" /> <span data-i18n="fld_waterMid">Mittel</span></label>
              <label class="inline-flex items-center gap-1.5" data-field="waterWet"><input type="checkbox" id="f-waterWet" class="accent-blue-500" /> <span data-i18n="fld_waterWet">Nass</span></label>
            </div>
          </fieldset>
          <fieldset class="rounded-lg border border-stone-200 dark:border-stone-700 p-3">
            <legend class="px-2 text-xs font-semibold text-green-800 dark:text-green-300" data-i18n="fieldsetGrowth">Wachstum</legend>
            <div class="flex flex-col gap-1 text-sm">
              <label class="inline-flex items-center gap-1.5" data-field="growSpeedLow"><input type="checkbox" id="f-growSpeedLow" class="accent-green-600" /> <span data-i18n="fld_growSpeedLow">Langsam</span></label>
              <label class="inline-flex items-center gap-1.5" data-field="growSpeedMid"><input type="checkbox" id="f-growSpeedMid" class="accent-green-600" /> <span data-i18n="fld_growSpeedMid">Mittel</span></label>
              <label class="inline-flex items-center gap-1.5" data-field="growSpeedHigh"><input type="checkbox" id="f-growSpeedHigh" class="accent-green-600" /> <span data-i18n="fld_growSpeedHigh">Schnell</span></label>
            </div>
          </fieldset>
        </div>

        <!-- pH -->
        <fieldset class="rounded-lg border border-stone-200 dark:border-stone-700 p-4">
          <legend class="px-2 text-sm font-semibold text-green-800 dark:text-green-300" data-i18n="fieldsetPh">Boden pH</legend>
          <div class="flex flex-wrap gap-x-4 gap-y-1.5 text-sm">
            <label class="inline-flex items-center gap-1.5" data-field="phVeryAcid"><input type="checkbox" id="f-phVeryAcid" class="accent-red-500" /> <span data-i18n="fld_phVeryAcid">Sehr sauer</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="phAcid"><input type="checkbox" id="f-phAcid" class="accent-yellow-500" /> <span data-i18n="fld_phAcid">Sauer</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="phNeutral"><input type="checkbox" id="f-phNeutral" class="accent-green-500" /> <span data-i18n="fld_phNeutral">Neutral</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="phAlkaline"><input type="checkbox" id="f-phAlkaline" class="accent-teal-500" /> <span data-i18n="fld_phAlkaline">Alkalisch</span></label>
            <label class="inline-flex items-center gap-1.5" data-field="phVeryAlkaline"><input type="checkbox" id="f-phVeryAlkaline" class="accent-blue-500" /> <span data-i18n="fld_phVeryAlkaline">Sehr alk.</span></label>
          </div>
        </fieldset>

        <!-- Monate -->
        <div class="grid gap-4 sm:grid-cols-2">
          <fieldset class="rounded-lg border border-stone-200 dark:border-stone-700 p-3">
            <legend class="px-2 text-xs font-semibold text-red-700 dark:text-red-300" data-field="fruitMonths" data-i18n="fieldFruitMonths">Fruchtmonate</legend>
            <div class="grid grid-cols-6 gap-1 text-xs">
              <label class="flex items-center gap-1"><input type="checkbox" id="f-fruit-0" class="accent-red-500" /><span data-i18n="monthJan">Jan</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-fruit-1" class="accent-red-500" /><span data-i18n="monthFeb">Feb</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-fruit-2" class="accent-red-500" /><span data-i18n="monthMar">Mär</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-fruit-3" class="accent-red-500" /><span data-i18n="monthApr">Apr</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-fruit-4" class="accent-red-500" /><span data-i18n="monthMay">Mai</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-fruit-5" class="accent-red-500" /><span data-i18n="monthJun">Jun</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-fruit-6" class="accent-red-500" /><span data-i18n="monthJul">Jul</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-fruit-7" class="accent-red-500" /><span data-i18n="monthAug">Aug</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-fruit-8" class="accent-red-500" /><span data-i18n="monthSep">Sep</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-fruit-9" class="accent-red-500" /><span data-i18n="monthOct">Okt</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-fruit-10" class="accent-red-500" /><span data-i18n="monthNov">Nov</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-fruit-11" class="accent-red-500" /><span data-i18n="monthDec">Dez</span></label>
            </div>
          </fieldset>
          <fieldset class="rounded-lg border border-stone-200 dark:border-stone-700 p-3">
            <legend class="px-2 text-xs font-semibold text-pink-700 dark:text-pink-300" data-field="flowerMonths" data-i18n="fieldFlowerMonths">Blütemonate</legend>
            <div class="grid grid-cols-6 gap-1 text-xs">
              <label class="flex items-center gap-1"><input type="checkbox" id="f-flower-0" class="accent-pink-500" /><span data-i18n="monthJan">Jan</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-flower-1" class="accent-pink-500" /><span data-i18n="monthFeb">Feb</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-flower-2" class="accent-pink-500" /><span data-i18n="monthMar">Mär</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-flower-3" class="accent-pink-500" /><span data-i18n="monthApr">Apr</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-flower-4" class="accent-pink-500" /><span data-i18n="monthMay">Mai</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-flower-5" class="accent-pink-500" /><span data-i18n="monthJun">Jun</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-flower-6" class="accent-pink-500" /><span data-i18n="monthJul">Jul</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-flower-7" class="accent-pink-500" /><span data-i18n="monthAug">Aug</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-flower-8" class="accent-pink-500" /><span data-i18n="monthSep">Sep</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-flower-9" class="accent-pink-500" /><span data-i18n="monthOct">Okt</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-flower-10" class="accent-pink-500" /><span data-i18n="monthNov">Nov</span></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="f-flower-11" class="accent-pink-500" /><span data-i18n="monthDec">Dez</span></label>
            </div>
          </fieldset>
        </div>
      </div>

      <div class="mt-5 flex justify-end gap-2">
        <button type="button" id="btn-cancel" data-i18n="btnCancel" class="rounded-lg px-4 py-2 text-sm font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-300 dark:ring-stone-600 transition hover:bg-stone-100 dark:hover:bg-stone-700">Abbrechen</button>
        <button type="submit" data-i18n="btnSave" class="rounded-lg bg-green-700 px-5 py-2 text-sm font-medium text-white shadow transition hover:bg-green-800 active:scale-95">Speichern</button>
      </div>
    </form>
  </dialog>

  <input type="file" id="file-import" accept=".json" class="hidden" />
  <input type="file" id="file-import-csv" accept=".csv,.txt" class="hidden" />
</Layout>

<script>
  import { getAllPlants, savePlant, deletePlant, importPlants } from '../lib/db';
  import { displayName } from '../lib/plant-name';
  import { createEmptyPlant, type PlantData, type DataSource, SOURCE_LABEL, SOURCE_COLOR } from '../lib/types';
  import { samplePlants } from '../lib/sample-data';
  import { crawfordPlants } from '../lib/sample-data-crawford';
  import { importFromCSV, buildCSV, buildCSVTemplate } from '../lib/csv';
  import { parseBackup } from '../lib/sync';
  import { applyFilters, emptyFilters, sortPlants, allGroups, type ListFilters, type SortField } from '../lib/plant-list';
  import { completenessPercent, badgeDefs, plantBadgesHtml, groupPillsHtml, type BadgeDef } from '../lib/plant-detail';
  import { BOOL_FIELD_KEYS } from '../lib/plant-fields';
  import { searchPlants, fetchProxyData, fetchPlantDetails, needsImageCredit } from '../lib/plant-search';
  import { newId } from '../lib/id';
  import { enrichPlant, trackSources, SCORE_FIELDS } from '../lib/enrich';
  import { escapeHtml, withButtonSpinner, loadingPlaceholderHtml, imageCreditOverlayHtml } from '../lib/html';
  import { isSourceEnabled, loadSettings } from '../lib/settings';
  import { deriveLayer, LAYER_STYLE } from '../lib/plant-layer';
  import { exportPolyCardsPDF, exportStripeCardsPDF, exportSingleCardPDF, exportSingleStripeCardPDF, exportBaumscheibePDF, exportBaumscheibesPDF, exportBaumscheibeSheetPDF, exportBaumscheibeScaledPDF, type ScaledPaper } from '../lib/pdf-export';
  import { renderPolyCardHtml, renderStripeCardHtml, printStepperHtml } from '../lib/card-html';
  import { renderBaumscheibeCardHtml } from '../lib/baumscheibe-render';
  import { createT, applyStaticI18n, getLang } from '../lib/i18n/core';
  import { indexDict } from '../lib/i18n/dict-index';
  import { plantDetailDict } from '../lib/i18n/dict-plant-detail';

  const t = createT(indexDict, plantDetailDict);
  applyStaticI18n(indexDict, plantDetailDict);

  const listEl = document.getElementById('plant-list')!;
  const dialog = document.getElementById('plant-dialog') as HTMLDialogElement;
  const form = document.getElementById('plant-form') as HTMLFormElement;
  const fileInput = document.getElementById('file-import') as HTMLInputElement;
  const csvInput = document.getElementById('file-import-csv') as HTMLInputElement;
  const bulkBar = document.getElementById('bulk-bar')!;
  const bulkCountEl = document.getElementById('bulk-count')!;

  const initialPrefs = (() => {
    try { return loadSettings(); } catch { return null; }
  })();
  // ?view=cards|list|grid overrides the saved default (the old /cards page redirects here).
  const viewParam = new URLSearchParams(location.search).get('view');
  let viewMode: 'grid' | 'list' | 'cards' =
    viewParam === 'grid' || viewParam === 'list' || viewParam === 'cards' ? viewParam : initialPrefs?.defaultView ?? 'grid';
  let cardViewMode: 'poly' | 'stripe' | 'baumscheibe' = initialPrefs?.defaultCardVariant ?? 'poly';
  let selectedIds = new Set<string>();
  let editingPlant: PlantData | null = null;
  let cachedPlants: PlantData[] = [];
  let lastCheckedId: string | null = null;
  let sortField: SortField = 'commonName';
  let sortDir: 'asc' | 'desc' = 'asc';

  // Per-column filters and the free-text filter (matching rules live in
  // lib/plant-list.ts), each persisted under its own localStorage key.
  // The free-text filter is separate from the top search bar, which searches
  // external sources to import new plants, not the already-imported list.
  const SET_FILTER_KEYS = {
    usage: 'plant-filter-usage', function: 'plant-filter-function', sun: 'plant-filter-sun',
    water: 'plant-filter-water', growSpeed: 'plant-filter-growspeed', layer: 'plant-filter-layer',
    flowerMonths: 'plant-filter-flowering', fruitMonths: 'plant-filter-fruiting', groups: 'plant-filter-groups',
  } as const;
  type SetFacet = keyof typeof SET_FILTER_KEYS;
  function readPref(key: string): string | null { try { return localStorage.getItem(key); } catch { return null; } }
  function writePref(key: string, value: string) { try { localStorage.setItem(key, value); } catch {} }
  const filters: ListFilters = emptyFilters();
  for (const [facet, key] of Object.entries(SET_FILTER_KEYS) as [SetFacet, string][]) {
    try { const raw = readPref(key); if (raw) filters[facet] = new Set(JSON.parse(raw)); } catch {}
  }
  filters.heightMin = Number(readPref('plant-filter-height')) || 0;
  filters.completenessMin = Number(readPref('plant-filter-completeness')) || 0;
  filters.text = readPref('plant-text-filter') || '';
  function persistFacet(facet: SetFacet) { writePref(SET_FILTER_KEYS[facet], JSON.stringify([...filters[facet]])); }
  function persistScalarFilters() {
    writePref('plant-filter-height', String(filters.heightMin));
    writePref('plant-filter-completeness', String(filters.completenessMin));
    writePref('plant-text-filter', filters.text);
  }

  // One-time migration of the old combined filter-chip selection
  // ('plant-filters') into the per-column facets.
  (function migrateLegacyChipFilters() {
    let legacy: Set<string>;
    try { legacy = new Set(JSON.parse(readPref('plant-filters') || '[]')); } catch { legacy = new Set(); }
    if (legacy.size === 0) return;
    for (const f of ['eatable', 'meds', 'material'] as const) if (legacy.has(f)) filters.usage.add(f);
    if (legacy.has('nitrogenFix')) filters.function.add('nitrogenFix');
    for (const f of ['sunFull', 'sunMid', 'sunShadow'] as const) if (legacy.has(f)) filters.sun.add(f);
    for (const f of ['waterDry', 'waterMid', 'waterWet'] as const) if (legacy.has(f)) filters.water.add(f);
    (['usage', 'function', 'sun', 'water'] as const).forEach(persistFacet);
    try { localStorage.removeItem('plant-filters'); } catch {}
  })();

  const textFields = ['latinName', 'commonName', 'commonNameEn', 'varietyName', 'climateZone', 'imageUrl', 'imageCredit', 'notes'] as const;
  const numberFields = ['heightM', 'widthM', 'eatableScore', 'medsScore', 'materialScore'] as const;
  const boolFields = BOOL_FIELD_KEYS;

  function el(id: string) { return document.getElementById(`f-${id}`) as HTMLInputElement; }

  // ── Source helpers ────────────────────────────────────────────────────────────

  /** Update source badge chips next to each form label with data-field attribute.
   *  Clickable where the source is an external site (matches sourceChipsHtml's
   *  behavior in grid/list view) — links straight to this plant's record. */
  function updateFormBadges(plant: PlantData | null) {
    document.querySelectorAll<HTMLElement>('[data-field]').forEach(fieldEl => {
      const field = fieldEl.dataset.field as keyof PlantData;
      const source = plant?._sources?.[field] as DataSource | undefined;
      fieldEl.querySelector('.src-badge')?.remove();
      if (source && SOURCE_COLOR[source]) {
        const href = plant ? sourceLink(source, plant) : null;
        const badge = document.createElement(href ? 'a' : 'span');
        badge.className = `src-badge ml-1 inline-block rounded px-1 py-px text-[10px] font-semibold leading-none align-middle ${SOURCE_COLOR[source]}${href ? ' hover:underline' : ''}`;
        badge.title = t('formBadgeSource', { source: SOURCE_LABEL[source] }) + (href ? ` — ${t('formBadgeOpenSource', { source: SOURCE_LABEL[source] })}` : '');
        badge.textContent = SOURCE_LABEL[source][0];
        if (href) {
          (badge as HTMLAnchorElement).href = href;
          badge.setAttribute('target', '_blank');
          badge.setAttribute('rel', 'noopener');
          badge.addEventListener('click', (e) => e.stopPropagation());
        }
        fieldEl.appendChild(badge);
      }
    });
  }

  // Outline-only source badge (hollow = provenance, not usage)
  const SOURCE_OUTLINE: Record<DataSource, string> = {
    wikidata: 'border-blue-300 text-blue-500',
    pfaf:     'border-green-300 text-green-600',
    naturadb: 'border-orange-300 text-orange-500',
    manual:   'border-stone-300 dark:border-stone-600 text-stone-500 dark:text-stone-400',
    csv:      'border-purple-300 text-purple-500',
    sample:   'border-teal-300 text-teal-500',
  };
  const SOURCE_SHORT: Record<DataSource, string> = {
    wikidata: 'WD', pfaf: 'PFAF', naturadb: 'NDB', manual: 'M', csv: 'CSV', sample: '~',
  };

  /** Deep-link to this plant's actual record on the given source, when that's possible. */
  function sourceLink(source: DataSource, p: PlantData): string | null {
    if (!p.latinName) return null;
    switch (source) {
      case 'pfaf':
        return `https://pfaf.org/user/Plant.aspx?LatinName=${encodeURIComponent(p.latinName).replace(/%20/g, '+')}`;
      case 'wikidata':
        return `https://www.wikidata.org/w/index.php?search=${encodeURIComponent(p.latinName)}`;
      case 'naturadb':
        return `https://www.naturadb.de/pflanzen/${p.latinName.toLowerCase().replace(/ /g, '-')}/`;
      default:
        return null; // manual/csv/sample aren't external sources
    }
  }

  /** Outline source chips — visually distinct from filled usage badges. Clickable
   *  where the source is an external site, linking straight to this plant's record. */
  function sourceChipsHtml(p: PlantData): string {
    if (!p._sources) return '';
    const sources = [...new Set(Object.values(p._sources))] as DataSource[];
    if (sources.length === 0) return '';
    return sources
      .filter(s => SOURCE_OUTLINE[s])
      .map(s => {
        const cls = `inline-block rounded border px-1.5 py-px text-[10px] font-medium ${SOURCE_OUTLINE[s]}`;
        const title = t('sourceTitle', { source: SOURCE_LABEL[s] });
        const titleLink = t('sourceTitleLink', { source: SOURCE_LABEL[s] });
        const href = sourceLink(s, p);
        return href
          ? `<a href="${escapeHtml(href)}" target="_blank" rel="noopener" class="${cls} hover:underline" title="${escapeHtml(titleLink)}">${SOURCE_SHORT[s]}</a>`
          : `<span class="${cls}" title="${escapeHtml(title)}">${SOURCE_SHORT[s]}</span>`;
      })
      .join(' ');
  }

  // ── Form ─────────────────────────────────────────────────────────────────────

  function fillForm(p: PlantData) {
    el('id').value = p.id;
    for (const f of textFields) el(f).value = (p[f] as string) || '';
    for (const f of numberFields) { const v = p[f] as number | null; el(f).value = v != null ? String(v) : ''; }
    for (const f of boolFields) el(f).checked = p[f] as boolean;
    el('groups').value = (p.groups ?? []).join(', ');
    for (let i = 0; i < 12; i++) { el(`fruit-${i}`).checked = p.fruitMonths[i]; el(`flower-${i}`).checked = p.flowerMonths[i]; }
    updateFormBadges(p);
  }

  function readForm(): PlantData {
    const orig = editingPlant;
    const p = createEmptyPlant();
    p.id = el('id').value || p.id;
    p._sources = orig?._sources ? { ...orig._sources } : {};

    for (const f of textFields) {
      const val = el(f).value;
      (p as any)[f] = val;
      if (orig && val !== ((orig as any)[f] || '')) p._sources[f as keyof PlantData] = 'manual';
    }
    // A changed image URL with an untouched credit would leave the OLD image's
    // attribution on the new one — drop it so it gets re-fetched/re-entered.
    if (orig && p.imageUrl !== (orig.imageUrl || '') && p.imageCredit === (orig.imageCredit || '')) p.imageCredit = '';
    for (const f of numberFields) {
      const raw = el(f).value;
      const val = raw ? parseFloat(raw) : null;
      (p as any)[f] = val;
      if (orig && val !== (orig as any)[f]) p._sources[f as keyof PlantData] = 'manual';
    }
    for (const f of boolFields) {
      const val = el(f).checked;
      (p as any)[f] = val;
      if (orig && val !== (orig as any)[f]) p._sources[f as keyof PlantData] = 'manual';
    }
    p.groups = el('groups').value.split(',').map(s => s.trim()).filter(Boolean);
    if (orig && p.groups.join('\u0000') !== (orig.groups ?? []).join('\u0000')) p._sources['groups'] = 'manual';
    let fruitChanged = false, flowerChanged = false;
    for (let i = 0; i < 12; i++) {
      p.fruitMonths[i] = el(`fruit-${i}`).checked;
      p.flowerMonths[i] = el(`flower-${i}`).checked;
      if (orig && p.fruitMonths[i] !== orig.fruitMonths[i]) fruitChanged = true;
      if (orig && p.flowerMonths[i] !== orig.flowerMonths[i]) flowerChanged = true;
    }
    if (fruitChanged) p._sources['fruitMonths'] = 'manual';
    if (flowerChanged) p._sources['flowerMonths'] = 'manual';

    // New plant: mark all non-empty fields as manually entered
    if (!orig) {
      for (const f of textFields) { if ((p as any)[f]) p._sources[f as keyof PlantData] = 'manual'; }
      for (const f of numberFields) { if ((p as any)[f] != null) p._sources[f as keyof PlantData] = 'manual'; }
      for (const f of boolFields) { if ((p as any)[f]) p._sources[f as keyof PlantData] = 'manual'; }
      if (p.groups.length > 0) p._sources['groups'] = 'manual';
      if (p.fruitMonths.some(Boolean)) p._sources['fruitMonths'] = 'manual';
      if (p.flowerMonths.some(Boolean)) p._sources['flowerMonths'] = 'manual';
    }

    return p;
  }

  // ── Plant card badges & color system ─────────────────────────────────────────

  // Badge/dot definitions per column, derived from the central field table
  // (lib/plant-fields.ts) — colors, order and labels live there.
  const USAGE_BADGES = badgeDefs('usage', t);
  const FUNCTION_BADGES = badgeDefs('function', t);
  const SUN_BADGES = badgeDefs('sun', t);
  const WATER_BADGES = badgeDefs('water', t);
  const GROWTH_BADGES = badgeDefs('growth', t);

  function badges(p: PlantData): string {
    return plantBadgesHtml(p, t);
  }

  /** Compact colored dots for one badge group, each with a real tooltip
   *  (unlike the old combined useDots, which had title="" — no tooltip at all). */
  function dotGroup(p: PlantData, group: BadgeDef[]): string {
    return group
      .filter(([k]) => p[k])
      .map(([,,dot,l]) => `<span class="inline-block h-2 w-2 rounded-full" style="background-color:${dot}" title="${escapeHtml(l)}"></span>`)
      .join('');
  }

  /** Single dot for the derived Baum/Strauch/Kraut layer — unlike the other
   *  dot groups this is always exactly one value per plant (deriveLayer()
   *  never returns more than one), so no filter/OR logic per dot needed,
   *  just LAYER_STYLE's own color reused for visual consistency with the
   *  Gartenplan's layer legend. */
  function layerDot(p: PlantData): string {
    const layer = deriveLayer(p);
    const label = layer === 'tree' ? t('layerTree') : layer === 'shrub' ? t('layerShrub') : t('layerHerb');
    return `<span class="inline-block h-2 w-2 rounded-full" style="background-color:${LAYER_STYLE[layer].fill}" title="${escapeHtml(label)}"></span>`;
  }

  /** Color-key for the table's dot columns — what each dot color/position
   *  means, since the table itself only has room for colored dots, not labels. */
  function legendHtml(): string {
    const chip = (colorHex: string, label: string) =>
      `<span class="inline-flex items-center gap-1"><span class="inline-block h-2 w-2 rounded-full" style="background-color:${colorHex}"></span>${escapeHtml(label)}</span>`;
    const usageChips = USAGE_BADGES.map(([,,dot,l]) => chip(dot, l)).join(' ');
    const functionChips = FUNCTION_BADGES.map(([,,dot,l]) => chip(dot, l)).join(' ');
    const sunChips = SUN_BADGES.map(([,,dot,l]) => chip(dot, l)).join(' ');
    const waterChips = WATER_BADGES.map(([,,dot,l]) => chip(dot, l)).join(' ');
    const growthChips = GROWTH_BADGES.map(([,,dot,l]) => chip(dot, l)).join(' ');
    const layerChips = [
      chip(LAYER_STYLE.tree.fill, t('layerTree')),
      chip(LAYER_STYLE.shrub.fill, t('layerShrub')),
      chip(LAYER_STYLE.herb.fill, t('layerHerb')),
    ].join(' ');
    return `
      <details id="color-legend" open class="mx-3 mb-2 sm:mx-0 rounded-lg bg-stone-50 dark:bg-stone-900 px-3 py-1.5 text-xs text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700">
        <summary class="cursor-pointer select-none font-medium text-stone-500 dark:text-stone-400">${escapeHtml(t('legendToggle'))}</summary>
        <div class="mt-2 space-y-1.5">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1"><strong class="text-stone-500 dark:text-stone-400">${escapeHtml(t('legendUsageHeading'))}</strong>${usageChips}</div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1"><strong class="text-stone-500 dark:text-stone-400">${escapeHtml(t('legendFunctionsHeading'))}</strong>${functionChips}</div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1"><strong class="text-stone-500 dark:text-stone-400">${escapeHtml(t('thSun'))}:</strong>${sunChips}</div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1"><strong class="text-stone-500 dark:text-stone-400">${escapeHtml(t('thWater'))}:</strong>${waterChips}</div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1"><strong class="text-stone-500 dark:text-stone-400">${escapeHtml(t('thGrowthSpeed'))}:</strong>${growthChips}</div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1"><strong class="text-stone-500 dark:text-stone-400">${escapeHtml(t('thLayer'))}:</strong>${layerChips}</div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <strong class="text-stone-500 dark:text-stone-400">${escapeHtml(t('legendPhenologyHeading'))}</strong>
            ${chip('#fcd34d', t('legendFlowering'))}
            ${chip('#22c55e', t('legendFruiting'))}
          </div>
        </div>
      </details>`;
  }

  /** Compact 12-tick bar for fruitMonths/flowerMonths — a condensed version of
   *  the full month grid on /kalender, sized for a table cell. */
  function phenologyBar(p: PlantData): string {
    const flower = p.flowerMonths ?? [];
    const fruit = p.fruitMonths ?? [];
    if (!flower.some(Boolean) && !fruit.some(Boolean)) return '<span class="text-stone-300 dark:text-stone-600">—</span>';
    const ticks = Array.from({ length: 12 }, (_, i) => {
      const f = !!flower[i], r = !!fruit[i];
      const cls = f && r ? 'bg-emerald-400 dark:bg-emerald-500'
        : f ? 'bg-amber-300 dark:bg-amber-500'
        : r ? 'bg-green-500 dark:bg-green-400'
        : 'bg-stone-100 dark:bg-stone-800';
      return `<span class="h-2.5 w-1 rounded-sm ${cls}"></span>`;
    }).join('');
    const title = t('phenologyTitle', { count: flower.filter(Boolean).length, countFruit: fruit.filter(Boolean).length });
    return `<div class="flex gap-px" title="${escapeHtml(title)}">${ticks}</div>`;
  }

  /** Colored left-border accent based on primary use */
  function accentColor(p: PlantData): string {
    if (p.eatable || p.culinaric) return 'bg-amber-400';
    if (p.meds) return 'bg-rose-400';
    if (p.nitrogenFix) return 'bg-lime-500';
    if (p.groundCover) return 'bg-teal-400';
    if (p.insects) return 'bg-cyan-400';
    return 'bg-stone-200 dark:bg-stone-700';
  }


  // ── Bulk bar ──────────────────────────────────────────────────────────────────

  function updateBulkBar() {
    const n = selectedIds.size;
    if (n === 0 || viewMode !== 'list') {
      bulkBar.style.display = 'none';
    } else {
      bulkBar.style.display = 'flex';
      bulkCountEl.textContent = t('bulkSelectedCount', { n });
    }
  }

  function updateViewButtons() {
    const btnGrid = document.getElementById('btn-view-grid')!;
    const btnList = document.getElementById('btn-view-list')!;
    const btnCards = document.getElementById('btn-view-cards')!;
    const cardsToolbar = document.getElementById('cards-toolbar')!;
    const tableToolbar = document.getElementById('table-toolbar')!;
    const sortToolbar = document.getElementById('sort-toolbar')!;
    const heading = document.querySelector('h1.text-xl') as HTMLElement | null;
    const activeClass = ['bg-green-700', 'text-white'];
    const inactiveClass = ['bg-stone-100', 'dark:bg-stone-800', 'text-stone-700', 'dark:text-stone-200'];
    [btnGrid, btnList, btnCards].forEach(b => { b.classList.remove(...activeClass); b.classList.add(...inactiveClass); });
    const active = viewMode === 'grid' ? btnGrid : viewMode === 'list' ? btnList : btnCards;
    active.classList.remove(...inactiveClass); active.classList.add(...activeClass);
    cardsToolbar.style.display = viewMode === 'cards' ? 'flex' : 'none';
    tableToolbar.style.display = viewMode === 'list' ? 'flex' : 'none';
    sortToolbar.style.display = viewMode === 'list' ? 'none' : 'flex';
    (document.getElementById('sort-field-select') as HTMLSelectElement).value = sortField;
    document.getElementById('btn-sort-dir')!.textContent = sortDir === 'asc' ? '↑' : '↓';
    if (heading) heading.textContent = viewMode === 'cards' ? t('headingCards') : viewMode === 'list' ? t('headingList') : t('headingTiles');
  }

  // ── Sorting (logic in lib/plant-list.ts) ──────────────────────────────────────

  function thSort(field: typeof sortField, label: string, extraClass = ''): string {
    const active = sortField === field;
    const arrow = active ? (sortDir === 'asc' ? ' ↑' : ' ↓') : ' ↕';
    return `<th class="cursor-pointer select-none px-3 py-2.5 hover:text-stone-800 ${extraClass}" data-sort="${field}">${label}${active ? `<span class="text-green-600">${arrow}</span>` : `<span class="text-stone-300">${arrow}</span>`}</th>`;
  }

  function triggerDownload(content: string, filename: string, type: string) {
    const blob = new Blob([content], { type });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = filename; a.click();
    URL.revokeObjectURL(a.href);
  }

  // ── renderList ────────────────────────────────────────────────────────────────

  async function renderList() {
    cachedPlants = await getAllPlants();


    if (cachedPlants.length === 0) {
      listEl.className = 'grid gap-4 sm:grid-cols-2 lg:grid-cols-3';
      listEl.innerHTML = `
        <div class="col-span-full flex flex-col items-center py-20 text-center">
          <svg class="mb-4 h-16 w-16 text-stone-200" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <polyline points="16,11 20.1,14 16,19.2 9.7,14 16,6.6 24.5,14 16,23.6 16,27"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="16" cy="11" r="1.2" fill="currentColor"/>
          </svg>
          <p class="mb-1 text-base font-semibold text-stone-500 dark:text-stone-400">${escapeHtml(t('emptyStateTitle'))}</p>
          <p class="mb-4 text-sm text-stone-400 dark:text-stone-500">${escapeHtml(t('emptyStateSubtitle'))}</p>
          <button type="button" data-focus-search class="rounded-lg bg-green-700 px-4 py-2 text-sm font-medium text-white shadow transition hover:bg-green-800 active:scale-95">${escapeHtml(t('emptyStateBtn'))}</button>
        </div>`;
      listEl.querySelector('[data-focus-search]')!.addEventListener('click', () => document.getElementById('plant-search')!.focus());
      return;
    }

    renderGroupFilterOptions();
    const filtered = applyFilters(cachedPlants, filters);
    // Sorting applies to all three views — list sorts via clickable table
    // headers, grid/cards via the sort-toolbar dropdown above — both drive
    // the same sortField/sortDir state.
    const displayPlants = sortPlants(filtered, sortField, sortDir);
    syncFilterChips(filtered.length, cachedPlants.length);
    const bulkPrintBtn = document.getElementById('btn-bulk-print-count');
    if (bulkPrintBtn) bulkPrintBtn.textContent = t('printCountAllBtn', { n: filtered.length });

    if (viewMode === 'cards') {
      const isStripe = cardViewMode === 'stripe';
      const isBaumscheibe = cardViewMode === 'baumscheibe';
      document.getElementById('btn-pdf-sheet')!.classList.toggle('hidden', !isBaumscheibe);
      document.getElementById('scaled-pdf-group')!.classList.toggle('hidden', !isBaumscheibe);
      listEl.className = isStripe ? 'flex flex-col items-stretch gap-2' : 'flex flex-wrap justify-center gap-6';
      // Baumscheibe rendering awaits an SVG fetch + per-plant DOM work and can
      // take a visible moment for more than a couple of cards — poly/stripe
      // cards are near-instant, so skip the placeholder there to avoid flicker.
      if (isBaumscheibe) listEl.innerHTML = loadingPlaceholderHtml(t('loadingCards'));
      const cardHtmls = await Promise.all(displayPlants.map(async (p) => {
        if (isBaumscheibe) return renderBaumscheibeCardHtml(p);
        return isStripe ? renderStripeCardHtml(p) : renderPolyCardHtml(p);
      }));
      listEl.innerHTML = displayPlants.map((p, i) => {
        const cardHtml = cardHtmls[i];
        return `
        <div class="group relative overflow-hidden rounded-xl shadow-md ring-1 ring-stone-200 dark:ring-stone-700 transition hover:shadow-lg hover:ring-green-300${(p.printCount ?? 1) === 0 ? ' opacity-60' : ''}" data-id="${p.id}" data-idx="${i}">
          <div class="pointer-events-none${isStripe ? ' overflow-x-auto' : ''}">${cardHtml}</div>
          <div class="relative z-10 flex items-center justify-between bg-white/90 dark:bg-stone-800/90 px-3 py-1.5">
            <span class="text-xs text-stone-400 dark:text-stone-500">${escapeHtml(displayName(p))}</span>
            <div class="flex items-center gap-1.5">
              ${printStepperHtml(p, t)}
              <button class="btn-edit inline-flex items-center gap-1 rounded-md bg-stone-100 dark:bg-stone-800 px-2.5 py-1 text-xs font-medium text-stone-600 dark:text-stone-300 transition hover:bg-blue-100 dark:hover:bg-blue-900/60 hover:text-blue-800 dark:hover:text-blue-200">${escapeHtml(t('btnEditShort'))}</button>
              <button class="btn-pdf-single inline-flex items-center gap-1 rounded-md bg-stone-100 dark:bg-stone-800 px-2.5 py-1 text-xs font-medium text-stone-600 dark:text-stone-300 transition hover:bg-green-100 dark:hover:bg-green-900/60 hover:text-green-800 dark:hover:text-green-200">${escapeHtml(t('btnPdfShort'))}</button>
            </div>
          </div>
        </div>`;
      }).join('');

      listEl.querySelectorAll('.btn-pdf-single').forEach(btn => {
        btn.addEventListener('click', async () => {
          const b = btn as HTMLButtonElement;
          const id = (b.closest('[data-id]') as HTMLElement).dataset.id!;
          const plant = cachedPlants.find(p => p.id === id);
          if (!plant) return;
          await withButtonSpinner(b, async () => {
            try {
              if (cardViewMode === 'baumscheibe') await exportBaumscheibePDF(plant);
              else if (cardViewMode === 'stripe') await exportSingleStripeCardPDF(plant);
              else await exportSingleCardPDF(plant);
            }
            catch (err) { alert(t('alertPdfError', { error: err instanceof Error ? err.message : String(err) })); }
          });
        });
      });

    } else if (viewMode === 'grid') {
      listEl.className = 'grid gap-4 sm:grid-cols-2 lg:grid-cols-3';
      listEl.innerHTML = displayPlants.map(p => {
        const pct = completenessPercent(p);
        const barColor = pct >= 80 ? 'bg-green-400' : pct >= 50 ? 'bg-amber-400' : 'bg-red-300';
        return `
        <div class="group relative flex flex-col overflow-hidden rounded-xl bg-white dark:bg-stone-800 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700 transition hover:shadow-md hover:ring-green-300${(p.printCount ?? 1) === 0 ? ' opacity-60' : ''}" data-id="${p.id}">
          <!-- Accent left border -->
          <div class="absolute left-0 top-0 h-full w-1 ${accentColor(p)}"></div>
          <!-- Image thumbnail -->
          ${p.imageUrl ? `<div data-img-wrapper class="relative h-32 overflow-hidden bg-stone-100 dark:bg-stone-800 pl-1">
            <img src="${escapeHtml(p.imageUrl)}" alt="${escapeHtml(displayName(p))}" class="h-full w-full object-cover" loading="lazy" />
            ${imageCreditOverlayHtml(p.imageCredit)}
          </div>` : ''}
          <!-- Content -->
          <div class="flex-1 pl-4 pr-3 pt-3 pb-1">
            <div class="mb-1 flex items-start justify-between gap-2">
              <div class="min-w-0">
                <h3 class="truncate text-sm font-bold text-stone-800 dark:text-stone-100">${escapeHtml(displayName(p))}${p.varietyName ? ` <span class="font-normal text-stone-500 dark:text-stone-400">(${escapeHtml(p.varietyName)})</span>` : ''}</h3>
                <p class="truncate text-xs italic text-stone-500 dark:text-stone-400">${escapeHtml(p.latinName)}</p>
              </div>
              <div class="flex shrink-0 gap-1 sm:opacity-0 sm:transition sm:group-hover:opacity-100">
                <button class="btn-enrich rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/60" title="${escapeHtml(t('btnEnrichTitle'))}">↻</button>
                <button class="btn-edit rounded-md bg-stone-100 dark:bg-stone-800 px-2 py-1 text-xs font-medium text-stone-600 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700">✎</button>
                <button class="btn-del rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-600 hover:bg-red-100 dark:hover:bg-red-900/60">✕</button>
              </div>
            </div>
            <div class="mb-1.5 flex gap-3 text-xs text-stone-500 dark:text-stone-400">
              ${p.heightM != null ? `<span>↕ ${p.heightM}m</span>` : ''}
              ${p.widthM != null ? `<span>↔ ${p.widthM}m</span>` : ''}
              ${p.climateZone ? `<span>${escapeHtml(t('zoneLabel', { zone: p.climateZone }))}</span>` : ''}
            </div>
            <div class="flex flex-wrap gap-1">${badges(p)}</div>
            ${groupPillsHtml(p, 'mt-1')}
          </div>
          <!-- Footer: completeness bar + source chips -->
          <div class="flex items-center gap-2 border-t border-stone-100 px-4 py-2">
            <div class="h-1.5 w-20 overflow-hidden rounded-full bg-stone-100 dark:bg-stone-800">
              <div class="h-full rounded-full ${barColor}" style="width:${pct}%"></div>
            </div>
            <span class="text-[10px] tabular-nums text-stone-400 dark:text-stone-500">${pct}%</span>
            <span class="flex-1"></span>
            ${printStepperHtml(p, t)}
            ${sourceChipsHtml(p)}
          </div>
        </div>`;
      }).join('');

    } else {
      // List / table view with checkboxes
      listEl.className = 'rounded-xl bg-white dark:bg-stone-800 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700';
      const allSelected = cachedPlants.length > 0 && cachedPlants.every(p => selectedIds.has(p.id));

      // Shared row data builder
      const rowData = displayPlants.map(p => {
        const srcHtml = sourceChipsHtml(p);
        const sel = selectedIds.has(p.id);
        const pct = completenessPercent(p);
        const barColor = pct >= 80 ? 'bg-green-400' : pct >= 50 ? 'bg-amber-400' : 'bg-red-300';
        const usageDots = dotGroup(p, USAGE_BADGES);
        const functionDots = dotGroup(p, FUNCTION_BADGES);
        const sunDots = dotGroup(p, SUN_BADGES);
        const waterDots = dotGroup(p, WATER_BADGES);
        const growthDots = dotGroup(p, GROWTH_BADGES);
        const layerDotHtml = layerDot(p);
        const phenologyHtml = phenologyBar(p);
        const printHtml = printStepperHtml(p, t);
        const off = (p.printCount ?? 1) === 0;
        return { p, srcHtml, sel, pct, barColor, usageDots, functionDots, sunDots, waterDots, growthDots, layerDotHtml, phenologyHtml, printHtml, off };
      });

      const actionBtns = `
        <button class="btn-enrich rounded bg-blue-50 px-1.5 py-0.5 text-xs font-medium text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/60" title="${escapeHtml(t('btnEnrichShort'))}">↻</button>
        <button class="btn-edit rounded bg-stone-100 dark:bg-stone-800 px-1.5 py-0.5 text-xs font-medium text-stone-600 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700">✎</button>
        <button class="btn-del rounded bg-red-50 px-1.5 py-0.5 text-xs font-medium text-red-600 hover:bg-red-100 dark:hover:bg-red-900/60">✕</button>`;

      listEl.innerHTML = `
        ${legendHtml()}

        <!-- Mobile card list (< sm) -->
        <div class="sm:hidden divide-y divide-stone-100">
          ${rowData.map(({ p, srcHtml, sel, pct, barColor, usageDots, functionDots, sunDots, waterDots, growthDots, layerDotHtml, phenologyHtml, printHtml, off }) => `
          <div data-id="${p.id}" class="flex items-start gap-2.5 px-3 py-3 ${sel ? 'bg-green-50 dark:bg-green-900/30' : ''}${off ? ' opacity-60' : ''}">
            <input type="checkbox" class="row-check mt-1 shrink-0 accent-green-600" ${sel ? 'checked' : ''} />
            <div class="w-0.5 self-stretch rounded-full ${accentColor(p)} shrink-0"></div>
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold text-stone-800 dark:text-stone-100">${escapeHtml(displayName(p))}</p>
                  <p class="truncate text-xs italic text-stone-500 dark:text-stone-400">${escapeHtml(p.latinName)}</p>
                  ${groupPillsHtml(p, 'mt-0.5')}
                </div>
                <div class="flex shrink-0 gap-1">${actionBtns}</div>
              </div>
              <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-stone-500 dark:text-stone-400">
                ${p.heightM != null ? `<span>↕ ${p.heightM}m</span>` : ''}
                ${p.widthM != null ? `<span>↔ ${p.widthM}m</span>` : ''}
                ${p.climateZone ? `<span>Zone ${escapeHtml(p.climateZone)}</span>` : ''}
                ${usageDots ? `<span class="flex gap-0.5">${usageDots}</span>` : ''}
                ${functionDots ? `<span class="flex gap-0.5">${functionDots}</span>` : ''}
                ${sunDots ? `<span class="flex gap-0.5">${sunDots}</span>` : ''}
                ${waterDots ? `<span class="flex gap-0.5">${waterDots}</span>` : ''}
                ${growthDots ? `<span class="flex gap-0.5">${growthDots}</span>` : ''}
                <span class="flex gap-0.5">${layerDotHtml}</span>
                ${phenologyHtml}
              </div>
              <div class="mt-1.5 flex flex-wrap gap-1">${badges(p)}</div>
              <div class="mt-2 flex items-center gap-2">
                <div class="h-1 flex-1 overflow-hidden rounded-full bg-stone-100 dark:bg-stone-800">
                  <div class="h-full rounded-full ${barColor}" style="width:${pct}%"></div>
                </div>
                <span class="text-[10px] tabular-nums text-stone-400 dark:text-stone-500">${pct}%</span>
                ${printHtml}
                ${srcHtml ? `<span class="flex gap-1">${srcHtml}</span>` : ''}
              </div>
            </div>
          </div>`).join('')}
        </div>

        <!-- Desktop table (≥ sm). max-h + overflow-y-auto is deliberate, not
             just for the vertical scrollbar: overflow-x-auto alone makes the
             browser compute overflow-y as auto too (a standard CSS quirk —
             "if one axis is scrollable and the other is visible, the other
             becomes auto"), which silently breaks position:sticky on the
             thead below (verified with Playwright: the header tracked the
             page scroll 1:1, never stuck, because this div had quietly
             become its own zero-height-overflow scroll container). Giving
             it an explicit bounded height embraces that instead of fighting
             it, so the sticky thead has a real, working scrollport. -->
        <div class="hidden sm:block max-h-[75vh] overflow-y-auto overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="sticky top-0 z-10 bg-white dark:bg-stone-900">
              <tr class="border-b border-stone-200 dark:border-stone-700 text-left text-xs font-medium text-stone-500 dark:text-stone-400">
                <th class="w-8 px-3 py-2.5"><input type="checkbox" id="select-all-check" class="accent-green-600" ${allSelected ? 'checked' : ''} /></th>
                ${thSort('commonName', t('thName'))}
                ${thSort('latinName', t('thLatin'))}
                ${thSort('heightM', t('thHeightShort'))}
                ${thSort('widthM', t('thWidthShort'))}
                <th class="px-3 py-2.5">${escapeHtml(t('thUsage'))}</th>
                <th class="px-3 py-2.5">${escapeHtml(t('thFunctions'))}</th>
                <th class="px-3 py-2.5">${escapeHtml(t('thSun'))}</th>
                <th class="px-3 py-2.5">${escapeHtml(t('thWater'))}</th>
                ${thSort('growSpeed', t('thGrowthSpeed'))}
                ${thSort('layer', t('thLayer'))}
                <th class="px-3 py-2.5">${escapeHtml(t('thPhenology'))}</th>
                ${thSort('completeness', t('thCompleteness'))}
                ${thSort('groups', t('thGroups'))}
                <th class="px-3 py-2.5">${escapeHtml(t('thCount'))}</th>
                <th class="px-3 py-2.5">${escapeHtml(t('thSources'))}</th>
                <th class="px-3 py-2.5">${escapeHtml(t('thActions'))}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
              ${rowData.map(({ p, srcHtml, sel, pct, barColor, usageDots, functionDots, sunDots, waterDots, growthDots, layerDotHtml, phenologyHtml, printHtml, off }) => `
              <tr data-id="${p.id}" class="hover:bg-stone-50 dark:hover:bg-stone-800 ${sel ? 'bg-green-50 dark:bg-green-900/30' : ''}${off ? ' opacity-60' : ''}">
                <td class="px-3 py-2"><input type="checkbox" class="row-check accent-green-600" ${sel ? 'checked' : ''} /></td>
                <td class="px-3 py-2">
                  <div class="flex items-center gap-1.5">
                    <div class="h-5 w-0.5 rounded-full ${accentColor(p)} shrink-0"></div>
                    <span class="font-medium text-stone-800 dark:text-stone-100">${escapeHtml(displayName(p))}</span>
                  </div>
                </td>
                <td class="px-3 py-2 italic text-stone-500 dark:text-stone-400">${escapeHtml(p.latinName)}</td>
                <td class="px-3 py-2 text-stone-400 dark:text-stone-500">${p.heightM != null ? p.heightM + 'm' : '—'}</td>
                <td class="px-3 py-2 text-stone-400 dark:text-stone-500">${p.widthM != null ? p.widthM + 'm' : '—'}</td>
                <td class="px-3 py-2"><div class="flex gap-0.5">${usageDots}</div></td>
                <td class="px-3 py-2"><div class="flex gap-0.5">${functionDots}</div></td>
                <td class="px-3 py-2"><div class="flex gap-0.5">${sunDots}</div></td>
                <td class="px-3 py-2"><div class="flex gap-0.5">${waterDots}</div></td>
                <td class="px-3 py-2"><div class="flex gap-0.5">${growthDots}</div></td>
                <td class="px-3 py-2"><div class="flex gap-0.5">${layerDotHtml}</div></td>
                <td class="px-3 py-2">${phenologyHtml}</td>
                <td class="px-3 py-2">
                  <div class="flex items-center gap-1.5">
                    <div class="h-1.5 w-16 overflow-hidden rounded-full bg-stone-100 dark:bg-stone-800">
                      <div class="h-full rounded-full ${barColor}" style="width:${pct}%"></div>
                    </div>
                    <span class="text-[10px] tabular-nums text-stone-400 dark:text-stone-500">${pct}%</span>
                  </div>
                </td>
                <td class="px-3 py-2">${groupPillsHtml(p) || '<span class="text-stone-300 dark:text-stone-600">—</span>'}</td>
                <td class="px-3 py-2">${printHtml}</td>
                <td class="px-3 py-2">${srcHtml}</td>
                <td class="px-3 py-2"><div class="flex gap-1">${actionBtns}</div></td>
              </tr>`).join('')}
            </tbody>
          </table>
        </div>`;

      // Sort column headers (desktop table only)
      listEl.querySelectorAll<HTMLElement>('[data-sort]').forEach(th => {
        th.addEventListener('click', () => {
          const f = th.dataset.sort as typeof sortField;
          if (sortField === f) sortDir = sortDir === 'asc' ? 'desc' : 'asc';
          else { sortField = f; sortDir = 'asc'; }
          renderList();
        });
      });

      document.getElementById('select-all-check')?.addEventListener('change', (e) => {
        if ((e.target as HTMLInputElement).checked) {
          cachedPlants.forEach(p => selectedIds.add(p.id));
        } else {
          selectedIds.clear();
        }
        updateBulkBar();
        renderList();
      });

      // row-check: use data-id from closest ancestor instead of array index
      // (needed because mobile + desktop both render checkboxes)
      // Shift-click on a row checkbox selects every row between the previous
      // click and the current one — standard list-selection ergonomics.
      const rowChecks = Array.from(listEl.querySelectorAll<HTMLInputElement>('.row-check'));
      rowChecks.forEach(cb => {
        cb.addEventListener('click', (e) => {
          const ev = e as MouseEvent;
          const row = cb.closest('[data-id]') as HTMLElement | null;
          if (!row) return;
          const id = row.dataset.id!;
          const willCheck = cb.checked; // post-click state

          if (ev.shiftKey && lastCheckedId && lastCheckedId !== id) {
            const ids = rowChecks
              .map(c => (c.closest('[data-id]') as HTMLElement | null)?.dataset.id)
              .filter((v): v is string => !!v);
            const a = ids.indexOf(lastCheckedId);
            const b = ids.indexOf(id);
            if (a !== -1 && b !== -1) {
              const [from, to] = a < b ? [a, b] : [b, a];
              for (let i = from; i <= to; i++) {
                if (willCheck) selectedIds.add(ids[i]); else selectedIds.delete(ids[i]);
              }
            }
          } else {
            if (willCheck) selectedIds.add(id); else selectedIds.delete(id);
          }
          lastCheckedId = id;
          updateBulkBar();
          // Sync all rows + sibling checkboxes
          listEl.querySelectorAll<HTMLElement>('[data-id]').forEach(el => {
            const rid = el.dataset.id!;
            const sel = selectedIds.has(rid);
            el.classList.toggle('bg-green-50', sel);
            el.classList.toggle('dark:bg-green-900/30', sel);
            const checkbox = el.querySelector<HTMLInputElement>('.row-check');
            if (checkbox) checkbox.checked = sel;
          });
        });
      });
    }

    // Enrich button handler (shared for grid + list)
    listEl.querySelectorAll('.btn-enrich').forEach(btn => {
      btn.addEventListener('click', async () => {
        const card = btn.closest('[data-id]') as HTMLElement;
        const id = card.dataset.id!;
        const plant = cachedPlants.find(p => p.id === id);
        if (!plant || !plant.latinName) { alert(t('alertMissingLatinName')); return; }
        const b = btn as HTMLButtonElement;
        const origText = b.textContent;
        b.disabled = true; b.textContent = '…';
        try {
          const enriched = await enrichPlant(plant);
          await savePlant(plant);
          b.textContent = enriched > 0 ? `+${enriched}` : origText;
          setTimeout(() => renderList(), 1200);
        } catch { b.textContent = '!'; b.disabled = false; }
      });
    });

    listEl.querySelectorAll('.btn-edit').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn.closest('[data-id]') as HTMLElement).dataset.id!;
        const plant = cachedPlants.find(p => p.id === id);
        if (plant) {
          editingPlant = plant;
          (document.getElementById('dialog-title') as HTMLElement).textContent = t('dialogTitleEdit');
          fillForm(plant);
          dialog.showModal();
        }
      });
    });

    listEl.querySelectorAll('.btn-del').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn.closest('[data-id]') as HTMLElement).dataset.id!;
        if (confirm(t('confirmDeletePlant'))) {
          selectedIds.delete(id);
          await deletePlant(id);
          updateBulkBar();
          renderList();
        }
      });
    });

    // Print-count stepper (grid + list): 0 = deaktiviert (von Exporten ausgeschlossen)
    listEl.querySelectorAll('.btn-print-inc').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn.closest('[data-id]') as HTMLElement).dataset.id!;
        const plant = cachedPlants.find(p => p.id === id);
        if (!plant) return;
        plant.printCount = (plant.printCount ?? 1) + 1;
        await savePlant(plant);
        renderList();
      });
    });
    listEl.querySelectorAll('.btn-print-dec').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn.closest('[data-id]') as HTMLElement).dataset.id!;
        const plant = cachedPlants.find(p => p.id === id);
        if (!plant) return;
        plant.printCount = Math.max(0, (plant.printCount ?? 1) - 1);
        await savePlant(plant);
        renderList();
      });
    });
    listEl.querySelectorAll('.print-count-toggle').forEach(el => {
      el.addEventListener('click', async () => {
        const id = (el.closest('[data-id]') as HTMLElement).dataset.id!;
        const plant = cachedPlants.find(p => p.id === id);
        if (!plant) return;
        plant.printCount = (plant.printCount ?? 1) === 0 ? 1 : 0;
        await savePlant(plant);
        renderList();
      });
    });
  }

  // ── Dialog ────────────────────────────────────────────────────────────────────

  document.getElementById('btn-add')!.addEventListener('click', () => {
    editingPlant = null;
    (document.getElementById('dialog-title') as HTMLElement).textContent = t('dialogTitleNew');
    fillForm(createEmptyPlant());
    dialog.showModal();
  });
  document.getElementById('btn-cancel')!.addEventListener('click', () => dialog.close());
  form.addEventListener('submit', async (e) => { e.preventDefault(); await savePlant(readForm()); dialog.close(); renderList(); });

  // ── View toggle + Bulk actions ────────────────────────────────────────────────

  document.getElementById('btn-view-grid')!.addEventListener('click', () => {
    viewMode = 'grid'; selectedIds.clear(); updateBulkBar(); updateViewButtons(); renderList();
  });
  document.getElementById('btn-view-list')!.addEventListener('click', () => {
    viewMode = 'list'; updateViewButtons(); renderList();
  });
  document.getElementById('btn-view-cards')!.addEventListener('click', () => {
    viewMode = 'cards'; selectedIds.clear(); updateBulkBar(); updateViewButtons(); renderList();
  });
  document.getElementById('card-type-select')!.addEventListener('change', (e) => {
    cardViewMode = (e.target as HTMLSelectElement).value as 'poly' | 'stripe' | 'baumscheibe';
    renderList();
  });
  document.getElementById('sort-field-select')!.addEventListener('change', (e) => {
    sortField = (e.target as HTMLSelectElement).value as typeof sortField;
    renderList();
  });
  document.getElementById('btn-sort-dir')!.addEventListener('click', () => {
    sortDir = sortDir === 'asc' ? 'desc' : 'asc';
    document.getElementById('btn-sort-dir')!.textContent = sortDir === 'asc' ? '↑' : '↓';
    renderList();
  });
  document.getElementById('btn-pdf-all')!.addEventListener('click', async () => {
    if (cachedPlants.length === 0) return;
    const btn = document.getElementById('btn-pdf-all') as HTMLButtonElement;
    await withButtonSpinner(btn, async () => {
      if (cardViewMode === 'baumscheibe') await exportBaumscheibesPDF(cachedPlants);
      else if (cardViewMode === 'stripe') await exportStripeCardsPDF(cachedPlants);
      else await exportPolyCardsPDF(cachedPlants);
    });
  });
  // Table as PDF — exports what the table currently shows (filters + sort).
  // Labels come from the shared buildTablePdfLabels() (also used by
  // kalender.astro's own table-PDF buttons) rather than this page's own
  // dict, since they belong to the PDF layout, not either page's UI text.
  for (const [id, gray] of [['btn-table-pdf', false], ['btn-table-pdf-gray', true]] as const) {
    document.getElementById(id)!.addEventListener('click', async () => {
      const { exportPlantTablePDF } = await import('../lib/table-pdf');
      const { buildTablePdfLabels } = await import('../lib/table-pdf-labels');
      const rows = sortPlants(applyFilters(cachedPlants, filters), sortField, sortDir);
      if (rows.length === 0) return;
      await withButtonSpinner(document.getElementById(id) as HTMLButtonElement,
        () => exportPlantTablePDF(rows, gray, buildTablePdfLabels(getLang())));
    });
  }

  document.getElementById('btn-pdf-scaled')!.addEventListener('click', async () => {
    const scale = parseFloat((document.getElementById('scaled-denominator') as HTMLInputElement).value);
    const paper = (document.getElementById('scaled-paper') as HTMLSelectElement).value as ScaledPaper;
    const minSizeCm = parseFloat((document.getElementById('scaled-min-size') as HTMLInputElement).value) || 0;
    if (!(scale > 0)) return;
    const btn = document.getElementById('btn-pdf-scaled') as HTMLButtonElement;
    const res = await withButtonSpinner(btn, () => exportBaumscheibeScaledPDF(cachedPlants, scale, paper, minSizeCm * 10));
    if (res && res.shrunk > 0) alert(t('pdfScaledShrunk', { n: res.shrunk }));
    if (res && res.discarded.length > 0) {
      const names = res.discarded.map(p => displayName(p)).join(', ');
      alert(t('pdfScaledDiscarded', { n: res.discarded.length, names }));
    }
  });

  document.getElementById('btn-pdf-sheet')!.addEventListener('click', async () => {
    if (cachedPlants.length === 0) return;
    const btn = document.getElementById('btn-pdf-sheet') as HTMLButtonElement;
    await withButtonSpinner(btn, () => exportBaumscheibeSheetPDF(cachedPlants));
  });

  document.getElementById('btn-select-all')!.addEventListener('click', () => {
    cachedPlants.forEach(p => selectedIds.add(p.id));
    updateBulkBar(); renderList();
  });
  document.getElementById('btn-deselect')!.addEventListener('click', () => {
    selectedIds.clear(); updateBulkBar(); renderList();
  });
  document.getElementById('btn-bulk-delete')!.addEventListener('click', async () => {
    if (!selectedIds.size) return;
    if (!confirm(t('confirmBulkDelete', { n: selectedIds.size }))) return;
    for (const id of selectedIds) await deletePlant(id);
    selectedIds.clear(); updateBulkBar(); renderList();
  });
  document.getElementById('btn-bulk-json')!.addEventListener('click', () => {
    const plants = cachedPlants.filter(p => selectedIds.has(p.id));
    triggerDownload(JSON.stringify(plants, null, 2), 'plants-export.json', 'application/json');
  });
  document.getElementById('btn-bulk-csv')!.addEventListener('click', () => {
    const plants = cachedPlants.filter(p => selectedIds.has(p.id));
    triggerDownload(buildCSV(plants), 'plants-export.csv', 'text/csv;charset=utf-8;');
  });
  document.getElementById('btn-bulk-enrich')!.addEventListener('click', async () => {
    const plants = cachedPlants.filter(p => selectedIds.has(p.id));
    if (plants.length === 0) return;
    const btn = document.getElementById('btn-bulk-enrich') as HTMLButtonElement;
    btn.disabled = true;
    let done = 0;
    for (const plant of plants) {
      btn.textContent = t('bulkEnrichProgress', { done: done + 1, total: plants.length });
      await enrichPlant(plant);
      await savePlant(plant);
      done++;
    }
    btn.textContent = t('bulkEnrichDone', { done });
    btn.disabled = false;
    setTimeout(() => renderList(), 800);
  });
  document.getElementById('btn-bulk-pdf')!.addEventListener('click', async () => {
    const plants = cachedPlants.filter(p => selectedIds.has(p.id));
    if (plants.length === 0) return;
    const btn = document.getElementById('btn-bulk-pdf') as HTMLButtonElement;
    await withButtonSpinner(btn, async () => {
      if (cardViewMode === 'baumscheibe') await exportBaumscheibesPDF(plants);
      else if (cardViewMode === 'stripe') await exportStripeCardsPDF(plants);
      else await exportPolyCardsPDF(plants);
    });
  });

  // ── Standard actions ──────────────────────────────────────────────────────────

  document.getElementById('btn-load-samples')!.addEventListener('click', async () => {
    try {
      await importPlants(samplePlants);
      // Filter könnten alle Samples ausblenden — Hinweis im Status, falls so.
      const before = anyFilterActive();
      clearAllFilters();
      await renderList();
      alert(t('alertSamplesImported', { n: samplePlants.length, reset: before ? t('alertFiltersReset') : '' }));
    } catch (err) {
      alert(t('alertSampleImportFailed', { error: err instanceof Error ? err.message : String(err) }));
      console.error(err);
    }
  });
  document.getElementById('btn-load-samples-crawford')!.addEventListener('click', async () => {
    try {
      await importPlants(crawfordPlants);
      const before = anyFilterActive();
      clearAllFilters();
      await renderList();
      alert(t('alertCrawfordImported', { n: crawfordPlants.length, reset: before ? t('alertFiltersReset') : '' }));
    } catch (err) {
      alert(t('alertSampleImportFailed', { error: err instanceof Error ? err.message : String(err) }));
      console.error(err);
    }
  });
  document.getElementById('btn-enrich-all')!.addEventListener('click', async () => {
    const b = document.getElementById('btn-enrich-all') as HTMLButtonElement;
    const origText = b.textContent;
    const allPlants = (await getAllPlants()).filter(p => p.latinName);
    if (allPlants.length === 0) { alert(t('alertNoLatinNamePlants')); return; }
    // Only plants with unfilled fields need a PFAF/Wikidata round trip — a
    // 100%-complete plant would make the exact same requests for no possible
    // change (enrichPlant only ever fills currently-empty fields), needlessly
    // hammering both services. Same 10-field heuristic as the "Vollst." column.
    const plants = allPlants.filter(p => completenessPercent(p) < 100 || needsImageCredit(p) || (getLang() === 'en' && !p.commonNameEn));
    const skipped = allPlants.length - plants.length;
    if (plants.length === 0) { alert(t('alertEnrichAllNoneNeeded', { skipped })); return; }
    b.disabled = true;
    let plantsUpdated = 0, fieldsFilled = 0, failed = 0;
    for (let i = 0; i < plants.length; i++) {
      b.textContent = `${i + 1}/${plants.length}…`;
      try {
        const enriched = await enrichPlant(plants[i]);
        if (enriched > 0) {
          await savePlant(plants[i]);
          plantsUpdated++;
          fieldsFilled += enriched;
        }
      } catch (err) {
        failed++;
        console.error(`Anreicherung fehlgeschlagen für ${plants[i].latinName}:`, err);
      }
    }
    b.disabled = false;
    b.textContent = origText;
    await renderList();
    alert(
      t('alertEnrichAllSummary', { updated: plantsUpdated, total: plants.length, fields: fieldsFilled }) +
      (skipped > 0 ? t('alertEnrichAllSkipped', { skipped }) : '') +
      (failed > 0 ? t('alertEnrichAllFailed', { failed }) : '')
    );
  });
  document.getElementById('btn-csv-template')!.addEventListener('click', () => {
    triggerDownload(buildCSVTemplate(), 'pflanzen-vorlage.csv', 'text/csv;charset=utf-8;');
  });
  document.getElementById('btn-export')!.addEventListener('click', () => {
    triggerDownload(JSON.stringify(cachedPlants, null, 2), 'plants.json', 'application/json');
  });
  document.getElementById('btn-import')!.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', async () => {
    const f = fileInput.files?.[0]; if (!f) return;
    try {
      const { plants } = parseBackup(await f.text());
      if (plants.length === 0) { alert(t('alertNoJsonPlants')); return; }
      await importPlants(plants); renderList();
    } catch (err) {
      alert(t('alertJsonImportFailed', { msg: err instanceof Error ? err.message : String(err) }));
    } finally {
      fileInput.value = '';
    }
  });
  document.getElementById('btn-import-csv')!.addEventListener('click', () => csvInput.click());
  csvInput.addEventListener('change', async () => {
    const f = csvInput.files?.[0]; if (!f) return;
    const plants = importFromCSV(await f.text());
    if (plants.length === 0) { alert(t('alertNoCsvPlants')); return; }
    for (const plant of plants) trackSources(plant, plant as Partial<PlantData>, 'csv');
    await importPlants(plants); renderList(); csvInput.value = '';
  });

  // ── Live search ───────────────────────────────────────────────────────────────

  const searchInput = document.getElementById('plant-search') as HTMLInputElement;
  const searchResults = document.getElementById('search-results')!;
  let searchTimeout: ReturnType<typeof setTimeout>;

  async function doSearch() {
    const q = searchInput.value.trim();
    if (q.length < 2) { searchResults.innerHTML = ''; searchResults.classList.add('hidden'); return; }
    searchResults.classList.remove('hidden');
    searchResults.innerHTML = `<p class="px-4 py-3 text-sm text-stone-400 dark:text-stone-500 animate-pulse">${escapeHtml(t('searchLoading'))}</p>`;
    try {
      const results = await searchPlants(q);
      if (results.length === 0) { searchResults.innerHTML = `<p class="px-4 py-3 text-sm text-stone-400 dark:text-stone-500">${escapeHtml(t('searchNoResults'))}</p>`; return; }
      // Same Latin name already in the collection (case-insensitive) — shown
      // as a hint, not a hard block, since a second entry can be legitimate
      // (e.g. a different cultivar tracked separately via varietyName).
      const existingLatin = new Set(cachedPlants.map(p => p.latinName.trim().toLowerCase()));
      searchResults.innerHTML = results.map((r, i) => {
        const dupe = !!r.latinName && existingLatin.has(r.latinName.trim().toLowerCase());
        return `
        <div class="flex items-center justify-between gap-2 px-4 py-2.5 hover:bg-stone-50 dark:hover:bg-stone-800 transition" data-idx="${i}">
          <div class="min-w-0">
            <p class="truncate text-sm font-medium text-stone-800 dark:text-stone-100">${escapeHtml(r.commonName || r.latinName)}</p>
            ${r.latinName ? `<p class="truncate text-xs italic text-stone-500 dark:text-stone-400">${escapeHtml(r.latinName)}</p>` : ''}
            ${r.description ? `<p class="truncate text-xs text-stone-400 dark:text-stone-500">${escapeHtml(r.description)}</p>` : ''}
            ${dupe ? `<p class="text-xs font-medium text-amber-600 dark:text-amber-400">${escapeHtml(t('searchAlreadyAdded'))}</p>` : ''}
            <p class="import-status text-xs text-green-600"></p>
          </div>
          <button data-dupe="${dupe ? '1' : ''}" class="btn-add-result shrink-0 rounded-lg px-3 py-1.5 text-xs font-medium shadow transition active:scale-95 ${dupe ? 'bg-stone-100 dark:bg-stone-700 text-stone-600 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-600' : 'bg-green-700 text-white hover:bg-green-800'}">${escapeHtml(dupe ? t('searchAddAnyway') : t('searchAddResult'))}</button>
        </div>
      `;
      }).join('');

      searchResults.querySelectorAll('.btn-add-result').forEach((btn, idx) => {
        btn.addEventListener('click', async () => {
          const b = btn as HTMLButtonElement;
          const statusEl = b.closest('[data-idx]')?.querySelector('.import-status') as HTMLElement | null;
          if (b.dataset.dupe && !confirm(t('searchAddAnywayConfirm', { name: results[idx].commonName || results[idx].latinName }))) return;
          b.disabled = true;
          const sourceLabels: string[] = [];
          try {
            const r = results[idx];
            const plant = createEmptyPlant();
            plant._sources = {};
            plant.latinName = r.latinName;
            plant.commonName = r.commonName;
            if (plant.latinName) plant._sources['latinName'] = 'manual';
            if (plant.commonName) plant._sources['commonName'] = 'manual';

            if (isSourceEnabled('wikidata')) {
              b.textContent = t('enrichWikidataStatus');
              let wdId = r.wikidataId;
              if (!wdId && plant.latinName) {
                const searchUrl = new URL('https://www.wikidata.org/w/api.php');
                searchUrl.searchParams.set('action', 'wbsearchentities');
                searchUrl.searchParams.set('search', plant.latinName);
                searchUrl.searchParams.set('language', 'en');
                searchUrl.searchParams.set('type', 'item');
                searchUrl.searchParams.set('limit', '1');
                searchUrl.searchParams.set('format', 'json');
                searchUrl.searchParams.set('origin', '*');
                const sr = await fetch(searchUrl.toString());
                if (sr.ok) { const sd = await sr.json(); wdId = sd.search?.[0]?.id; }
              }
              if (wdId) {
                const details = await fetchPlantDetails(wdId);
                if (Object.keys(details).length > 0) {
                  const filled: Partial<PlantData> = {};
                  for (const [key, value] of Object.entries(details)) {
                    const cur = (plant as any)[key];
                    const empty = cur === null || cur === undefined || cur === '' || cur === false;
                    if (empty && value) { (plant as any)[key] = value; (filled as any)[key] = value; }
                  }
                  if (Object.keys(filled).length > 0) { trackSources(plant, filled, 'wikidata'); sourceLabels.push('Wikidata'); }
                }
              }
            }

            if (plant.latinName && (isSourceEnabled('pfaf') || isSourceEnabled('naturadb'))) {
              b.textContent = t('enrichPfafStatus');
              const proxyData = await fetchProxyData(plant.latinName);
              const filled: Partial<PlantData> = {};
              for (const [key, value] of Object.entries(proxyData)) {
                const cur = (plant as any)[key];
                // See the SCORE_FIELDS comment on isFillable() in lib/enrich.ts — same
                // 0-vs-"empty" gap applies to this search-add's own merge.
                const empty = cur === null || cur === undefined || cur === '' || cur === false ||
                  (SCORE_FIELDS.has(key) && cur === 0) ||
                  (Array.isArray(cur) && cur.every((v: boolean) => !v));
                if (empty && value !== null && value !== undefined && value !== '' && value !== false) {
                  (plant as any)[key] = value; (filled as any)[key] = value;
                }
              }
              if (Object.keys(filled).length > 0) {
                const src: DataSource = isSourceEnabled('pfaf') ? 'pfaf' : 'naturadb';
                trackSources(plant, filled, src);
                if (isSourceEnabled('pfaf')) sourceLabels.push('PFAF');
              }
            }

            plant.id = newId();
            await savePlant(plant);
            renderList();
            b.textContent = t('searchAdded');
            b.classList.replace('bg-green-700', 'bg-green-500');
            b.disabled = true;
            if (statusEl) statusEl.textContent = sourceLabels.length ? `${sourceLabels.join(' + ')}` : '';
          } catch {
            b.textContent = t('searchAddFailed');
            b.classList.replace('bg-green-700', 'bg-red-500');
          }
        });
      });
    } catch (err) { searchResults.innerHTML = `<p class="px-4 py-3 text-sm text-red-500">${escapeHtml(t('searchError', { error: String(err) }))}</p>`; }
  }

  document.getElementById('btn-search')!.addEventListener('click', doSearch);
  searchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doSearch(); } if (e.key === 'Escape') { searchResults.classList.add('hidden'); } });
  searchInput.addEventListener('input', () => { clearTimeout(searchTimeout); searchTimeout = setTimeout(doSearch, 300); });
  document.addEventListener('click', (e) => {
    if (!searchResults.contains(e.target as Node) && e.target !== searchInput) {
      searchResults.classList.add('hidden');
    }
  });

  // Reflect default card-variant choice in the dropdown.
  (document.getElementById('card-type-select') as HTMLSelectElement | null)
    ?.setAttribute('value', cardViewMode);
  const cardSelect = document.getElementById('card-type-select') as HTMLSelectElement | null;
  if (cardSelect) cardSelect.value = cardViewMode;

  // ── Filter chips ───────────────────────────────────────────────────────
  function anyFilterActive(): boolean {
    return (Object.keys(SET_FILTER_KEYS) as SetFacet[]).some(f => filters[f].size > 0)
      || filters.heightMin > 0 || filters.completenessMin > 0 || !!filters.text.trim();
  }
  /** Shared active/inactive styling + "(n)" count for a <details> dropdown's <summary>. */
  function syncDropdownSummary(id: string, count: number, label: string) {
    const el = document.getElementById(id);
    if (!el) return;
    const active = count > 0;
    el.classList.toggle('bg-green-700', active);
    el.classList.toggle('text-white', active);
    el.classList.toggle('bg-stone-100', !active);
    el.classList.toggle('dark:bg-stone-800', !active);
    el.classList.toggle('text-stone-600', !active);
    el.classList.toggle('dark:text-stone-300', !active);
    el.textContent = active ? `${label} (${count})` : label;
  }
  // Set the print count of every plant matching the current filters at once.
  document.getElementById('btn-bulk-print-count')!.addEventListener('click', async () => {
    const raw = parseInt((document.getElementById('bulk-print-count-value') as HTMLInputElement).value, 10);
    const n = Number.isFinite(raw) ? Math.max(0, Math.min(99, raw)) : 1;
    const targets = applyFilters(cachedPlants, filters);
    if (targets.length === 0) return;
    for (const p of targets) { p.printCount = n; await savePlant(p); }
    renderList();
  });

  // Checkbox-group dropdowns: [facet, checkbox selector, summary id, summary label key].
  const CHECKBOX_FACETS: [SetFacet, string, string, string][] = [
    ['usage', '.filter-usage-opt', 'filter-usage-summary', 'filterUsageLabel'],
    ['function', '.filter-function-opt', 'filter-function-summary', 'filterFunctionLabel'],
    ['sun', '.filter-sun-opt', 'filter-sun-summary', 'thSun'],
    ['water', '.filter-water-opt', 'filter-water-summary', 'thWater'],
    ['growSpeed', '.filter-growspeed-opt', 'filter-growspeed-summary', 'thGrowthSpeed'],
    ['layer', '.filter-layer-opt', 'filter-layer-summary', 'thLayer'],
    ['flowerMonths', '.filter-flowering-opt', 'filter-flowering-summary', 'legendFlowering'],
    ['fruitMonths', '.filter-fruiting-opt', 'filter-fruiting-summary', 'legendFruiting'],
    ['groups', '.filter-groups-opt', 'filter-groups-summary', 'filterGroupsLabel'],
  ];

  function syncFilterChips(shown: number, total: number) {
    for (const [facet, , summaryId, labelKey] of CHECKBOX_FACETS) syncDropdownSummary(summaryId, filters[facet].size, t(labelKey));
    const clearBtn = document.getElementById('btn-filter-clear')!;
    const countEl = document.getElementById('filter-count')!;
    if (anyFilterActive()) {
      clearBtn.classList.remove('hidden');
      countEl.classList.remove('hidden');
      countEl.textContent = t('filterCount', { shown, total });
    } else {
      clearBtn.classList.add('hidden');
      countEl.classList.add('hidden');
    }
  }

  // Delegated, so the group dropdown's options (rebuilt whenever the set of
  // group names changes) need no re-wiring.
  document.getElementById('filter-bar')!.addEventListener('change', (e) => {
    const cb = e.target as HTMLInputElement;
    const entry = CHECKBOX_FACETS.find(([, selector]) => cb.matches(selector));
    if (!entry) return;
    const facet = entry[0];
    if (cb.checked) filters[facet].add(cb.value); else filters[facet].delete(cb.value);
    persistFacet(facet);
    renderList();
  });
  function syncCheckboxStates() {
    for (const [facet, selector] of CHECKBOX_FACETS) {
      document.querySelectorAll<HTMLInputElement>(selector).forEach(cb => { cb.checked = filters[facet].has(cb.value); });
    }
  }

  /** Rebuilds the Gruppen dropdown from the group names currently in use
   *  (plus "ohne Gruppe"); hidden while no plant has a group. A selected group
   *  that no longer exists is dropped from the filter. */
  let renderedGroupOptions = '';
  function renderGroupFilterOptions() {
    const groups = allGroups(cachedPlants);
    const wrap = document.getElementById('filter-groups')!;
    wrap.classList.toggle('hidden', groups.length === 0);
    const valid = new Set(['', ...groups]);
    let pruned = false;
    for (const g of [...filters.groups]) if (!valid.has(g)) { filters.groups.delete(g); pruned = true; }
    if (pruned) persistFacet('groups');
    const key = JSON.stringify(groups);
    if (key === renderedGroupOptions) return;
    renderedGroupOptions = key;
    const opt = (value: string, label: string) =>
      `<label class="flex items-center gap-1.5"><input type="checkbox" class="filter-groups-opt accent-green-600" value="${escapeHtml(value)}" ${filters.groups.has(value) ? 'checked' : ''} /> <span class="truncate">${escapeHtml(label)}</span></label>`;
    document.getElementById('filter-groups-options')!.innerHTML =
      groups.map(g => opt(g, g)).join('') + opt('', t('filterGroupsNone'));
  }

  const filterHeightEl = document.getElementById('filter-height') as HTMLSelectElement;
  filterHeightEl.value = String(filters.heightMin);
  filterHeightEl.addEventListener('change', () => {
    filters.heightMin = Number(filterHeightEl.value);
    persistScalarFilters();
    renderList();
  });
  const filterCompletenessEl = document.getElementById('filter-completeness') as HTMLSelectElement;
  filterCompletenessEl.value = String(filters.completenessMin);
  filterCompletenessEl.addEventListener('change', () => {
    filters.completenessMin = Number(filterCompletenessEl.value);
    persistScalarFilters();
    renderList();
  });

  const filterTextEl = document.getElementById('filter-text') as HTMLInputElement;
  filterTextEl.value = filters.text;
  let filterTextDebounce: ReturnType<typeof setTimeout> | undefined;
  filterTextEl.addEventListener('input', () => {
    filters.text = filterTextEl.value;
    persistScalarFilters();
    clearTimeout(filterTextDebounce);
    filterTextDebounce = setTimeout(renderList, 150);
  });
  function clearAllFilters() {
    for (const facet of Object.keys(SET_FILTER_KEYS) as SetFacet[]) { filters[facet].clear(); persistFacet(facet); }
    filters.heightMin = 0;
    filters.completenessMin = 0;
    filters.text = '';
    persistScalarFilters();
    syncCheckboxStates();
    filterHeightEl.value = '0';
    filterCompletenessEl.value = '0';
    filterTextEl.value = '';
  }
  syncCheckboxStates();
  document.getElementById('btn-filter-clear')!.addEventListener('click', () => {
    clearAllFilters();
    renderList();
  });

  // ── Keyboard shortcuts ──────────────────────────────────────────────────
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement | null;
    const inField = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable);
    // Esc closes any open dialog regardless of focus location.
    if (e.key === 'Escape') {
      const open = document.querySelector('dialog[open]') as HTMLDialogElement | null;
      if (open) { open.close(); return; }
    }
    if (inField || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === '/') { e.preventDefault(); searchInput.focus(); searchInput.select(); return; }
    if (e.key === 'n') { e.preventDefault(); document.getElementById('btn-add')!.click(); return; }
    if (e.key === 'g') { e.preventDefault(); document.getElementById('btn-view-grid')!.click(); return; }
    if (e.key === 'l') { e.preventDefault(); document.getElementById('btn-view-list')!.click(); return; }
    if (e.key === 'c') { e.preventDefault(); document.getElementById('btn-view-cards')!.click(); return; }
  });

  // ── Daten-Overflow-Menü: schließt beim Item-Klick + Klick-außerhalb ─────
  // "Lade alle fehlenden Daten" läuft nach dem Klick weiter (Fortschritt
  // "1/N…" im Button-Text) — das Menü darf dafür nicht sofort zuklappen,
  // sonst ist der Fortschritt unsichtbar. Alle anderen Items schließen
  // weiterhin sofort, da sie synchron sind oder ihr eigenes Feedback
  // (Toast/Alert) außerhalb des Menüs zeigen.
  const dataMenu = document.getElementById('data-menu') as HTMLDetailsElement | null;
  dataMenu?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.tagName === 'BUTTON' && t.id !== 'data-menu' && t.id !== 'btn-enrich-all') dataMenu.open = false;
  });
  document.addEventListener('click', (e) => {
    if (dataMenu?.open && !dataMenu.contains(e.target as Node)) dataMenu.open = false;
  });

  updateViewButtons();
  renderList();
</script>
