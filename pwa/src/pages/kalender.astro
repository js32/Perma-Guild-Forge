---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Perma Design Kit — Kalender">
  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-stone-900 dark:text-stone-100" data-i18n="pageTitle">Ernte- &amp; Blütenkalender</h1>
      <p class="mt-1 text-sm text-stone-500 dark:text-stone-400" data-i18n="pageSubtitle">Wann blüht was, wann ist was erntereif — aus deinen Pflanzendaten.</p>
    </div>
    <div class="flex items-center gap-4 text-xs text-stone-600 dark:text-stone-300">
      <span class="flex items-center gap-1.5"><span class="inline-block h-3 w-5 rounded-sm bg-amber-400 dark:bg-amber-500"></span><span data-i18n="legendFlower">Blüte</span></span>
      <span class="flex items-center gap-1.5"><span class="inline-block h-3 w-5 rounded-sm bg-green-500 dark:bg-green-400"></span><span data-i18n="legendFruit">Ernte</span></span>
    </div>
  </div>

  <!-- Monatliche Übersicht -->
  <section class="mb-8">
    <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-stone-400 dark:text-stone-500" data-i18n="overviewHeading">Überblick</h2>
    <div id="overview" class="grid grid-cols-6 gap-2 sm:grid-cols-12"></div>
  </section>

  <!-- Filter -->
  <div class="mb-4 flex flex-wrap items-center gap-3">
    <input type="search" id="kalender-search" data-i18n-placeholder="searchPlaceholder" placeholder="Pflanze suchen…"
      class="rounded-lg border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-3 py-1.5 text-sm shadow-inner focus:border-green-500 focus:outline-none w-52" />
    <label class="inline-flex items-center gap-1.5 cursor-pointer text-sm">
      <input type="checkbox" id="filter-flower" checked class="accent-amber-500" />
      <span class="text-stone-700 dark:text-stone-300" data-i18n="filterFlower">Blüte</span>
    </label>
    <label class="inline-flex items-center gap-1.5 cursor-pointer text-sm">
      <input type="checkbox" id="filter-fruit" checked class="accent-green-600" />
      <span class="text-stone-700 dark:text-stone-300" data-i18n="filterFruit">Ernte</span>
    </label>
    <label class="inline-flex items-center gap-1.5 cursor-pointer text-sm">
      <input type="checkbox" id="filter-no-data" class="accent-stone-500" />
      <span class="text-stone-700 dark:text-stone-300" data-i18n="filterNoData">Pflanzen ohne Kalenderdaten anzeigen</span>
    </label>
    <span class="h-4 w-px bg-stone-300 dark:bg-stone-700"></span>
    <!-- Nutzung/Funktionen: same multi-select-dropdown pattern (OR within,
         AND across) as the plant-list page's filter row. -->
    <details class="filter-dropdown relative">
      <summary class="cursor-pointer select-none rounded-full bg-stone-100 dark:bg-stone-800 px-2.5 py-1 text-xs font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700"><span data-i18n="filterUsageLabel">Nutzung</span></summary>
      <div class="absolute z-10 mt-1 w-44 space-y-1 rounded-lg bg-white dark:bg-stone-800 p-2.5 text-xs shadow-lg ring-1 ring-stone-200 dark:ring-stone-700">
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="eatable" /> <span data-i18n="fld_eatable">Essbarkeit</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="culinaric" /> <span data-i18n="fld_culinaric">Küche</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="meds" /> <span data-i18n="fld_meds">Gesundheit</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="material" /> <span data-i18n="fld_material">Materialien</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="fodder" /> <span data-i18n="fld_fodder">Tierfutter</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="fuel" /> <span data-i18n="fld_fuel">Brennstoff</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="wood" /> <span data-i18n="fld_wood">Nutzholz</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="fiber" /> <span data-i18n="fld_fiber">Fasern</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="ornamental" /> <span data-i18n="fld_ornamental">Ästhetik</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-usage-opt accent-green-600" value="dyes" /> <span data-i18n="fld_dyes">Farbstoff</span></label>
      </div>
    </details>
    <details class="filter-dropdown relative">
      <summary class="cursor-pointer select-none rounded-full bg-stone-100 dark:bg-stone-800 px-2.5 py-1 text-xs font-medium text-stone-600 dark:text-stone-300 ring-1 ring-stone-200 dark:ring-stone-700"><span data-i18n="filterFunctionLabel">Funktionen</span></summary>
      <div class="absolute z-10 mt-1 w-44 space-y-1 rounded-lg bg-white dark:bg-stone-800 p-2.5 text-xs shadow-lg ring-1 ring-stone-200 dark:ring-stone-700">
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="nitrogenFix" /> <span data-i18n="fld_nitrogenFix">Stickstoff-Fixierer</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="mineralFix" /> <span data-i18n="fld_mineralFix">Mineraliensammler</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="groundCover" /> <span data-i18n="fld_groundCover">Bodendecker</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="insects" /> <span data-i18n="fld_insects">Insekten</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="pest" /> <span data-i18n="fld_pest">Schädlingsschutz</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="windBreaking" /> <span data-i18n="fld_windBreaking">Windschutz</span></label>
        <label class="flex items-center gap-1.5"><input type="checkbox" class="filter-function-opt accent-green-600" value="animalProtection" /> <span data-i18n="fld_animalProtection">Kleintiere</span></label>
      </div>
    </details>
    <span id="kalender-count" class="text-xs text-stone-400 dark:text-stone-500 ml-auto"></span>
  </div>

  <!-- Ausgabeformat: Tabelle als PDF — genauso wie auf der Pflanzenliste -->
  <div class="mb-4 flex items-center gap-2">
    <span class="text-xs font-medium text-stone-500 dark:text-stone-400" data-i18n="tableOutputFormatLabel">Ausgabeformat</span>
    <button id="btn-table-pdf" data-i18n="menuTablePdf" class="rounded-lg bg-stone-100 dark:bg-stone-800 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700 transition hover:bg-stone-200 dark:hover:bg-stone-700">Tabelle als PDF (Farbe)</button>
    <button id="btn-table-pdf-gray" data-i18n="menuTablePdfGray" class="rounded-lg bg-stone-100 dark:bg-stone-800 px-3 py-1.5 text-sm font-medium text-stone-700 dark:text-stone-200 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700 transition hover:bg-stone-200 dark:hover:bg-stone-700">Tabelle als PDF (Graustufen)</button>
  </div>

  <!-- Detailtabelle -->
  <div class="overflow-x-auto rounded-xl bg-white dark:bg-stone-800 shadow-sm ring-1 ring-stone-200 dark:ring-stone-700">
    <div id="calendar-table" class="min-w-[640px]"></div>
  </div>

  <!-- Empty states -->
  <div id="empty-no-data" hidden class="mt-16 text-center">
    <p class="text-stone-500 dark:text-stone-400" data-i18n="emptyNoData">Noch keine Pflanzen mit Blüte- oder Erntedaten.</p>
    <a href="/" data-i18n="emptyNoDataLink" class="mt-2 inline-block text-sm text-green-700 dark:text-green-400 hover:underline">Pflanzen anlegen oder importieren →</a>
  </div>
  <div id="empty-no-match" hidden class="mt-8 text-center text-sm text-stone-400 dark:text-stone-500" data-i18n="emptyNoMatch">
    Keine Pflanzen entsprechen dem Filter.
  </div>
</Layout>

<script>
  import { getAllPlants } from '../lib/db';
  import { displayName, displayCommonName } from '../lib/plant-name';
  import type { PlantData } from '../lib/types';
  import { escapeHtml } from '../lib/html';
  import { createT, applyStaticI18n, getLang } from '../lib/i18n/core';
  import { kalenderDict } from '../lib/i18n/dict-kalender';
  import { plantDetailDict } from '../lib/i18n/dict-plant-detail';
  import { withButtonSpinner } from '../lib/html';

  const t = createT(kalenderDict, plantDetailDict);
  applyStaticI18n(kalenderDict, plantDetailDict);

  const MONTHS = [
    t('monthJan'), t('monthFeb'), t('monthMar'), t('monthApr'), t('monthMay'), t('monthJun'),
    t('monthJul'), t('monthAug'), t('monthSep'), t('monthOct'), t('monthNov'), t('monthDec'),
  ];
  const NOW_MONTH = new Date().getMonth();

  const searchInput  = document.getElementById('kalender-search') as HTMLInputElement;
  const filterFlower = document.getElementById('filter-flower') as HTMLInputElement;
  const filterFruit  = document.getElementById('filter-fruit') as HTMLInputElement;
  const filterNoData = document.getElementById('filter-no-data') as HTMLInputElement;
  const overviewEl   = document.getElementById('overview')!;
  const tableEl      = document.getElementById('calendar-table')!;
  const countEl      = document.getElementById('kalender-count')!;
  const emptyNoData  = document.getElementById('empty-no-data')!;
  const emptyNoMatch = document.getElementById('empty-no-match')!;

  // Nutzung/Funktionen filters — same OR-within/AND-across-groups semantics
  // as the plant-list page, not persisted (this page's other filters
  // aren't either).
  const usageFilter = new Set<string>();
  const functionFilter = new Set<string>();
  document.querySelectorAll('.filter-usage-opt').forEach(el => {
    el.addEventListener('change', () => {
      const cb = el as HTMLInputElement;
      cb.checked ? usageFilter.add(cb.value) : usageFilter.delete(cb.value);
      render();
    });
  });
  document.querySelectorAll('.filter-function-opt').forEach(el => {
    el.addEventListener('change', () => {
      const cb = el as HTMLInputElement;
      cb.checked ? functionFilter.add(cb.value) : functionFilter.delete(cb.value);
      render();
    });
  });

  let allPlants: PlantData[] = [];

  function hasActivity(p: PlantData): boolean {
    return !!(p.flowerMonths?.some(Boolean) || p.fruitMonths?.some(Boolean));
  }

  function getFiltered(): PlantData[] {
    const q = searchInput.value.toLowerCase().trim();
    const showF = filterFlower.checked;
    const showR = filterFruit.checked;
    const showNoData = filterNoData.checked;
    return allPlants.filter(p => {
      if (q && !p.latinName.toLowerCase().includes(q) && ![p.commonName, p.commonNameEn].some(n => (n || '').toLowerCase().includes(q))) return false;
      if (usageFilter.size > 0 && ![...usageFilter].some(f => Boolean((p as any)[f]))) return false;
      if (functionFilter.size > 0 && ![...functionFilter].some(f => Boolean((p as any)[f]))) return false;
      if (!hasActivity(p)) return showNoData;
      if (!showF && !showR) return false;
      const hasFlower = showF && !!(p.flowerMonths?.some(Boolean));
      const hasFruit  = showR && !!(p.fruitMonths?.some(Boolean));
      return hasFlower || hasFruit;
    });
  }

  function renderOverview(plants: PlantData[]) {
    const flowerCounts = Array(12).fill(0);
    const fruitCounts  = Array(12).fill(0);
    plants.forEach(p => {
      p.flowerMonths?.forEach((v, i) => { if (v) flowerCounts[i]++; });
      p.fruitMonths?.forEach((v, i) => { if (v) fruitCounts[i]++; });
    });
    const maxCount = Math.max(...flowerCounts, ...fruitCounts, 1);

    overviewEl.innerHTML = MONTHS.map((m, i) => {
      const fc = flowerCounts[i];
      const rc = fruitCounts[i];
      const total = fc + rc;
      const isNow = i === NOW_MONTH;
      const fH = Math.max(fc > 0 ? 4 : 0, Math.round((fc / maxCount) * 44));
      const rH = Math.max(rc > 0 ? 4 : 0, Math.round((rc / maxCount) * 44));
      return `
        <div class="rounded-lg p-2 text-center ${isNow
          ? 'ring-2 ring-green-500 bg-green-50 dark:bg-green-900/20'
          : 'bg-stone-50 dark:bg-stone-900'}">
          <p class="text-xs font-semibold ${isNow ? 'text-green-700 dark:text-green-400' : 'text-stone-500 dark:text-stone-400'}">${m}</p>
          <div class="mt-1 flex items-end justify-center gap-0.5" style="height:50px">
            <div class="w-3.5 rounded-t bg-amber-400 dark:bg-amber-500 transition-all" style="height:${fH}px" title="${t('overviewFloweringTitle', { count: fc })}"></div>
            <div class="w-3.5 rounded-t bg-green-500 dark:bg-green-400 transition-all" style="height:${rH}px" title="${t('overviewRipeTitle', { count: rc })}"></div>
          </div>
          <p class="mt-0.5 text-[10px] ${total > 0 ? 'text-stone-400 dark:text-stone-500' : 'text-transparent'}">${total}</p>
        </div>
      `;
    }).join('');
  }

  function renderTable(plants: PlantData[]) {
    const showF = filterFlower.checked;
    const showR = filterFruit.checked;

    const headerCells = MONTHS.map((m, i) => {
      const isNow = i === NOW_MONTH;
      return `<div class="flex h-8 items-center justify-center text-xs font-medium ${isNow ? 'text-green-600 dark:text-green-400 font-bold' : 'text-stone-400 dark:text-stone-500'}">${m}</div>`;
    }).join('');

    // Blüte/Frucht each get their own sub-row per month (top/bottom) instead
    // of blending into one combined color — matches the table-PDF layout
    // ("Blüte: obere Reihe, Frucht: untere Reihe"), and avoids a third
    // "both" color that no longer has anywhere to go once split.
    const rows = plants.map(p => {
      const name = escapeHtml(displayName(p));
      const sub  = displayCommonName(p) ? `<span class="block text-[10px] italic text-stone-400 dark:text-stone-500 truncate">${escapeHtml(p.latinName)}</span>` : '';
      const cells = MONTHS.map((_, i) => {
        const flower = showF && !!(p.flowerMonths?.[i]);
        const fruit  = showR && !!(p.fruitMonths?.[i]);
        const isNow = i === NOW_MONTH;
        return `
          <div class="flex h-9 flex-col justify-center gap-px ${isNow ? 'ring-1 ring-inset ring-green-400/30' : ''}">
            <div class="h-4 rounded-t ${flower ? 'bg-amber-300 dark:bg-amber-500' : ''}"></div>
            <div class="h-4 rounded-b ${fruit ? 'bg-green-500 dark:bg-green-400' : ''}"></div>
          </div>
        `;
      }).join('');
      return `
        <div class="grid items-center border-b border-stone-100 dark:border-stone-700/50 last:border-0 hover:bg-stone-50 dark:hover:bg-stone-700/30 transition-colors" style="grid-template-columns:180px repeat(12,1fr)">
          <div class="border-r border-stone-200 dark:border-stone-700 px-3 py-1.5">
            <span class="block truncate text-sm font-medium text-stone-800 dark:text-stone-100">${name}</span>
            ${sub}
          </div>
          ${cells}
        </div>
      `;
    }).join('');

    tableEl.innerHTML = `
      <div class="grid border-b border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900/50" style="grid-template-columns:180px repeat(12,1fr)">
        <div class="border-r border-stone-200 dark:border-stone-700 px-3 py-2 text-xs font-medium text-stone-500 dark:text-stone-400">${t('tableHeaderPlant')}</div>
        ${headerCells}
      </div>
      <div>${rows}</div>
    `;
  }

  function render() {
    const showNoData = filterNoData.checked;
    const active = allPlants.filter(hasActivity);
    const eligible = showNoData ? allPlants : active;
    const filtered = getFiltered();

    // "No data at all" only when there's truly nothing to show even with
    // the no-data checkbox on — otherwise that checkbox would reveal a
    // populated (if blank-rowed) table right next to this message.
    emptyNoData.hidden  = active.length > 0 || (showNoData && allPlants.length > 0);
    emptyNoMatch.hidden = eligible.length === 0 || filtered.length > 0;
    tableEl.style.display = filtered.length === 0 ? 'none' : '';

    countEl.textContent = filtered.length === eligible.length
      ? t('countAll', { count: eligible.length })
      : t('countFiltered', { filtered: filtered.length, total: eligible.length });

    renderOverview(filtered);
    renderTable(filtered);
  }

  searchInput.addEventListener('input', render);
  filterFlower.addEventListener('change', render);
  filterFruit.addEventListener('change', render);
  filterNoData.addEventListener('change', render);

  // Table as PDF — same export as the plant-list table view, applied to
  // whatever this page's own filters (search + Blüte/Ernte) currently show.
  for (const [id, gray] of [['btn-table-pdf', false], ['btn-table-pdf-gray', true]] as const) {
    document.getElementById(id)!.addEventListener('click', async () => {
      const rows = getFiltered();
      if (rows.length === 0) return;
      const [{ exportPlantTablePDF }, { buildTablePdfLabels }] = await Promise.all([
        import('../lib/table-pdf'), import('../lib/table-pdf-labels'),
      ]);
      await withButtonSpinner(document.getElementById(id) as HTMLButtonElement,
        () => exportPlantTablePDF(rows, gray, buildTablePdfLabels(getLang())));
    });
  }

  getAllPlants().then(plants => {
    // No hasActivity() filter here anymore — kept in full so the
    // "Pflanzen ohne Kalenderdaten anzeigen" checkbox has something to
    // reveal; getFiltered()/render() apply hasActivity() as needed instead.
    allPlants = [...plants].sort((a, b) => displayName(a).localeCompare(displayName(b), getLang()));
    render();
  });
</script>
